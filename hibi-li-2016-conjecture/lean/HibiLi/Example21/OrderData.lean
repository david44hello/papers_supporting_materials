def CertificateValid (mask : Fin 256) : Prop :=
  match faceCert mask with
  | some cert => cert.1.Valid points (maskFinset mask) ∧ cert.2.Valid points (maskFinset mask)
  | none => mask.val = 0 ∨ (nonfaceCert mask).Valid points (maskFinset mask)
instance (mask : Fin 256) : Decidable (CertificateValid mask) := by
  unfold CertificateValid
  split <;> infer_instance
theorem certificates_valid : ∀ mask : Fin 256, CertificateValid mask := by
  decide +kernel
def countedMasks (dim : ℕ) : Finset (Fin 256) :=
  Finset.univ.filter fun mask => (faceCert mask).any (fun cert => cert.1.dim == dim)
