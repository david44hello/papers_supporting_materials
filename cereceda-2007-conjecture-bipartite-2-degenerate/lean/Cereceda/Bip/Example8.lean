/-! ### A search tree of natural numbers -/

/-- A binary search tree of natural numbers (the certificate's container). -/
inductive BT where
  | leaf : BT
  | node : BT → ℕ → BT → BT

/-- Search-tree membership. -/
def BT.mem : BT → ℕ → Bool
  | .leaf, _ => false
  | .node l k r, x => if x < k then l.mem x else if k < x then r.mem x else true

/-- `p` holds at every key. -/
def BT.all (p : ℕ → Bool) : BT → Bool
  | .leaf => true
  | .node l k r => p k && l.all p && r.all p

/-- Whatever `mem` finds is a key, so `all p` covers it. -/
theorem BT.mem_all {p : ℕ → Bool} : ∀ (t : BT) (x : ℕ), t.all p = true → t.mem x = true → p x = true
  | .leaf, _, _, hm => by simp [BT.mem] at hm
  | .node l k r, x, ha, hm => by
    simp only [BT.all, Bool.and_eq_true] at ha
    obtain ⟨⟨hk, hl⟩, hr⟩ := ha
    simp only [BT.mem] at hm
    split_ifs at hm with h1 h2
    · exact BT.mem_all l x hl hm
    · exact BT.mem_all r x hr hm
    · have : x = k := by omega
      rw [this]
      exact hk

/-! ### Codes of states -/

/-- The colour stored for vertex `v` in a code. -/
def colOf (code : ℕ) (v : Fin 8) : ℕ := code / 12 ^ (v : ℕ) % 12 % 4

/-- The move count stored for vertex `v` in a code. -/
def cntOf (code : ℕ) (v : Fin 8) : ℕ := code / 12 ^ (v : ℕ) % 12 / 4

/-- The code of the state (colouring `c`, move counts `k`): `∑ (c v + 4 k v) 12^v`. -/
def code (c : Fin 8 → Fin 4) (k : Fin 8 → ℕ) : ℕ :=
  ((c 0).val + 4 * k 0) + 12 * ((c 1).val + 4 * k 1) + 144 * ((c 2).val + 4 * k 2) +
    1728 * ((c 3).val + 4 * k 3) + 20736 * ((c 4).val + 4 * k 4) + 248832 * ((c 5).val + 4 * k 5) +
    2985984 * ((c 6).val + 4 * k 6) + 35831808 * ((c 7).val + 4 * k 7)

/-- The code after recolouring `v` with `y` (one more move of `v`). -/
def nextCode (code : ℕ) (v : Fin 8) (y : Fin 4) : ℕ :=
  code - (colOf code v + 4 * cntOf code v) * 12 ^ (v : ℕ) + (y.val + 4 * (cntOf code v + 1)) * 12 ^ (v : ℕ)

/-- Adjacency of the instance graph, as a Boolean. -/
def adjB (u v : Fin 8) : Bool := decide (u ≠ v ∧ (v ∈ ex8Out u ∨ u ∈ ex8Out v))

/-- The colouring α = (1,0,0,2,1,0,2,0) (the greedy `α` of `ex8`). -/
def alphaC : Fin 8 → Fin 4 := ![1, 0, 0, 2, 1, 0, 2, 0]

/-- The colouring β = (0,1,1,0,2,0,1,2) (the greedy `β` of `ex8`). -/
def betaC : Fin 8 → Fin 4 := ![0, 1, 1, 0, 2, 0, 1, 2]

/-- A legal move of `v` to `y` from the coded state, with fewer than two moves of `v` so far. -/
def legalB (code : ℕ) (v : Fin 8) (y : Fin 4) : Bool :=
  decide (cntOf code v < 2) && decide (y ∈ ex8L v) && decide (y.val ≠ colOf code v) &&
    (List.finRange 8).all (fun u => !adjB v u || decide (colOf code u ≠ y.val))

/-- Live: every vertex with two moves is on its β colour. -/
def liveB (code : ℕ) : Bool :=
  (List.finRange 8).all fun v => decide (cntOf code v ≠ 2) || decide (colOf code v = (betaC v).val)

/-- The coded colouring is β. -/
def isBetaB (code : ℕ) : Bool :=
  (List.finRange 8).all fun v => decide (colOf code v = (betaC v).val)

