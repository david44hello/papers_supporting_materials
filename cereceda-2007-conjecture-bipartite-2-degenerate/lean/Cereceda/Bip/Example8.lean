theorem cert_closed : certTree.all (fun x => (List.finRange 8).all fun v => (List.finRange 4).all fun y =>
    !(legalB x v y && liveB (nextCode x v y)) || certTree.mem (nextCode x v y)) = true := by
  decide +kernel

theorem cert_noBeta : certTree.all (fun x => !isBetaB x) = true := by decide +kernel

/-! ### Soundness: codes of real states -/

theorem digits (c : Fin 8 → Fin 4) (k : Fin 8 → ℕ) (hk : ∀ u, k u ≤ 2) (v : Fin 8) :
    colOf (code c k) v = (c v).val ∧ cntOf (code c k) v = k v := by
  have c0 := (c 0).isLt; have c1 := (c 1).isLt; have c2 := (c 2).isLt; have c3 := (c 3).isLt
  have c4 := (c 4).isLt; have c5 := (c 5).isLt; have c6 := (c 6).isLt; have c7 := (c 7).isLt
  have k0 := hk 0; have k1 := hk 1; have k2 := hk 2; have k3 := hk 3
  have k4 := hk 4; have k5 := hk 5; have k6 := hk 6; have k7 := hk 7
  fin_cases v <;> simp [colOf, cntOf, code] <;> omega

theorem nextCode_eq (c : Fin 8 → Fin 4) (k : Fin 8 → ℕ) (hk : ∀ u, k u ≤ 2) (v : Fin 8) (y : Fin 4) :
    nextCode (code c k) v y = code (Function.update c v y) (Function.update k v (k v + 1)) := by
  obtain ⟨hc, hk'⟩ := digits c k hk v
  rw [nextCode, hc, hk']
  have c0 := (c 0).isLt; have c1 := (c 1).isLt; have c2 := (c 2).isLt; have c3 := (c 3).isLt
  have c4 := (c 4).isLt; have c5 := (c 5).isLt; have c6 := (c 6).isLt; have c7 := (c 7).isLt
  have hy := y.isLt
  fin_cases v <;> simp [code] <;> omega

theorem adj_iff (u v : Fin 8) : ex8.graph.Adj u v ↔ adjB u v = true := by
  simp only [Skeleton.graph, SimpleGraph.fromRel_adj, adjB, decide_eq_true_eq]
  exact Iff.rfl

theorem legalB_of (c : Fin 8 → Fin 4) (k : Fin 8 → ℕ) (hk : ∀ u, k u ≤ 2) (v : Fin 8) (y : Fin 4)
    (hkv : k v < 2) (hm : LegalMove ex8.graph ex8.L c (v, y)) : legalB (code c k) v y = true := by
  obtain ⟨hne, hL, hnb⟩ := hm
  unfold legalB
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true]
  refine ⟨⟨⟨decide_eq_true ?_, decide_eq_true hL⟩, decide_eq_true ?_⟩, List.all_eq_true.mpr (fun u _ => ?_)⟩
  · rw [(digits c k hk v).2]
    exact hkv
  · rw [(digits c k hk v).1]
    exact fun e => hne (Fin.ext e)
  · rw [Bool.or_eq_true]
    by_cases hadj : adjB v u = true
    · right
      rw [(digits c k hk u).1]
      exact decide_eq_true fun e => hnb u ((adj_iff v u).mpr hadj) (Fin.ext e)
    · left
      simpa using hadj

theorem movesOf_cons (ms : List (Fin 8 × Fin 4)) (v u : Fin 8) (y : Fin 4) :
    movesOf ((v, y) :: ms) u = movesOf ms u + (if v = u then 1 else 0) := by
  simp [movesOf, List.countP_cons]

/-- A vertex that never moves keeps its colour. -/
theorem colour_const : ∀ (ms : List (Fin 8 × Fin 4)) (c c' : Fin 8 → Fin 4) (u : Fin 8),
    Cereceda.IsSeq ex8.graph ex8.L c ms c' → movesOf ms u = 0 → c' u = c u
  | [], c, c', u, hs, _ => by rw [show c' = c from hs]
  | (v, y) :: ms, c, c', u, hs, h0 => by
    rw [movesOf_cons] at h0
    have hvu : v ≠ u := by intro e; simp [e] at h0
    have h0' : movesOf ms u = 0 := by omega
    rw [colour_const ms _ c' u hs.2 h0', Function.update_of_ne (Ne.symm hvu)]

/-- No sequence from a listed state to β with at most two moves per vertex in total. -/
theorem no_seq : ∀ (ms : List (Fin 8 × Fin 4)) (c : Fin 8 → Fin 4) (k : Fin 8 → ℕ),
    certTree.mem (code c k) = true → (∀ u, k u + movesOf ms u ≤ 2) →
      ¬ Cereceda.IsSeq ex8.graph ex8.L c ms betaC
  | [], c, k, hmem, hb, hs => by
    have hk : ∀ u, k u ≤ 2 := fun u => by have := hb u; omega
    have hB := BT.mem_all certTree _ cert_noBeta hmem
    have hbeta : isBetaB (code c k) = true := by
      simp only [isBetaB, List.all_eq_true, List.mem_finRange, true_implies, decide_eq_true_eq]
      intro v
      rw [(digits c k hk v).1, show betaC = c from hs]
    simp [hbeta] at hB
  | (v, y) :: ms, c, k, hmem, hb, hs => by
    obtain ⟨hm, hs'⟩ := hs
    have hk : ∀ u, k u ≤ 2 := fun u => by have := hb u; omega
    have hkv : k v < 2 := by
      have := hb v
      simp [movesOf_cons] at this
      omega
    set k' := Function.update k v (k v + 1) with hk'def
    have hb' : ∀ u, k' u + movesOf ms u ≤ 2 := by
      intro u
      have := hb u
      by_cases hvu : v = u
      · subst hvu
        simp [hk'def, movesOf_cons] at this ⊢
        omega
      · simp [hk'def, movesOf_cons, Function.update_of_ne (Ne.symm hvu), hvu] at this ⊢
        omega
    have hk2 : ∀ u, k' u ≤ 2 := fun u => by have := hb' u; omega
    have hlive : liveB (code (Function.update c v y) k') = true := by
      simp only [liveB, List.all_eq_true, List.mem_finRange, true_implies, Bool.or_eq_true, decide_eq_true_eq]
      intro u
      rw [(digits _ _ hk2 u).1, (digits _ _ hk2 u).2]
      by_cases h2 : k' u = 2
      · right
        have h0 : movesOf ms u = 0 := by have := hb' u; omega
        rw [colour_const ms _ _ u hs' h0]
      · exact Or.inl h2
    have hlegal := legalB_of c k hk v y hkv hm
    have hclosed := BT.mem_all certTree _ cert_closed hmem
    simp only [List.all_eq_true, List.mem_finRange, true_implies] at hclosed
    have hvy := hclosed v y
    rw [nextCode_eq c k hk v y, ← hk'def] at hvy
    simp only [hlegal, hlive, Bool.and_self, Bool.not_true, Bool.false_or] at hvy
    exact no_seq ms _ k' hvy hb' hs'

/-! ### The finite facts -/

theorem noRoots : ex8.NoRoots := by
  unfold Skeleton.NoRoots Skeleton.IsRoot
  decide

theorem cliqueFree : ex8.graph.CliqueFree 3 := by
  intro t ht
  obtain ⟨a, b, c, hab, hac, hbc, rfl⟩ := Finset.card_eq_three.mp ht.card_eq
  have h1 := (adj_iff a b).mp (ht.isClique (by simp) (by simp) hab)
  have h2 := (adj_iff b c).mp (ht.isClique (by simp) (by simp) hbc)
  have h3 := (adj_iff a c).mp (ht.isClique (by simp) (by simp) hac)
  have key : ∀ a b c : Fin 8, adjB a b = true → adjB b c = true → adjB a c = true → False := by decide +kernel
  exact key a b c h1 h2 h3

theorem notBipartite : ¬ ex8.graph.IsBipartite := by
  rintro ⟨C⟩
  have e01 := C.valid ((adj_iff 0 1).mpr (by decide))
  have e13 := C.valid ((adj_iff 1 3).mpr (by decide))
  have e34 := C.valid ((adj_iff 3 4).mpr (by decide))
  have e42 := C.valid ((adj_iff 4 2).mpr (by decide))
  have e20 := C.valid ((adj_iff 2 0).mpr (by decide))
  have key : ∀ a b c d e : Fin 2, a ≠ b → b ≠ c → c ≠ d → d ≠ e → e ≠ a → False := by
    intro a b c d e h1 h2 h3 h4 h5
    fin_cases a <;> fin_cases b <;> fin_cases c <;> fin_cases d <;> fin_cases e <;> simp_all
  exact key _ _ _ _ _ e01 e13 e34 e42 e20

theorem alpha_greedy : ex8.IsGreedy ex8.x alphaC := by
  unfold Instance.IsGreedy IsLeastFree
  decide

theorem beta_greedy : ex8.IsGreedy ex8.g betaC := by
  unfold Instance.IsGreedy IsLeastFree
  decide

end Ex8Aux

open Ex8Aux

theorem open_1_two_moves_fail_proved :
    ex8.NoRoots ∧ ex8.g = 0 ∧ Fintype.card (Fin 8) = 8 ∧ ¬ ex8.graph.IsBipartite ∧
    ∀ α β : Fin 8 → Fin 4, ex8.IsGreedy ex8.x α → ex8.IsGreedy ex8.g β →
      ¬ ∃ ms, ex8.IsSeq α ms β ∧ ∀ v, movesOf ms v ≤ 2 := by
  refine ⟨noRoots, rfl, Fintype.card_fin 8, notBipartite, ?_⟩
  rintro α β hα hβ ⟨ms, hs, hmv⟩
  have hα' : α = alphaC := (def_2_2_greedy_proved ex8 ex8.x).unique hα alpha_greedy
  have hβ' : β = betaC := (def_2_2_greedy_proved ex8 ex8.g).unique hβ beta_greedy
  subst hα' hβ'
  exact no_seq ms alphaC (fun _ => 0) cert_start (fun u => by simpa using hmv u) hs

end Cereceda
