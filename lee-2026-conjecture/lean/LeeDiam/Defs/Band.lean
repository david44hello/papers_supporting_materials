TRUST SURFACE. Elements: `Fin k × Fin 3`; `(i, 0)`, `(i, 1)`, `(i, 2)` are the paper's `a_{i+1}`, `b_{i+1}`, `c_{i+1}` (column `i+1`).
The order is the reflexive and transitive closure of the generating relations of Definition 1.2,
  `a_i < b_i < c_i (1 ≤ i ≤ k)`,  `a_i < b_{i+1} < c_i (1 ≤ i ≤ k - 1)`,
exactly as the paper defines it ("the poset ... whose order is generated by the relations"); they are also exactly the
cover relations (Figure 1, claim `fig_1_hasse`). Antisymmetry is proved from the row index (`0, 1, 2` for `a, b, c`),
which every generating relation raises by one.
-/
import Mathlib

namespace LeeDiam

/-- The generating relations of the band `B_k` (Definition 1.2). -/
def bandRel (k : ℕ) (x y : Fin k × Fin 3) : Prop :=
  (x.1 = y.1 ∧ x.2 = 0 ∧ y.2 = 1) ∨          -- a_i < b_i
  (x.1 = y.1 ∧ x.2 = 1 ∧ y.2 = 2) ∨          -- b_i < c_i
  (y.1.val = x.1.val + 1 ∧ x.2 = 0 ∧ y.2 = 1) ∨  -- a_i < b_{i+1}
  (x.1.val = y.1.val + 1 ∧ x.2 = 1 ∧ y.2 = 2)    -- b_{i+1} < c_i

theorem bandRel_row {k : ℕ} {x y : Fin k × Fin 3} (h : bandRel k x y) : x.2.val + 1 = y.2.val := by
  rcases h with ⟨-, h1, h2⟩ | ⟨-, h1, h2⟩ | ⟨-, h1, h2⟩ | ⟨-, h1, h2⟩ <;> simp [h1, h2]

theorem bandRel_rtc_row {k : ℕ} {x y : Fin k × Fin 3} (h : Relation.ReflTransGen (bandRel k) x y) :
    x = y ∨ x.2.val < y.2.val := by
  induction h with
  | refl => exact Or.inl rfl
  | tail _ hyz ih =>
    have := bandRel_row hyz
    rcases ih with rfl | hlt
    · exact Or.inr (by omega)
    · exact Or.inr (by omega)

/-- The band `B_k` as a type. -/
def Band (k : ℕ) : Type := Fin k × Fin 3

instance (k : ℕ) : Fintype (Band k) := inferInstanceAs (Fintype (Fin k × Fin 3))
instance (k : ℕ) : DecidableEq (Band k) := inferInstanceAs (DecidableEq (Fin k × Fin 3))

/-- The order of `B_k`: generated by the cover relations of Definition 1.2. -/
instance (k : ℕ) : PartialOrder (Band k) where
  le := Relation.ReflTransGen (bandRel k)
  le_refl _ := Relation.ReflTransGen.refl
  le_trans _ _ _ := Relation.ReflTransGen.trans
  le_antisymm x y hxy hyx := by
    rcases bandRel_rtc_row hxy with h | h
    · exact h
    · rcases bandRel_rtc_row hyx with h' | h'
      · exact h'.symm
      · omega

namespace Band

variable {k : ℕ}

/-- `a_{i+1}`, `b_{i+1}`, `c_{i+1}` of the paper (0-based column index `i`). -/
def a (i : Fin k) : Band k := (i, 0)
def b (i : Fin k) : Band k := (i, 1)
def c (i : Fin k) : Band k := (i, 2)

/-- The column of an element (0-based: the paper's column `i + 1`). -/
def col (x : Band k) : Fin k := Prod.fst (α := Fin k) (β := Fin 3) x

end Band

end LeeDiam
