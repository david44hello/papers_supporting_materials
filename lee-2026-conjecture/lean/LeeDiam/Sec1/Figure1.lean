`covBy_iff_of_level` is generic: in a partial order generated by a relation `r` along which a level function rises by
exactly one, the cover pairs are exactly the pairs of `r`. Figure 2 (`Sec6/Figure2.lean`) uses it too.
-/
import LeeDiam.Defs.Band

namespace LeeDiam

/-- In a partial order generated by `r` (`x ≤ y ↔ ReflTransGen r x y`), if every `r`-step raises `lev` by exactly one,
then `x ⋖ y ↔ r x y`. -/
theorem covBy_iff_of_level {α : Type*} [PartialOrder α] (r : α → α → Prop) (lev : α → ℕ)
    (hle : ∀ x y : α, x ≤ y ↔ Relation.ReflTransGen r x y) (hlev : ∀ x y, r x y → lev y = lev x + 1)
    (x y : α) : x ⋖ y ↔ r x y := by
  have hmono : ∀ {u v : α}, Relation.ReflTransGen r u v → u = v ∨ lev u < lev v := by
    intro u v h
    induction h with
    | refl => exact Or.inl rfl
    | tail _ hbc ih =>
      have := hlev _ _ hbc
      rcases ih with rfl | h
      · exact Or.inr (by omega)
      · exact Or.inr (by omega)
  have hlt : ∀ {u v : α}, u < v → lev u < lev v := fun {u v} h =>
    (hmono ((hle u v).1 h.le)).resolve_left h.ne
  have hstep : ∀ {u v : α}, r u v → u < v := fun {u v} h =>
    lt_of_le_of_ne ((hle u v).2 (Relation.ReflTransGen.single h)) (by
      rintro rfl
      have := hlev _ _ h
      omega)
  constructor
  · intro hcov
    rcases Relation.ReflTransGen.cases_head ((hle x y).1 hcov.le) with h | ⟨c, hxc, hcy⟩
    · exact absurd h hcov.ne
    · by_cases hc : c = y
      · exact hc ▸ hxc
      · exact absurd (lt_of_le_of_ne ((hle c y).2 hcy) hc) (hcov.2 (hstep hxc))
  · intro hr
    refine ⟨hstep hr, fun c hxc hcy => ?_⟩
    have h1 := hlt hxc
    have h2 := hlt hcy
    have := hlev _ _ hr
    omega

/-- Figure 1: the cover pairs of `B_k` are exactly the generating relations of Definition 1.2 (the row index `0, 1, 2`
of `a, b, c` rises by one along each of them). -/
theorem fig_1_hasse_proved (k : ℕ) (x y : Band k) : x ⋖ y ↔ bandRel k x y :=
  covBy_iff_of_level (α := Band k) (bandRel k) (fun z => z.2.val) (fun _ _ => Iff.rfl)
    (fun _ _ h => (bandRel_row h).symm) x y

end LeeDiam
