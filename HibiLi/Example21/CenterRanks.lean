theorem ranks_valid : ∀ mask : Fin 256, 0 < mask.val → mask.val < 128 →
    (rankCert mask).Valid points (maskFinset mask) := by decide +kernel
def dimension (support : Finset (Fin 8)) : ℕ := (rankCert (maskCode support)).dim
theorem dimension_eq (support : Finset (Fin 8)) (positive : 0 < (maskCode support).val)
    (bounded : (maskCode support).val < 128) : adim (supportHull points support) = dimension support := by
  rw [supportHull, adim_convexHull]
  have cert := (rankCert (maskCode support)).adim_eq points _ (ranks_valid _ positive bounded)
  simpa only [maskFinset_maskCode, dimension] using cert
end HibiLi.Example21.CenterRegions
