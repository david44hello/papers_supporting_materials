/-
Osserman/Defs/SmallRoots.lean — the definitions of Section 8 of paper 013 ("Further multiplicity reductions",
sec_small_roots.tex of the Zenodo posting copy of the paper): named
patterns, orthogonal projections, the Clifford product Ω, the family of Lemma 8.1, the ring 𝒪 = ℝ[x]/(q), polynomial
eigenfields, (eq:cubicidentities), the data of Lemma 8.2, of the three-column step and of Subsections 8.3-8.6.
TRUST SURFACE: every definition carries its tex lines and one sentence saying what it means.
Author: Dave Goel. Copyright (C) Dave Goel 2026--now.
-/
import Osserman.Defs.SixPieces
import Osserman.Defs.Cayley
import Osserman.Defs.Threshold

namespace Osserman

open Matrix MvPolynomial

/-! ## New definitions for Section 8 -/

/-- The multiplicity pattern `m` with the reduced eigenvalues NAMED `ev` (lines 6-14, 173-174, 223-224, 254-257): the
`ev i` are distinct and `ev i` has reduced multiplicity `m i` at every unit `x`.
TRUST SURFACE: `HasPattern R m` is, by its definition, `∃ ev, PatternEv R m ev`; this only gives the eigenvalues names
(`ev 0` is the one shifted to zero in §8.3-8.5). -/
def PatternEv {n k : ℕ} (R : CurvTensor n) (m : Fin k → ℕ) (ev : Fin k → ℝ) : Prop :=
  Function.Injective ev ∧ ∀ x : Vec n, x ⬝ᵥ x = 1 → ∀ i, R.redMult x (ev i) = m i

/-- `w` is the orthogonal projection of `v` onto `W` (Lemma 8.1, line 22: "$\pi_{N(x)}Kx$"; §8.3, lines 213-215:
"the projection lengths of $Jx$ onto the new eigenspaces").
TRUST SURFACE: `w ∈ W` and `v - w ⊥ W`. This decomposition is unique, so "the projection of `v` has squared length `c`"
is written "some `w` with `IsOrthProj W v w` has `w ⬝ᵥ w = c`". -/
def IsOrthProj {n : ℕ} (W : Submodule ℝ (Vec n)) (v w : Vec n) : Prop := w ∈ W ∧ v - w ∈ orthSub W

/-- `Ω = H_0H_1⋯H_8` (proof of Lemma 8.1, line 45), the ordered product of a finite family of matrices.
TRUST SURFACE: the product `H_0 * H_1 * ⋯ * H_{k-1}`, in this order. -/
def cliffProd {n k : ℕ} (H : Fin k → Matrix (Fin n) (Fin n) ℝ) : Matrix (Fin n) (Fin n) ℝ := (List.ofFn H).prod

/-- `H_i(t) = cos t·H_i + c^{-1/2} sin t·A_i` with `H_i = S_i` (the standard system `stdSys`) and
`A_i = (H_iK - KH_i)/2` (proof of Lemma 8.1, lines 27-28, 37-40).
TRUST SURFACE: exactly this combination; `c^{-1/2}` is `(√c)⁻¹`. -/
noncomputable def lem81Fam (K : Matrix (Fin 16) (Fin 16) ℝ) (c t : ℝ) (i : Fin 9) : Matrix (Fin 16) (Fin 16) ℝ :=
  Real.cos t • stdSys i + ((Real.sqrt c)⁻¹ * Real.sin t) • ((1 / 2 : ℝ) • (stdSys i * K - K * stdSys i))

/-- `𝒪 = ℝ[x_1, …, x_16]/(q)` with `q = |x|²` (lines 58-60).
TRUST SURFACE: the quotient of the real polynomial ring in 16 variables by the ideal generated by `sqP 16 = ∑ x_i²`. -/
abbrev Ocal := MvPolynomial (Fin 16) ℝ ⧸ Ideal.span {sqP 16}

/-- `π : ℝ[x_1, …, x_16] → 𝒪`, "the projection" (line 60). TRUST SURFACE: the quotient map. -/
noncomputable def piO : MvPolynomial (Fin 16) ℝ →+* Ocal := Ideal.Quotient.mk _

/-- The linear polynomial field `x ↦ Mx` (lines 88, 94, 103, 117-118, 132: "$Jx$", "$Cx$", "$Bx$", "$B'x$").
TRUST SURFACE: component `j` is the polynomial `∑_k M_jk x_k`. -/
noncomputable def linP {n : ℕ} (M : Matrix (Fin n) (Fin n) ℝ) : Fin n → MvPolynomial (Fin n) ℝ :=
  fun j => ∑ k, MvPolynomial.C (M j k) * X k

/-- The linear form `x ↦ ⟨f, x⟩` as a polynomial (line 128: "$\varphi(x)=\ip fx$"; line 116: "$\ip ax$").
TRUST SURFACE: the polynomial `∑_k f_k x_k`. -/
noncomputable def formP {n : ℕ} (f : Vec n) : MvPolynomial (Fin n) ℝ := ∑ k, MvPolynomial.C (f k) * X k

/-- `P` is a polynomial eigenvector field of the reduced eigenvalue `μ` (lines 65-66: "A polynomial eigenvector field of
a simple eigenvalue is a \emph{simple eigenfield}"; lines 139, 175-176, 225-226, 255-256, 299-301).
TRUST SURFACE: at every `x`, `P(x)` lies in `x^⊥` and in the `μ|x|²`-eigenspace of `J_x` (the REDUCED eigenspace, as in
`redMult`; the eigenvalue is scaled by `|x|²` because `J_x` is quadratic in `x`); `P(x) = 0` is allowed. -/
def IsEigenfield (R : CurvTensor 16) (μ : ℝ) (P : Fin 16 → MvPolynomial (Fin 16) ℝ) : Prop :=
  ∀ x : Vec 16, evalField P x ∈ Module.End.eigenspace (R.jacobiMap x) (μ * (x ⬝ᵥ x)) ⊓ perp x

/-- The identities (eq:cubicidentities) (lines 68-70): `⟨P(x),x⟩ = 0`, `|P(x)|² = q³`, `P(P(x)) = -q⁴x`.
TRUST SURFACE: these three identities at every `x ∈ ℝ^16` (equivalent to the polynomial identities, `ℝ` being
infinite). -/
def CubicIdentities (P : Fin 16 → MvPolynomial (Fin 16) ℝ) : Prop :=
  ∀ x : Vec 16, evalField P x ⬝ᵥ x = 0 ∧ evalField P x ⬝ᵥ evalField P x = (x ⬝ᵥ x) ^ 3 ∧
    evalField P (evalField P x) = -((x ⬝ᵥ x) ^ 4) • x

/-- The lifted form in the proof of Lemma 8.2 (lines 93-97): `P` has homogeneous cubic components satisfying (8.1), and
`P(x) = φ(x)Ψ(x) + qCx` with `φ` homogeneous of degree `r ∈ {1, 2, 3}` and not divisible by `q`, the components of `Ψ`
homogeneous of degree `3 - r`, and `C` (here `Cm`) linear.
TRUST SURFACE: exactly these conditions, the decomposition as an identity in `ℝ[x_1, …, x_16]`. -/
def Lem82Lift (P : Fin 16 → MvPolynomial (Fin 16) ℝ) (r : ℕ) (φ : MvPolynomial (Fin 16) ℝ)
    (Ψ : Fin 16 → MvPolynomial (Fin 16) ℝ) (Cm : Matrix (Fin 16) (Fin 16) ℝ) : Prop :=
  (∀ j, (P j).IsHomogeneous 3) ∧ CubicIdentities P ∧ 1 ≤ r ∧ r ≤ 3 ∧ φ.IsHomogeneous r ∧ ¬ sqP 16 ∣ φ ∧
    (∀ j, (Ψ j).IsHomogeneous (3 - r)) ∧ ∀ j, P j = φ * Ψ j + sqP 16 * linP Cm j

/-- The hypotheses of the three-column step (lines 138-142): `P_1, P_2, P_3` (here `P 0, P 1, P 2`) are "mutually
orthogonal cubic eigenfields of squared norm $q^3$ satisfying $\sum_{i=1}^3w_iP_iP_i^T\equiv0$ modulo $q$, with
$w_1,w_2>0>w_3$"; `μ i` is the eigenvalue of `P i`.
TRUST SURFACE: the congruence is entrywise (`q = sqP 16` divides each entry `∑_i w_i(P_i)_a(P_i)_b` of the `16 × 16`
polynomial matrix); the other conditions hold at every `x`. -/
def ThreeColHyp (R : CurvTensor 16) (μ : Fin 3 → ℝ) (P : Fin 3 → Fin 16 → MvPolynomial (Fin 16) ℝ)
    (wt : Fin 3 → ℝ) : Prop :=
  (∀ i j, (P i j).IsHomogeneous 3) ∧ (∀ i, IsEigenfield R (μ i) (P i)) ∧
    (∀ (x : Vec 16) (i k : Fin 3), i ≠ k → evalField (P i) x ⬝ᵥ evalField (P k) x = 0) ∧
    (∀ (x : Vec 16) (i : Fin 3), evalField (P i) x ⬝ᵥ evalField (P i) x = (x ⬝ᵥ x) ^ 3) ∧
    0 < wt 0 ∧ 0 < wt 1 ∧ wt 2 < 0 ∧ ∀ a b : Fin 16, sqP 16 ∣ ∑ i, MvPolynomial.C (wt i) * P i a * P i b

/-- The images `p_i ∈ 𝒪^16` of the columns "after rescaling the columns by nonzero constants" (lines 142-143): the
constants are `√|w_i|`.
TRUST SURFACE: `p_i = π(√|w_i| P_i)`, componentwise (row `s8_tc_rankone`: these satisfy (eq:rankoneK)). -/
noncomputable def tcImg (wt : Fin 3 → ℝ) (P : Fin 3 → Fin 16 → MvPolynomial (Fin 16) ℝ) : Fin 3 → Fin 16 → Ocal :=
  fun i a => piO (MvPolynomial.C (Real.sqrt |wt i|) * P i a)

/-- The data of Subsection 8.3 after the shift (lines 173-177): `(M,N) = (7,6)` or `(8,5)`; `R` has the pattern
`(M,N,1,1)` with eigenvalues `ev = (0, λ, μ, σ)` (the multiplicity-`M` eigenvalue shifted to zero); `P 0`, `P 1` are
"cubic normalized eigenfields" of `μ`, `σ` satisfying (8.1) ("linear ones homogenized by $q$").
TRUST SURFACE: exactly these conditions (the data is symmetric under exchanging `(ev 2, P 0)` with `(ev 3, P 1)`). -/
def Sec83Data (R : CurvTensor 16) (M N : ℕ) (ev : Fin 4 → ℝ) (P : Fin 2 → Fin 16 → MvPolynomial (Fin 16) ℝ) : Prop :=
  ((M = 7 ∧ N = 6) ∨ (M = 8 ∧ N = 5)) ∧ PatternEv R ![M, N, 1, 1] ev ∧ ev 0 = 0 ∧
    (∀ i j, (P i j).IsHomogeneous 3) ∧ (∀ i, CubicIdentities (P i)) ∧
    IsEigenfield R (ev 2) (P 0) ∧ IsEigenfield R (ev 3) (P 1)

/-- The data of Subsection 8.4 after the shift (lines 223-227): `(M,N) = (7,5)` or `(8,4)`; pattern `(M,N,2,1)` with
eigenvalues `ev = (0, λ, μ, σ)`, `μ` double and `σ` simple; "cubic normalized fields $P_1,P_2$ for $\mu$ and $P_3$ for
$\sigma$" (here `P 0, P 1, P 2`), mutually orthogonal of squared norm `q³`; `P 2` satisfies (8.1).
TRUST SURFACE: exactly these conditions. -/
def Sec84Data (R : CurvTensor 16) (M N : ℕ) (ev : Fin 4 → ℝ) (P : Fin 3 → Fin 16 → MvPolynomial (Fin 16) ℝ) : Prop :=
  ((M = 7 ∧ N = 5) ∨ (M = 8 ∧ N = 4)) ∧ PatternEv R ![M, N, 2, 1] ev ∧ ev 0 = 0 ∧
    (∀ i j, (P i j).IsHomogeneous 3) ∧
    (∀ (x : Vec 16) (i k : Fin 3), evalField (P i) x ⬝ᵥ evalField (P k) x = if i = k then (x ⬝ᵥ x) ^ 3 else 0) ∧
    IsEigenfield R (ev 2) (P 0) ∧ IsEigenfield R (ev 2) (P 1) ∧ IsEigenfield R (ev 3) (P 2) ∧ CubicIdentities (P 2)

/-- The data of Subsection 8.5 after the shift (lines 254-258): `(M,N) = (7,5)` or `(8,4)`; pattern `(M,N,1,1,1)` with
eigenvalues `ev = (0, λ, μ_1, μ_2, μ_3)`; cubic eigenfields `P 0, P 1, P 2` of `μ_1, μ_2, μ_3` satisfying (8.1).
TRUST SURFACE: exactly these conditions. -/
def Sec85Data (R : CurvTensor 16) (M N : ℕ) (ev : Fin 5 → ℝ) (P : Fin 3 → Fin 16 → MvPolynomial (Fin 16) ℝ) : Prop :=
  ((M = 7 ∧ N = 5) ∨ (M = 8 ∧ N = 4)) ∧ PatternEv R ![M, N, 1, 1, 1] ev ∧ ev 0 = 0 ∧
    (∀ i j, (P i j).IsHomogeneous 3) ∧ (∀ i, CubicIdentities (P i)) ∧
    IsEigenfield R (ev 2) (P 0) ∧ IsEigenfield R (ev 3) (P 1) ∧ IsEigenfield R (ev 4) (P 2)

/-- The second hypothesis of Theorem F (lines 12-14) and the setting of Subsection 8.6 (lines 298-300): `R` is
Osserman, the reduced eigenvalue `μ₀` has multiplicity `M ∈ {7, 8}` at every unit `x`, and "every other eigenvalue has
multiplicity at most two".
TRUST SURFACE: exactly this. -/
def SmallMultHyp (R : CurvTensor 16) (μ0 : ℝ) (M : ℕ) : Prop :=
  R.IsOsserman ∧ (M = 7 ∨ M = 8) ∧ (∀ x : Vec 16, x ⬝ᵥ x = 1 → R.redMult x μ0 = M) ∧
    ∀ x : Vec 16, x ⬝ᵥ x = 1 → ∀ μ : ℝ, μ ≠ μ0 → R.redMult x μ ≤ 2

/-- "$P$ the $16\times r$ matrix of fields" (line 304), at the point `x`.
TRUST SURFACE: entry `(a, j)` is the `a`-th component of `P_j(x)`. -/
noncomputable def fieldMat {r : ℕ} (P : Fin r → Fin 16 → MvPolynomial (Fin 16) ℝ) (x : Vec 16) :
    Matrix (Fin 16) (Fin r) ℝ :=
  Matrix.of fun a j => eval x (P j a)

end Osserman
