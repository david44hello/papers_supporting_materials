/-
NagataHigman/Defs/GroupAlgebra.lean — the group algebra F[S_N] and its named elements (paper Sections 2.1-2.2, 4.2-4.3).
Author: Dave Goel. Copyright (C) Dave Goel 2026--now.

Indexing: `S_N` acts on `Fin N = {0, …, N-1}` (paper: `{1, …, N}`); the paper's point `N` is `N - 1` here.
Composition is right to left, `(σ * τ) i = σ (τ i)` — the paper's convention (line 293) and Mathlib's.
-/
import Mathlib

noncomputable section

namespace NagataHigman

open Equiv Finset

variable (F : Type*) [Field F]

/-- The group algebra `F[S_N]`. The coefficient the paper writes `f(σ)` (line 175) is `f.coeff σ`. -/
abbrev GrpAlg (N : ℕ) : Type _ := MonoidAlgebra F (Perm (Fin N))

/-- The basis element `σ ∈ F[S_N]`. -/
def perm {N : ℕ} (σ : Perm (Fin N)) : GrpAlg F N := MonoidAlgebra.single σ (1 : F)

/-- The coefficient pairing `⟨a, b⟩ = ∑_σ a(σ) b(σ)` (paper line 267). -/
def coeffPairing {N : ℕ} (a b : GrpAlg F N) : F := ∑ σ : Perm (Fin N), a.coeff σ * b.coeff σ

/-- `σ` is an `N`-cycle: a single cycle that moves every point of `Fin N`. (For `N ≤ 1` there are no `N`-cycles in this
convention; every use has `N ≥ 2`.) -/
def IsFullCycle {N : ℕ} (σ : Perm (Fin N)) : Prop := σ.IsCycle ∧ σ.support = Finset.univ

/-- `C_N`: the span of the `N`-cycles in `F[S_N]` (paper line 295). -/
def cycleSpan (N : ℕ) : Submodule F (GrpAlg F N) :=
  Submodule.span F (perm F '' {σ | IsFullCycle σ})

/-- `E_X = ∑_{π ∈ Sym(X)} sgn(π) π` for `X ⊆ Fin N` (paper line 325, there `E_K`); `Sym(X)` = permutations moving only
points of `X`. -/
def altSum {N : ℕ} (X : Finset (Fin N)) : GrpAlg F N :=
  ∑ π ∈ univ.filter (fun π : Perm (Fin N) => π.support ⊆ X), ((Perm.sign π : ℤ) : F) • perm F π

/-- `E = ∑_{π ∈ S_{n+1}} sgn(π) π`, with `S_{n+1} ⊆ S_N` the permutations of the first `n+1` points
(paper line 273: `S_{n+1}` fixes `n+2, …, N`). -/
def altGen (N n : ℕ) : GrpAlg F N := altSum F (univ.filter (fun i : Fin N => (i : ℕ) ≤ n))

/-- `I`: the two-sided ideal of `F[S_N]` generated by `E` — the span of all `g E h` (paper line 274). -/
def altIdeal (N n : ℕ) : Submodule F (GrpAlg F N) :=
  Submodule.span F {x | ∃ g h : GrpAlg F N, x = g * altGen F N n * h}

/-- The Jucys–Murphy element `J_k = ∑_{i < k} (i k)` (paper line 465; `J_1 = 0`). -/
def jucysMurphy {N : ℕ} (k : Fin N) : GrpAlg F N :=
  ∑ i ∈ univ.filter (fun i : Fin N => i < k), perm F (swap i k)

/-- The star element `X^{(j)} = ∑_{i ≠ j} (i j)` (paper line 517). -/
def starElem {N : ℕ} (j : Fin N) : GrpAlg F N :=
  ∑ i ∈ univ.filter (fun i : Fin N => i ≠ j), perm F (swap i j)

/-- The sign twist `ε(a) = ∑_σ sgn(σ) a(σ) σ`, the linear extension of `σ ↦ sgn(σ) σ` (paper (F7), line 287). -/
def signTwist {N : ℕ} (a : GrpAlg F N) : GrpAlg F N :=
  ∑ σ : Perm (Fin N), (((Perm.sign σ : ℤ) : F) * a.coeff σ) • perm F σ

/-- The stabilizer `Stab(j) = {σ : σ j = j}` (paper lines 428, 454); `Stab(N-1) = S_{N-1}`. -/
def stab {N : ℕ} (j : Fin N) : Set (Perm (Fin N)) := {σ | σ j = j}

end NagataHigman

end
