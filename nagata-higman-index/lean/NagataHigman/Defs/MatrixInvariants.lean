/-
NagataHigman/Defs/MatrixInvariants.lean — the matrix invariants of Corollary 1.1 (trust surface: definitions only).
Author: Dave Goel. Copyright (C) Dave Goel 2026--now.

Paper v1.10, Corollary 1.1
(lines 149-152, verbatim): "For $n\ge3$ and every $k\ge1$, the algebra of polynomial invariants of $k$-tuples
$(X_1,\dots,X_k)$ of $n\times n$ matrices over $F$ under simultaneous conjugation is generated by the traces
$\tr(X_{i_1}\cdots X_{i_r})$ with $1\le r\le n^2-2$." ($F$ is a field of characteristic zero, line 67.)

Modelling. A `k`-tuple of `n × n` matrices has the `k n²` coordinates `(i, a, b)` = the `(a, b)` entry of `X_i`
(indices from 0). A polynomial invariant is a polynomial `p` in these coordinates, invariant under simultaneous
conjugation; over an infinite field (every field of characteristic 0) `p` is determined by its function (claim
`cor_1_1_polyfun`; the corollary stated on functions is claim `cor_1_1_functions`), so polynomials and polynomial
functions are the same, `MvPolynomial (Fin k × Fin n × Fin n) F`. Invariance is stated for the
FUNCTION: `p(g X_1 g⁻¹, …, g X_k g⁻¹) = p(X_1, …, X_k)` for every invertible `g` and every tuple `X`. The trace
`tr(X_{i_1} ⋯ X_{i_r})` is the polynomial `tr(x_{i_1} ⋯ x_{i_r})` of the generic matrices `x_i = (X_{(i,a,b)})_{a,b}`,
for a word `[i_1, …, i_r]` in `Fin k` with `1 ≤ r`.
-/
import Mathlib

noncomputable section

namespace NagataHigman

variable (F : Type*) [Field F] (n k : ℕ)

/-- The polynomials in the entries of a `k`-tuple of `n × n` matrices: the variable `(i, a, b)` is the `(a, b)` entry
of the `i`-th matrix. -/
abbrev MatPoly : Type _ := MvPolynomial (Fin k × Fin n × Fin n) F

variable {F n k}

/-- The coordinates of a `k`-tuple of `n × n` matrices: `(i, a, b) ↦ (X_i)_{a b}`. -/
def tupleCoords (X : Fin k → Matrix (Fin n) (Fin n) F) : Fin k × Fin n × Fin n → F :=
  fun v => X v.1 v.2.1 v.2.2

/-- The polynomial function `p` is invariant under simultaneous conjugation:
`p(g X_1 g⁻¹, …, g X_k g⁻¹) = p(X_1, …, X_k)` for every `g ∈ GL_n(F)` and every `k`-tuple `X`. -/
def IsConjInvariant (p : MatPoly F n k) : Prop :=
  ∀ (g : GL (Fin n) F) (X : Fin k → Matrix (Fin n) (Fin n) F),
    MvPolynomial.eval (tupleCoords (fun i => (g : Matrix (Fin n) (Fin n) F) * X i * ((g⁻¹ : GL (Fin n) F) :
      Matrix (Fin n) (Fin n) F))) p = MvPolynomial.eval (tupleCoords X) p

variable (F n k)

/-- The invariants of `k`-tuples of `n × n` matrices under simultaneous conjugation. -/
def matInvariants : Set (MatPoly F n k) := {p | IsConjInvariant p}

/-- The generic matrix `x_i`: its `(a, b)` entry is the variable `(i, a, b)`. -/
def genericMatrix (i : Fin k) : Matrix (Fin n) (Fin n) (MatPoly F n k) :=
  Matrix.of fun a b => MvPolynomial.X (i, a, b)

/-- `tr(X_{i_1} ⋯ X_{i_r})` for the word `w = [i_1, …, i_r]`: the trace of the product of the generic matrices. -/
def tracePoly (w : List (Fin k)) : MatPoly F n k :=
  Matrix.trace (w.map (genericMatrix F n k)).prod

/-- The traces `tr(X_{i_1} ⋯ X_{i_r})` with `1 ≤ r ≤ m`. -/
def tracePolys (m : ℕ) : Set (MatPoly F n k) :=
  {p | ∃ w : List (Fin k), 1 ≤ w.length ∧ w.length ≤ m ∧ tracePoly F n k w = p}

end NagataHigman

end
