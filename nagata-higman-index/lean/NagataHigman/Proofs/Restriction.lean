/-
NagataHigman/Proofs/Restriction.lean — R1: the restriction fact, DERIVED from a Young system's `wedderburn` and
`youngBasis` fields plus standard-tableau combinatorics (Okounkov–Vershik route; paper v1.02 lines 320-322, 397-399):
for `top = N-1`, `span ρ_λ(S_{N-1})` is exactly the commutant of `ρ_λ(J_{N-1})`.
Author: Dave Goel. Copyright (C) Dave Goel 2026--now.

Route. W := the subalgebra generated by `ρ_λ(S_{N-1})`; as a subspace it IS `span ρ_λ(S_{N-1})` (a monoid image).
In a Young basis `b`: (1) W contains `ρ(J_i)` for `i < top`; Lagrange products of these give every projector
`E_{TT}` (the contents below `top` determine `T`, H4). (2) For an admissible swap `s = (k k+1)`, `k+1 < top`, with
`T'.pos = T.pos ∘ s`: `E_{T'T'} ρ(s) E_{TT} = ρ(s)_{T'T} E_{T'T}` and `ρ(s)_{T'T} ≠ 0` (from `s² = 1`, the support and
diagonal of `ρ(s)` [Spectral.lean], and the content gap H2). (3) Chains of such swaps (H1) give every `E_{T'T}` with
`top` in the same cell. (4) `X` commuting with `ρ(J_top)` has `X_{T'T} = 0` unless `c_{T'}(top) = c_T(top)`, which
forces the same cell (H3). So `X = Σ X_{T'T} E_{T'T} ∈ W`. The converse: `S_{N-1}` commutes with `J_{N-1}`.
-/
import NagataHigman.Proofs.Blocks
import NagataHigman.Proofs.TwoCorner.Spectral
import NagataHigman.Proofs.Tableaux
import NagataHigman.Proofs.ContentGap
import NagataHigman.Proofs.SytConnect

noncomputable section

namespace NagataHigman.Proofs

open NagataHigman Equiv Finset Matrix

/-! ### Matrix units of a basis -/

namespace BasisUnits

variable {F : Type*} [Field F] {d : ℕ} {ι : Type*} (b : Module.Basis ι F (Fin d → F))

/-- Coordinates of a matrix in the basis `b`: `[M]_{U,T} = b.repr (M b_T) U`. -/
def coord (M : Matrix (Fin d) (Fin d) F) (U T : ι) : F := b.repr (M *ᵥ b T) U

lemma ext_basis {M M' : Matrix (Fin d) (Fin d) F} (h : ∀ T, M *ᵥ b T = M' *ᵥ b T) : M = M' := by
  apply Matrix.toLin'.injective
  exact b.ext fun T => by simp only [Matrix.toLin'_apply]; exact h T

/-- The matrix unit `E_{T'T}` of `b`: `b_T ↦ b_{T'}`, the other basis vectors ↦ 0. -/
def unit (T' T : ι) : Matrix (Fin d) (Fin d) F := LinearMap.toMatrix' ((b.coord T).smulRight (b T'))

lemma unit_mulVec (T' T : ι) (v : Fin d → F) : unit b T' T *ᵥ v = b.repr v T • b T' := by
  rw [← Matrix.toLin'_apply, unit, Matrix.toLin'_toMatrix']
  simp [Module.Basis.coord_apply]

lemma unit_mulVec_basis [DecidableEq ι] (T' T V : ι) : unit b T' T *ᵥ b V = if V = T then b T' else 0 := by
  rw [unit_mulVec, Module.Basis.repr_self, Finsupp.single_apply]
  split_ifs <;> simp

lemma unit_mul_unit [DecidableEq ι] (T'' T' T : ι) : unit b T'' T' * unit b T' T = unit b T'' T := by
  apply ext_basis b
  intro V
  rw [← Matrix.mulVec_mulVec]
  by_cases h : V = T
  · subst h
    simp [unit_mulVec_basis]
  · simp [unit_mulVec_basis, h]

lemma coord_one (T : ι) : coord b 1 T T = 1 := by
  simp [coord]

lemma coord_mul [Fintype ι] (M M' : Matrix (Fin d) (Fin d) F) (U T : ι) :
    coord b (M * M') U T = ∑ V, coord b M' V T * coord b M U V := by
  unfold coord
  rw [← Matrix.mulVec_mulVec]
  conv_lhs => rw [← b.sum_repr (M' *ᵥ b T)]
  rw [Matrix.mulVec_sum, map_sum, Finsupp.finsetSum_apply]
  refine Finset.sum_congr rfl fun V _ => ?_
  rw [Matrix.mulVec_smul, map_smul, Finsupp.smul_apply, smul_eq_mul]

/-- Every matrix is the sum of its coordinates times the matrix units. -/
lemma eq_sum_units [Fintype ι] [DecidableEq ι] (X : Matrix (Fin d) (Fin d) F) : X = ∑ T, ∑ T', coord b X T' T • unit b T' T := by
  apply ext_basis b
  intro V
  rw [Matrix.sum_mulVec, Finset.sum_eq_single V]
  · rw [Matrix.sum_mulVec]
    simp only [Matrix.smul_mulVec, unit_mulVec_basis]
    exact (b.sum_repr (X *ᵥ b V)).symm
  · intro T _ hT
    rw [Matrix.sum_mulVec]
    exact Finset.sum_eq_zero fun T' _ => by
      rw [Matrix.smul_mulVec, unit_mulVec_basis, ite_eq_right (Ne.symm hT), smul_zero]
  · intro h
    exact absurd (Finset.mem_univ V) h

/-- A product (in list order) of matrices acting diagonally on `b` acts diagonally, with the product of the
eigenvalues. -/
lemma list_prod_mulVec {κ : Type*} (L : List κ) (Q : κ → Matrix (Fin d) (Fin d) F) (e : κ → ι → F)
    (h : ∀ U ∈ L, ∀ V, Q U *ᵥ b V = e U V • b V) (V : ι) :
    (L.map Q).prod *ᵥ b V = (L.map fun U => e U V).prod • b V := by
  induction L with
  | nil => simp
  | cons U L ih =>
    rw [List.map_cons, List.prod_cons, ← Matrix.mulVec_mulVec,
      ih fun U' hU' => h U' (List.mem_cons_of_mem _ hU'), Matrix.mulVec_smul,
      h U List.mem_cons_self, smul_smul, List.map_cons, List.prod_cons, mul_comm]

end BasisUnits

open BasisUnits

/-! ### Contents below `top` determine the tableau (H4) -/

section Contents

variable {N : ℕ} {lam : Shape N}

/-- The contents of `T` sum to the content sum of the diagram, independently of `T`. -/
lemma sum_content_eq (T : SYT lam) :
    ∑ k, T.content k = ∑ x ∈ lam.diagram.cells, ((x.2 : ℤ) - (x.1 : ℤ)) := by
  classical
  have himg : Finset.univ.image T.pos = lam.diagram.cells := by
    apply Finset.Subset.antisymm
    · intro x hx
      obtain ⟨m, -, rfl⟩ := Finset.mem_image.1 hx
      exact T.pos_mem m
    · intro x hx
      obtain ⟨m, hm⟩ := exists_pos_eq T hx
      exact Finset.mem_image.2 ⟨m, Finset.mem_univ m, hm⟩
  rw [← himg, Finset.sum_image fun a _ b _ h => T.pos_injective h]
  rfl

/-- **H4**: the contents of the entries below `top = N-1` determine a standard tableau. -/
theorem syt_eq_of_content_lt_top (top : Fin N) (htop : (top : ℕ) + 1 = N) {T T' : SYT lam}
    (h : ∀ i : Fin N, (i : ℕ) < top → T.content i = T'.content i) : T = T' := by
  classical
  apply syt_eq_of_content_eq
  have hlt : ∀ i ∈ Finset.univ.erase top, T.content i = T'.content i := by
    intro i hi
    apply h
    have h1 := Finset.ne_of_mem_erase hi
    have h2 := i.isLt
    have h3 : (i : ℕ) ≠ top := fun e => h1 (Fin.ext e)
    omega
  have hsum : T.content top = T'.content top := by
    have h1 := Finset.add_sum_erase Finset.univ (fun k => T.content k) (Finset.mem_univ top)
    have h2 := Finset.add_sum_erase Finset.univ (fun k => T'.content k) (Finset.mem_univ top)
    rw [Finset.sum_congr rfl hlt] at h1
    rw [sum_content_eq T] at h1
    rw [sum_content_eq T'] at h2
    linarith
  intro i
  by_cases hi : i = top
  · subst hi
    exact hsum
  · exact hlt i (Finset.mem_erase.2 ⟨hi, Finset.mem_univ i⟩)

end Contents

/-! ### The restriction fact -/

namespace YoungSystem

variable {F : Type*} [Field F] {N : ℕ} (Y : YoungSystem F N)

/-- The stabilizer of `top`, as a submonoid. -/
def stabSub (top : Fin N) : Submonoid (Perm (Fin N)) where
  carrier := stab top
  mul_mem' {a c} ha hc := by
    show (a * c) top = top
    rw [Perm.mul_apply, show c top = top from hc, show a top = top from ha]
  one_mem' := rfl

/-- The subalgebra generated by `ρ_λ(S_{N-1})` is, as a subspace, the span of `ρ_λ(S_{N-1})`. -/
lemma toSubmodule_adjoin (lam : Shape N) (top : Fin N) :
    Subalgebra.toSubmodule (Algebra.adjoin F
      ((Y.rho lam : Perm (Fin N) → Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) '' stab top)) =
      Submodule.span F ((Y.rho lam : Perm (Fin N) → Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) '' stab top) := by
  have hS : ((Y.rho lam : Perm (Fin N) → Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) '' stab top) =
      ((stabSub top).map (Y.rho lam) : Set (Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F)) := by
    rw [Submonoid.coe_map]
    rfl
  rw [Algebra.adjoin_eq_span, hS, Submonoid.closure_eq]

/-- `W`: the subalgebra generated by `ρ_λ(S_{N-1})`. -/
def subW (lam : Shape N) (top : Fin N) : Subalgebra F (Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) :=
  Algebra.adjoin F ((Y.rho lam : Perm (Fin N) → Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) '' stab top)

lemma rho_mem_subW {lam : Shape N} {top : Fin N} {σ : Perm (Fin N)} (hσ : σ ∈ stab top) :
    Y.rho lam σ ∈ subW Y lam top :=
  Algebra.subset_adjoin ⟨σ, hσ, rfl⟩

lemma swap_mem_stab {top i j : Fin N} (hi : i ≠ top) (hj : j ≠ top) : swap i j ∈ stab top :=
  swap_apply_of_ne_of_ne (Ne.symm hi) (Ne.symm hj)

/-- `ρ_λ(J_i) ∈ W` for `i < top`: `J_i` is a sum of transpositions of points below `top`. -/
lemma rhoAlg_J_mem (lam : Shape N) {top : Fin N} (i : Fin N) (hi : (i : ℕ) < top) :
    Y.rhoAlg lam (jucysMurphy F i) ∈ subW Y lam top := by
  unfold jucysMurphy
  rw [map_sum]
  apply Subalgebra.sum_mem
  intro j hj
  rw [Finset.mem_filter] at hj
  rw [rhoAlg_perm Y]
  apply rho_mem_subW
  apply swap_mem_stab
  · intro e
    have h1 := Fin.lt_def.1 hj.2
    rw [e] at h1
    omega
  · intro e
    rw [e] at hi
    omega

variable [CharZero F] {lam : Shape N} [Fintype (SYT lam)] [DecidableEq (SYT lam)]
  (b : Module.Basis (SYT lam) F (Fin (Y.dim lam) → F))

/-- The Young-basis projector `E_{TT}` lies in `W` (Lagrange products of the `ρ(J_i)`, `i < top`; H4). -/
theorem unit_self_mem (hb : IsYoungBasis Y b) (top : Fin N) (htop : (top : ℕ) + 1 = N) (T : SYT lam) :
    unit b T T ∈ subW Y lam top := by
  classical
  have hsep : ∀ U : SYT lam, U ≠ T → ∃ i : Fin N, (i : ℕ) < top ∧ U.content i ≠ T.content i := by
    intro U hU
    by_contra hcon
    simp only [not_exists, not_and, not_not] at hcon
    exact hU (syt_eq_of_content_lt_top top htop hcon)
  have hsep' : ∀ U : SYT lam, ∃ i : Fin N, U ≠ T → ((i : ℕ) < top ∧ U.content i ≠ T.content i) := by
    intro U
    by_cases hU : U = T
    · exact ⟨top, fun h => absurd hU h⟩
    · obtain ⟨i, hi⟩ := hsep U hU
      exact ⟨i, fun _ => hi⟩
  choose idx hidx using hsep'
  set c : SYT lam → Fin N → F := fun V i => ((V.content i : ℤ) : F) with hc_def
  set Q : SYT lam → Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F := fun U =>
    (c T (idx U) - c U (idx U))⁻¹ • (Y.rhoAlg lam (jucysMurphy F (idx U)) - c U (idx U) • 1) with hQ_def
  set e : SYT lam → SYT lam → F := fun U V =>
    (c T (idx U) - c U (idx U))⁻¹ * (c V (idx U) - c U (idx U)) with he_def
  have hQ : ∀ U V, Q U *ᵥ b V = e U V • b V := by
    intro U V
    simp only [hQ_def, he_def]
    rw [Matrix.smul_mulVec, Matrix.sub_mulVec, hb V (idx U), Matrix.smul_mulVec, Matrix.one_mulVec, ← sub_smul,
      smul_smul]
  have hne : ∀ U, U ≠ T → c T (idx U) - c U (idx U) ≠ 0 := by
    intro U hU h0
    apply (hidx U hU).2
    have h1 : ((T.content (idx U) : ℤ) : F) = ((U.content (idx U) : ℤ) : F) := sub_eq_zero.1 h0
    exact_mod_cast h1.symm
  set L := (Finset.univ.erase T).toList with hL
  have hLmem : ∀ U, U ∈ L ↔ U ≠ T := by
    intro U
    rw [hL, Finset.mem_toList, Finset.mem_erase]
    simp
  have hmem : (L.map Q).prod ∈ subW Y lam top := by
    apply Subalgebra.list_prod_mem
    intro x hx
    obtain ⟨U, hU, rfl⟩ := List.mem_map.1 hx
    have hUT := (hLmem U).1 hU
    exact Subalgebra.smul_mem _ (Subalgebra.sub_mem _ (rhoAlg_J_mem Y lam (idx U) (hidx U hUT).1)
      (Subalgebra.smul_mem _ (Subalgebra.one_mem _) _)) _
  have hprod := list_prod_mulVec b L Q e (fun U _ V => hQ U V)
  have heq : unit b T T = (L.map Q).prod := by
    apply ext_basis b
    intro V
    rw [unit_mulVec_basis, hprod V]
    by_cases hV : V = T
    · subst hV
      rw [ite_eq_left rfl, List.prod_eq_one, one_smul]
      intro x hx
      obtain ⟨U, hU, rfl⟩ := List.mem_map.1 hx
      exact inv_mul_cancel₀ (hne U ((hLmem U).1 hU))
    · rw [ite_eq_right hV, List.prod_eq_zero, zero_smul]
      exact List.mem_map.2 ⟨V, (hLmem V).2 hV, by simp [he_def]⟩
  rw [heq]
  exact hmem

omit [DecidableEq (SYT lam)] in
/-- For an admissible swap, `ρ(s)_{T'T} ≠ 0` (from `s² = 1`, the support and diagonal of `ρ(s)`, and H2). -/
theorem coord_swap_ne_zero (hb : IsYoungBasis Y b)
    (H2 : ∀ (T : SYT lam) (k l : Fin N), (l : ℕ) = k + 1 → (T.pos k).1 ≠ (T.pos l).1 →
      (T.pos k).2 ≠ (T.pos l).2 → T.content l - T.content k ≠ 1 ∧ T.content l - T.content k ≠ -1)
    {T T' : SYT lam} {k l : Fin N} (hkl : (l : ℕ) = k + 1) (hT' : T'.pos = T.pos ∘ swap k l) :
    coord b (Y.rho lam (swap k l)) T' T ≠ 0 := by
  classical
  set M := Y.rho lam (swap k l) with hM
  have hMM : M * M = 1 := by rw [hM, ← map_mul, Equiv.swap_mul_self, map_one]
  have hkl_ne : k ≠ l := by
    intro h
    rw [h] at hkl
    omega
  have hTT' : T' ≠ T := by
    intro h
    rw [h] at hT'
    have h1 := congrFun hT' k
    simp only [Function.comp_apply, swap_apply_left] at h1
    exact hkl_ne (T.pos_injective h1)
  have hcT' : ∀ i, T'.content i = T.content (swap k l i) := by
    intro i
    simp [SYT.content, hT']
  have hsupp : ∀ U, coord b M U T ≠ 0 → U = T ∨ U = T' := by
    intro U hU
    obtain ⟨hoff, hkl'⟩ := R_support_contents Y b hb T U k l hkl hU
    rcases hkl' with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · left
      apply syt_eq_of_content_eq
      intro i
      by_cases hik : i = k
      · subst hik
        exact h1
      by_cases hil : i = l
      · subst hil
        exact h2
      exact hoff i hik hil
    · right
      apply syt_eq_of_content_eq
      intro i
      rw [hcT']
      by_cases hik : i = k
      · subst hik
        rw [swap_apply_left]
        exact h1
      by_cases hil : i = l
      · subst hil
        rw [swap_apply_right]
        exact h2
      rw [swap_apply_of_ne_of_ne hik hil]
      exact hoff i hik hil
  have hsum := coord_mul b M M T T
  rw [hMM, coord_one] at hsum
  rw [Finset.sum_eq_add T T' (Ne.symm hTT') (fun V _ hV => by
      by_cases h0 : coord b M V T = 0
      · rw [h0, zero_mul]
      · rcases hsupp V h0 with h | h
        · exact absurd h hV.1
        · exact absurd h hV.2)
    (fun h => absurd (Finset.mem_univ T) h) (fun h => absurd (Finset.mem_univ T') h)] at hsum
  obtain ⟨hr, hdiag⟩ := R_diag_general Y b hb T k l hkl
  have hTT : coord b M T T = 1 / (((T.content l - T.content k : ℤ)) : F) := hdiag
  intro h0
  rw [h0, zero_mul, add_zero, hTT] at hsum
  have hrow : ¬ ((T.pos k).1 = (T.pos l).1 ∨ (T.pos k).2 = (T.pos l).2) := fun hs =>
    no_swap_of_same_row_or_col T k l hkl hs ⟨T', hT'⟩
  simp only [not_or] at hrow
  obtain ⟨hne1, hne2⟩ := H2 T k l hkl hrow.1 hrow.2
  have hrr : (((T.content l - T.content k : ℤ)) : F) * (((T.content l - T.content k : ℤ)) : F) = 1 := by
    calc (((T.content l - T.content k : ℤ)) : F) * (((T.content l - T.content k : ℤ)) : F)
        = (((T.content l - T.content k : ℤ)) : F) * (((T.content l - T.content k : ℤ)) : F) *
            (1 / (((T.content l - T.content k : ℤ)) : F) * (1 / (((T.content l - T.content k : ℤ)) : F))) := by
          rw [← hsum, mul_one]
      _ = 1 := by field_simp
  rcases mul_self_eq_one_iff.1 hrr with h | h
  · apply hne1
    exact_mod_cast h
  · apply hne2
    exact_mod_cast h

/-- For an admissible swap below `top`, the matrix unit `E_{T'T}` lies in `W`. -/
theorem unit_swap_mem (hb : IsYoungBasis Y b) (top : Fin N) (htop : (top : ℕ) + 1 = N)
    (H2 : ∀ (T : SYT lam) (k l : Fin N), (l : ℕ) = k + 1 → (T.pos k).1 ≠ (T.pos l).1 →
      (T.pos k).2 ≠ (T.pos l).2 → T.content l - T.content k ≠ 1 ∧ T.content l - T.content k ≠ -1)
    {T T' : SYT lam} {k l : Fin N} (hkl : (l : ℕ) = k + 1) (hl : (l : ℕ) < top)
    (hT' : T'.pos = T.pos ∘ swap k l) : unit b T' T ∈ subW Y lam top := by
  have hM : Y.rho lam (swap k l) ∈ subW Y lam top := by
    apply rho_mem_subW
    apply swap_mem_stab
    · intro e
      rw [e] at hkl
      omega
    · intro e
      rw [e] at hl
      omega
  have key : unit b T' T' * Y.rho lam (swap k l) * unit b T T =
      coord b (Y.rho lam (swap k l)) T' T • unit b T' T := by
    apply ext_basis b
    intro V
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, unit_mulVec_basis, Matrix.smul_mulVec, unit_mulVec_basis]
    by_cases hV : V = T
    · rw [ite_eq_left hV, ite_eq_left hV, unit_mulVec]
      rfl
    · rw [ite_eq_right hV, ite_eq_right hV, Matrix.mulVec_zero, Matrix.mulVec_zero, smul_zero]
  have hc := coord_swap_ne_zero Y b hb H2 hkl hT'
  have heq : unit b T' T = (coord b (Y.rho lam (swap k l)) T' T)⁻¹ •
      (unit b T' T' * Y.rho lam (swap k l) * unit b T T) := by
    rw [key, smul_smul, inv_mul_cancel₀ hc, one_smul]
  rw [heq]
  exact Subalgebra.smul_mem _ (Subalgebra.mul_mem _ (Subalgebra.mul_mem _
    (unit_self_mem Y b hb top htop T') hM) (unit_self_mem Y b hb top htop T)) _

/-- Chains of admissible swaps below `top` give matrix units in `W`. -/
theorem unit_mem_of_chain (hb : IsYoungBasis Y b) (top : Fin N) (htop : (top : ℕ) + 1 = N)
    (H2 : ∀ (T : SYT lam) (k l : Fin N), (l : ℕ) = k + 1 → (T.pos k).1 ≠ (T.pos l).1 →
      (T.pos k).2 ≠ (T.pos l).2 → T.content l - T.content k ≠ 1 ∧ T.content l - T.content k ≠ -1)
    {T T' : SYT lam}
    (h : Relation.ReflTransGen
      (fun A B : SYT lam => ∃ k l : Fin N, (l : ℕ) = k + 1 ∧ (l : ℕ) < (top : ℕ) ∧ B.pos = A.pos ∘ Equiv.swap k l)
      T T') :
    unit b T' T ∈ subW Y lam top := by
  induction h with
  | refl => exact unit_self_mem Y b hb top htop T
  | @tail B C _ hBC ih =>
    obtain ⟨k, l, hkl, hl, hpos⟩ := hBC
    rw [← unit_mul_unit b C B T]
    exact Subalgebra.mul_mem _ (unit_swap_mem Y b hb top htop H2 hkl hl hpos) ih

omit [CharZero F] in
/-- (→): `ρ_λ(S_{N-1})` commutes with `ρ_λ(J_{N-1})`. -/
lemma commute_of_mem_span (lam : Shape N) (top : Fin N) (htop : (top : ℕ) + 1 = N)
    {X : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F}
    (hX : X ∈ Submodule.span F ((Y.rho lam : Perm (Fin N) → Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) '' stab top)) :
    X * Y.rhoAlg lam (jucysMurphy F top) = Y.rhoAlg lam (jucysMurphy F top) * X := by
  induction hX using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨σ, hσ, rfl⟩ := hx
    have h := congrArg (Y.rhoAlg lam) (perm_mul_jucysMurphy_top F σ top htop hσ)
    rwa [map_mul, map_mul, rhoAlg_perm Y] at h
  | zero => rw [Matrix.zero_mul, Matrix.mul_zero]
  | add x y _ _ hx hy => rw [Matrix.add_mul, Matrix.mul_add, hx, hy]
  | smul r x _ hx => rw [Matrix.smul_mul, Matrix.mul_smul, hx]

end YoungSystem

/-- **R1** (paper v1.02 lines 320-322, 397-399): the restriction fact, derived from the Young system's `youngBasis` field
and standard-tableau combinatorics. `H1` is the connectivity of standard tableaux under admissible swaps below `top`
(proved in Proofs/SytConnect.lean). -/
theorem restriction_of_young_of {F : Type*} [Field F] [CharZero F] {N : ℕ} (Y : YoungSystem F N)
    (H1 : ∀ (lam : Shape N) (top : Fin N), (top : ℕ) + 1 = N → ∀ T T' : SYT lam, T.pos top = T'.pos top →
      Relation.ReflTransGen
        (fun A B : SYT lam => ∃ k l : Fin N, (l : ℕ) = k + 1 ∧ (l : ℕ) < (top : ℕ) ∧ B.pos = A.pos ∘ Equiv.swap k l)
        T T')
    (lam : Shape N) (top : Fin N) (htop : (top : ℕ) + 1 = N) (X : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) :
    X ∈ Submodule.span F ((Y.rho lam : Perm (Fin N) → Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) '' stab top) ↔
      X * Y.rhoAlg lam (jucysMurphy F top) = Y.rhoAlg lam (jucysMurphy F top) * X := by
  classical
  constructor
  · exact YoungSystem.commute_of_mem_span Y lam top htop
  · intro hX
    obtain ⟨b, hb⟩ := Y.youngBasis lam
    have hb' : IsYoungBasis Y b := hb
    let _ : Fintype (SYT lam) := FiniteDimensional.fintypeBasisIndex b
    rw [← YoungSystem.toSubmodule_adjoin Y lam top, Subalgebra.mem_toSubmodule]
    change X ∈ YoungSystem.subW Y lam top
    rw [eq_sum_units b X]
    refine Subalgebra.sum_mem _ fun T _ => Subalgebra.sum_mem _ fun T' _ => ?_
    by_cases hc : coord b X T' T = 0
    · rw [hc, zero_smul]
      exact Subalgebra.zero_mem _
    · apply Subalgebra.smul_mem
      have hcont : T.content top = T'.content top := by
        have h1 : b.repr ((X * Y.rhoAlg lam (jucysMurphy F top)) *ᵥ b T) T' =
            b.repr ((Y.rhoAlg lam (jucysMurphy F top) * X) *ᵥ b T) T' := by rw [hX]
        rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hb' T top, Matrix.mulVec_smul, map_smul,
          Finsupp.smul_apply, smul_eq_mul, repr_jucysMurphy Y b hb' top] at h1
        have h2 : ((T.content top : ℤ) : F) = ((T'.content top : ℤ) : F) := mul_right_cancel₀ hc h1
        exact_mod_cast h2
      exact YoungSystem.unit_mem_of_chain Y b hb' top htop
        (fun T k l hkl hr hc => content_gap_ne_one T k l hkl hr hc)
        (H1 lam top htop T T' (pos_eq_of_content_top T T' top htop hcont))

/-- **R1**: for `top = N-1`, `span ρ_λ(S_{N-1})` is exactly the commutant of `ρ_λ(J_{N-1})` —
derived, with no hypothesis beyond the Young system (`youngBasis` field) and proved tableau combinatorics. -/
theorem restriction_of_young {F : Type*} [Field F] [CharZero F] {N : ℕ} (Y : YoungSystem F N)
    (lam : Shape N) (top : Fin N) (htop : (top : ℕ) + 1 = N) (X : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) :
    X ∈ Submodule.span F ((Y.rho lam : Perm (Fin N) → Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) '' stab top) ↔
      X * Y.rhoAlg lam (jucysMurphy F top) = Y.rhoAlg lam (jucysMurphy F top) * X :=
  restriction_of_young_of Y (fun _ top htop T T' h => syt_connected top htop T T' h) lam top htop X

end NagataHigman.Proofs

