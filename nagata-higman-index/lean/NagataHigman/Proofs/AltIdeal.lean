/-
NagataHigman/Proofs/AltIdeal.lean — P1, the block side of Proposition 2.1 (forward): (F4) the ideal I generated by
E = Σ_{π ∈ S_{n+1}} sgn(π) π is ⊕_{ℓ(λ) ≥ n+1} I_λ (paper v1.02 lines 199-204); I^⊥ ⊆ A; C_N ∩ A = C_N ∩ A' (v1.02 Remark 2.3 (cut in v1.03));
C_N ∩ A ⊆ B_n (step (7), lines 350-359).
Author: Dave Goel. Copyright (C) Dave Goel 2026--now.

Route (Young basis only). ρ_λ(E) ≠ 0 iff ℓ(λ) ≥ n+1: if ℓ(λ) ≥ n+1, the tableau with 0..n down the first column has
ρ(s) v_T = -v_T for every adjacent s below n+1 (diagonal entry -1; an off-diagonal entry would need a tableau with
column contents and two entries swapped, which does not exist), so ρ(E) v_T = |S_{n+1}| v_T ≠ 0. If ℓ(λ) ≤ n, every
J_k (k ≤ n) acts by -k on the image of ρ(E), and no tableau has contents -k at all k ≤ n, so ρ(E) = 0.
Then C9 (span_mul_mul_eq_blockSum) gives F4, C6 (rhoAlg_eq_zero_of_pairing) gives I^⊥ ⊆ A, and the sign twist
(ε = ±1 on C_N, ρ_μ(ε a) = 0 ↔ ρ_{μ'}(a) = 0, ℓ(μ') = μ_1) gives C_N ∩ A = C_N ∩ A'; with C10, C_N ∩ A ⊆ B_n.
Everything is for an ARBITRARY Young system `Y`.
-/
import NagataHigman.Proofs.BlocksOrth
import NagataHigman.Proofs.SignTwist
import NagataHigman.Proofs.BlockIdeal
import NagataHigman.Proofs.TwoCorner.Spectral
import NagataHigman.Proofs.Tableaux

noncomputable section

namespace NagataHigman.Proofs

open NagataHigman Equiv Finset Matrix

/-! ### Shapes and tableaux -/

section Tab

variable {N : ℕ}

/-- The conjugate's diagram is the transposed diagram. -/
lemma diagram_conjugate (lam : Shape N) : Shape.diagram lam.conjugate = lam.diagram.transpose := by
  simp [Shape.diagram, Nat.Partition.conjugate]

lemma lt_numRows_iff (lam : Shape N) (n : ℕ) : n < lam.numRows ↔ (n, 0) ∈ lam.diagram :=
  ⟨fun h => (YoungDiagram.mem_cells _).1 (mem_col0 h),
    fun h => lt_numRows_of_mem ((YoungDiagram.mem_cells _).2 h)⟩

lemma lt_firstRow_iff (lam : Shape N) (n : ℕ) : n < lam.firstRow ↔ (0, n) ∈ lam.diagram :=
  ⟨fun h => (YoungDiagram.mem_cells _).1 (mem_row0 h),
    fun h => lt_firstRow_of_mem ((YoungDiagram.mem_cells _).2 h)⟩

/-- `ℓ(λ') > n ↔ λ_1 > n`. -/
lemma lt_numRows_conjugate_iff (lam : Shape N) (n : ℕ) :
    n < Shape.numRows lam.conjugate ↔ n < lam.firstRow := by
  rw [lt_numRows_iff, lt_firstRow_iff, diagram_conjugate, YoungDiagram.mem_transpose]
  rfl

/-- No standard tableau has contents `0, -1, …, -(a-1)` at `0, …, a-1` and content `-(a+1)` at `a`. -/
lemma col_contents_swap_impossible {lam : Shape N} (U : SYT lam) (a : Fin N)
    (hlow : ∀ m : Fin N, (m : ℕ) < a → U.content m = -(m : ℤ)) (ha : U.content a = -(a : ℤ) - 1) : False := by
  have hij : ((U.pos a).2 : ℤ) - ((U.pos a).1 : ℤ) = -(a : ℤ) - 1 := ha
  obtain ⟨m, hm, hma⟩ := exists_le_of_le U (k := a) (c := ((U.pos a).1 - 1, (U.pos a).2))
    (by dsimp only; omega) le_rfl
  have hne : m ≠ a := by
    rintro rfl
    have h1 := congrArg Prod.fst hm
    dsimp only at h1
    omega
  have hlt : (m : ℕ) < a := lt_of_le_of_ne (Fin.le_def.1 hma) (fun h => hne (Fin.ext h))
  have hcol := pos_eq_col_of_content U ((a : ℕ) - 1) (fun k hk => hlow k (by omega)) m (by omega)
  rw [hm, Prod.mk.injEq] at hcol
  omega

end Tab

namespace YoungSystem

variable {F : Type*} [Field F] {N : ℕ} (Y : YoungSystem F N)

lemma rhoAlg_altSum (lam : Shape N) (X : Finset (Fin N)) :
    Y.rhoAlg lam (altSum F X) =
      ∑ π ∈ univ.filter (fun π : Perm (Fin N) => π.support ⊆ X), ((Perm.sign π : ℤ) : F) • Y.rho lam π := by
  unfold altSum
  rw [map_sum]
  refine Finset.sum_congr rfl fun π _ => ?_
  rw [map_smul, rhoAlg_perm Y]

/-- P1a (⇐): if `ℓ(λ) ≥ n+1` then `ρ_λ(E) ≠ 0`. -/
theorem rhoAlg_altGen_ne_zero_of_rows [CharZero F] (lam : Shape N) (n : ℕ) (hrows : n + 1 ≤ lam.numRows) :
    Y.rhoAlg lam (altGen F N n) ≠ 0 := by
  classical
  obtain ⟨b, hb⟩ := Y.youngBasis lam
  have hb' : IsYoungBasis Y b := hb
  obtain ⟨T, hT⟩ := exists_col_tableau lam n hrows
  have hcT : ∀ k : Fin N, (k : ℕ) ≤ n → T.content k = -(k : ℤ) := by
    intro k hk
    simp [SYT.content, hT k hk]
  have hs : ∀ a c : Fin N, (c : ℕ) = a + 1 → (c : ℕ) ≤ n → Y.rho lam (swap a c) *ᵥ b T = -b T := by
    intro a c hac hcn
    apply b.ext_elem
    intro U
    rw [map_neg, Finsupp.neg_apply, b.repr_self, Finsupp.single_apply]
    by_cases hU : T = U
    · subst hU
      rw [ite_eq_left rfl]
      obtain ⟨_, hd⟩ := R_diag_general Y b hb' T a c hac
      have hdiff : T.content c - T.content a = -1 := by
        rw [hcT c hcn, hcT a (by omega)]
        push_cast [hac]
        ring
      rw [hd, hdiff]
      norm_num
    · rw [ite_eq_right hU, neg_zero]
      by_contra hne
      obtain ⟨hoff, hsw⟩ := R_support_contents Y b hb' T U a c hac hne
      rcases hsw with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · apply hU
        apply syt_eq_of_content_eq
        intro i
        by_cases hia : i = a
        · subst hia
          exact h1.symm
        by_cases hic : i = c
        · subst hic
          exact h2.symm
        exact (hoff i hia hic).symm
      · apply col_contents_swap_impossible U a
        · intro m hm
          have hma : m ≠ a := fun e => by rw [e] at hm; omega
          have hmc : m ≠ c := fun e => by rw [e] at hm; omega
          rw [hoff m hma hmc, hcT m (by omega)]
        · rw [h1, hcT c hcn]
          push_cast [hac]
          ring
  have hsign := fun π hπ => rho_mulVec_eq_sign (Y.rho lam) (b T) n hs π hπ
  set S := univ.filter (fun π : Perm (Fin N) => π.support ⊆ univ.filter (fun i : Fin N => (i : ℕ) ≤ n))
  have hE : Y.rhoAlg lam (altGen F N n) *ᵥ b T = ∑ _π ∈ S, b T := by
    rw [altGen, rhoAlg_altSum, Matrix.sum_mulVec]
    refine Finset.sum_congr rfl fun π hπ => ?_
    rw [Matrix.smul_mulVec, hsign π (Finset.mem_filter.1 hπ).2, smul_smul, sign_mul_sign, one_smul]
  have hcard : (S.card : F) ≠ 0 := by
    apply Nat.cast_ne_zero.2
    apply Finset.card_ne_zero_of_mem (a := 1)
    simp [S]
  intro h0
  rw [h0, Matrix.zero_mulVec, Finset.sum_const, ← Nat.cast_smul_eq_nsmul F] at hE
  exact b.ne_zero T ((smul_eq_zero.1 hE.symm).resolve_left hcard)

/-- P1a (⇒): if `ℓ(λ) ≤ n < N` then `ρ_λ(E) = 0`. -/
theorem rhoAlg_altGen_eq_zero_of_rows [CharZero F] (lam : Shape N) (n : ℕ) (h : n + 1 ≤ N)
    (hrows : lam.numRows ≤ n) : Y.rhoAlg lam (altGen F N n) = 0 := by
  classical
  obtain ⟨b, hb⟩ := Y.youngBasis lam
  have hb' : IsYoungBasis Y b := hb
  set E := Y.rhoAlg lam (altGen F N n) with hE_def
  have hσE : ∀ σ : Perm (Fin N), σ.support ⊆ univ.filter (fun i : Fin N => (i : ℕ) ≤ n) →
      Y.rho lam σ * E = ((Perm.sign σ : ℤ) : F) • E := by
    intro σ hσ
    have h1 := congrArg (Y.rhoAlg lam) (perm_mul_altSum F _ σ hσ)
    rwa [map_mul, rhoAlg_perm Y, map_smul] at h1
  have hJ : ∀ k : Fin N, (k : ℕ) ≤ n → Y.rhoAlg lam (jucysMurphy F k) * E = (-((k : ℕ) : F)) • E := by
    intro k hk
    unfold jucysMurphy
    rw [map_sum, Finset.sum_mul]
    have hterm : ∀ i ∈ univ.filter (fun i : Fin N => i < k),
        Y.rhoAlg lam (perm F (swap i k)) * E = (-1 : F) • E := by
      intro i hi
      have hik : i < k := (Finset.mem_filter.1 hi).2
      rw [rhoAlg_perm Y, hσE (swap i k) (support_swap_subset_altGen n i k hik hk),
        Perm.sign_swap (ne_of_lt hik)]
      simp
    rw [Finset.sum_congr rfl hterm, Finset.sum_const, card_filter_lt, ← Nat.cast_smul_eq_nsmul F, smul_smul,
      mul_neg_one]
  have hw : ∀ v : Fin (Y.dim lam) → F, E *ᵥ v = 0 := by
    intro v
    apply b.ext_elem
    intro T
    rw [map_zero, Finsupp.zero_apply]
    by_contra hne
    apply not_col_content_of_numRows_le T n (by omega) hrows
    intro k hk
    have h1 := congrArg (fun A => b.repr (A *ᵥ v) T) (hJ k hk)
    simp only [← Matrix.mulVec_mulVec, repr_jucysMurphy Y b hb' k, Matrix.smul_mulVec, map_smul,
      Finsupp.smul_apply, smul_eq_mul] at h1
    have h2 : ((T.content k : ℤ) : F) = -((k : ℕ) : F) := mul_right_cancel₀ hne h1
    exact_mod_cast h2
  exact Matrix.ext_of_mulVec_single fun j => by rw [hw, Matrix.zero_mulVec]

/-- **P1a**: `ρ_λ(E) ≠ 0 ↔ ℓ(λ) ≥ n+1` (for `n + 1 ≤ N`). -/
theorem rhoAlg_altGen_ne_zero_iff [CharZero F] (lam : Shape N) (n : ℕ) (h : n + 1 ≤ N) :
    Y.rhoAlg lam (altGen F N n) ≠ 0 ↔ n + 1 ≤ lam.numRows := by
  constructor
  · intro hne
    by_contra hlt
    exact hne (rhoAlg_altGen_eq_zero_of_rows Y lam n h (by omega))
  · exact rhoAlg_altGen_ne_zero_of_rows Y lam n

/-- **P1b = (F4)** (v1.02 lines 201-204): `I = ⊕_{ℓ(λ) ≥ n+1} I_λ`. -/
theorem altIdeal_eq_blockSum [CharZero F] (n : ℕ) (h : n + 1 ≤ N) :
    altIdeal F N n = Y.blockSum {lam | n + 1 ≤ lam.numRows} := by
  unfold altIdeal
  rw [span_mul_mul_eq_blockSum Y]
  congr 1
  ext lam
  exact rhoAlg_altGen_ne_zero_iff Y lam n h

/-- **P1c** (step (7)): `I^⊥ ⊆ A = ⊕_{ℓ(λ) ≤ n} I_λ`. -/
theorem mem_rowSum_of_perp_altIdeal [CharZero F] (n : ℕ) (_h : n + 1 ≤ N) (f : GrpAlg F N)
    (hf : ∀ a ∈ altIdeal F N n, coeffPairing F f a = 0) : f ∈ Y.rowSum n := by
  unfold NagataHigman.YoungSystem.rowSum
  rw [mem_blockSum_iff Y]
  intro mu hmu
  simp only [Set.mem_ofPred_eq, not_le] at hmu
  apply rhoAlg_eq_zero_of_pairing Y (altGen F N n) f
  · intro g k
    exact hf _ (Submodule.subset_span ⟨g, k, rfl⟩)
  · exact rhoAlg_altGen_ne_zero_of_rows Y mu n (by omega)

/-- On `C_N`, `ρ_μ(c) = 0 ↔ ρ_{μ'}(c) = 0` (ε is the scalar `±1` on `C_N`). -/
lemma rhoAlg_eq_zero_iff_conjugate {c : GrpAlg F N} (hc : c ∈ cycleSpan F N) (mu : Shape N) :
    Y.rhoAlg mu c = 0 ↔ Y.rhoAlg mu.conjugate c = 0 := by
  rw [← rhoAlg_signTwist_eq_zero_iff Y mu c, signTwist_of_mem_cycleSpan hc, map_smul, smul_eq_zero]
  have hs : ((-1 : F) ^ (N - 1)) ≠ 0 := pow_ne_zero _ (neg_ne_zero.2 one_ne_zero)
  simp [hs]

/-- **P1d = v1.02 Remark 2.3 (cut in v1.03)** (v1.02 lines 301-305): `C_N ∩ A = C_N ∩ A'`. -/
theorem cycleSpan_inf_rowSum_eq_colSum (n : ℕ) :
    cycleSpan F N ⊓ Y.rowSum n = cycleSpan F N ⊓ Y.colSum n := by
  ext c
  simp only [Submodule.mem_inf]
  unfold NagataHigman.YoungSystem.rowSum NagataHigman.YoungSystem.colSum
  rw [mem_blockSum_iff Y, mem_blockSum_iff Y]
  simp only [Set.mem_ofPred_eq, not_le]
  constructor
  · rintro ⟨hc, h⟩
    refine ⟨hc, fun mu hmu => ?_⟩
    exact (rhoAlg_eq_zero_iff_conjugate Y hc mu).2 (h mu.conjugate ((lt_numRows_conjugate_iff mu n).2 hmu))
  · rintro ⟨hc, h⟩
    refine ⟨hc, fun mu hmu => ?_⟩
    have hmu' : n < Shape.firstRow mu.conjugate := by
      rw [← lt_numRows_conjugate_iff, Nat.Partition.conjugate_conjugate]
      exact hmu
    exact (rhoAlg_eq_zero_iff_conjugate Y hc mu).2 (h _ hmu')

/-- **P1e** (step (7)): `C_N ∩ A ⊆ B_n`. -/
theorem cycleSpan_inf_rowSum_le_boxSum (n : ℕ) : cycleSpan F N ⊓ Y.rowSum n ≤ Y.boxSum n := by
  intro c hc
  have h2 : c ∈ cycleSpan F N ⊓ Y.colSum n := by
    rw [← cycleSpan_inf_rowSum_eq_colSum]
    exact hc
  rw [← rowSum_inf_colSum Y n]
  exact Submodule.mem_inf.2 ⟨(Submodule.mem_inf.1 hc).2, (Submodule.mem_inf.1 h2).2⟩

end YoungSystem

end NagataHigman.Proofs

end
