/-
NagataHigman/Proofs/BlockIdeal.lean — the two-sided ideal generated by one element is a sum of blocks (target C9),
and `A ∩ A' = B_n` (target C10; paper line 261-262).
Author: Dave Goel. Copyright (C) Dave Goel 2026--now.

Everything is for an ARBITRARY Young system `Y`. Imports: Mathlib + Defs + Proofs.Blocks only.
-/
import NagataHigman.Proofs.Blocks

noncomputable section

namespace NagataHigman.Proofs

open NagataHigman Equiv Finset Matrix

variable {F : Type*} [Field F] {N : ℕ}

namespace YoungSystem

variable (Y : YoungSystem F N)

/-- `g x h` lies in `I_λ` when `g` does. -/
lemma mul_mul_mem_block {lam : Shape N} {g : GrpAlg F N} (hg : g ∈ Y.block lam) (x h : GrpAlg F N) :
    g * x * h ∈ Y.block lam := by
  rw [mem_block_iff Y]
  intro mu hmu
  rw [map_mul, map_mul, (mem_block_iff Y).1 hg mu hmu, Matrix.zero_mul, Matrix.zero_mul]

/-- C9: the two-sided ideal `span {g x h}` generated by `x` is `⊕ I_λ` over the `λ` with `ρ_λ(x) ≠ 0`. -/
theorem span_mul_mul_eq_blockSum (x : GrpAlg F N) :
    Submodule.span F {y | ∃ g h : GrpAlg F N, y = g * x * h} = Y.blockSum {lam | Y.rhoAlg lam x ≠ 0} := by
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro y ⟨g, h, rfl⟩
    rw [SetLike.mem_coe, mem_blockSum_iff Y]
    intro mu hmu
    simp only [Set.mem_ofPred_eq, not_not] at hmu
    rw [map_mul, map_mul, hmu, Matrix.mul_zero, Matrix.zero_mul]
  · unfold NagataHigman.YoungSystem.blockSum
    apply iSup₂_le
    intro lam hlam a ha
    simp only [Set.mem_ofPred_eq] at hlam
    obtain ⟨k, l, hkl⟩ : ∃ k l, Y.rhoAlg lam x k l ≠ 0 := by
      by_contra hc
      simp only [not_exists, not_not] at hc
      exact hlam (Matrix.ext fun i j => by simpa using hc i j)
    set X := Y.rhoAlg lam x with hX
    set M := Y.rhoAlg lam a with hM
    choose g hg hgρ using fun i j : Fin (Y.dim lam) =>
      exists_mem_block Y lam (Matrix.single i k (M i j / X k l))
    choose h hh hhρ using fun j : Fin (Y.dim lam) => exists_mem_block Y lam (Matrix.single l j (1 : F))
    set y := ∑ i, ∑ j, g i j * x * h j with hy
    have hy_span : y ∈ Submodule.span F {y | ∃ g h : GrpAlg F N, y = g * x * h} :=
      Submodule.sum_mem _ fun i _ => Submodule.sum_mem _ fun j _ =>
        Submodule.subset_span ⟨g i j, h j, rfl⟩
    have hy_block : y ∈ Y.block lam :=
      Submodule.sum_mem _ fun i _ => Submodule.sum_mem _ fun j _ => mul_mul_mem_block Y (hg i j) x (h j)
    have hy_rho : Y.rhoAlg lam y = M := by
      rw [hy, map_sum]
      conv_rhs => rw [Matrix.matrix_eq_sum_single M]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, map_mul, hgρ, hhρ, ← hX, Matrix.single_mul_mul_single, mul_one, div_mul_cancel₀ _ hkl]
    have hay : a = y := eq_of_mem_block Y ha hy_block (by rw [hy_rho])
    rw [hay]
    exact hy_span

/-- C10 (paper lines 261-262): `A ∩ A' = B_n`, i.e. `rowSum n ⊓ colSum n = boxSum n`. -/
theorem rowSum_inf_colSum (n : ℕ) : Y.rowSum n ⊓ Y.colSum n = Y.boxSum n := by
  ext a
  rw [Submodule.mem_inf]
  unfold NagataHigman.YoungSystem.rowSum NagataHigman.YoungSystem.colSum NagataHigman.YoungSystem.boxSum
  rw [mem_blockSum_iff Y, mem_blockSum_iff Y, mem_blockSum_iff Y]
  simp only [Set.mem_ofPred_eq, NagataHigman.Shape.InBox]
  constructor
  · rintro ⟨h1, h2⟩ mu hmu
    rw [not_and_or] at hmu
    rcases hmu with h | h
    · exact h1 mu h
    · exact h2 mu h
  · intro h
    exact ⟨fun mu hmu => h mu fun hh => hmu hh.1, fun mu hmu => h mu fun hh => hmu hh.2⟩

end YoungSystem

end NagataHigman.Proofs

end
