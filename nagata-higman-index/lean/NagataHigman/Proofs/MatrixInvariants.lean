/-
NagataHigman/Proofs/MatrixInvariants.lean — Corollary 1.1 (short v1.10, l. 149-152) from Theorem B and the cited
theorem of Procesi and Formanek, by base change to a field `K ⊇ F` where the cited theorem is stated.
Author: Dave Goel. Copyright (C) Dave Goel 2026--now.

Proof. (⊇) Each `tr(x_{i_1} ⋯ x_{i_r})` is invariant: `∏ (g X_i g⁻¹) = g (∏ X_i) g⁻¹` and the trace is invariant under
conjugation; invariants are closed under sums, products and scalars. (⊆) An invariant `p` over `F` stays invariant over
`K` (MatInvDensity.lean); there it is a `K`-polynomial in the traces of degree `≤ m` (the cited theorem); the traces
have integer coefficients, so `p` is already an `F`-polynomial in them (MatInvDescent.lean).
-/
import NagataHigman.Defs.MatrixInvariants
import NagataHigman.Proofs.MatInvDensity
import NagataHigman.Proofs.MatInvDescent

noncomputable section

namespace NagataHigman.Proofs

open NagataHigman

variable {F : Type*} [Field F] {n k : ℕ}

/-- Evaluating the generic matrix `x_i` at a tuple `X` gives `X_i`. -/
theorem eval_genericMatrix (X : Fin k → Matrix (Fin n) (Fin n) F) (i : Fin k) :
    (MvPolynomial.eval (tupleCoords X)).mapMatrix (genericMatrix F n k i) = X i := by
  ext a b
  simp [genericMatrix, tupleCoords]

/-- The polynomial `tr(x_{i_1} ⋯ x_{i_r})` evaluates to `tr(X_{i_1} ⋯ X_{i_r})`. -/
theorem eval_tracePoly (X : Fin k → Matrix (Fin n) (Fin n) F) (w : List (Fin k)) :
    MvPolynomial.eval (tupleCoords X) (tracePoly F n k w) = Matrix.trace (w.map X).prod := by
  have hmap : (MvPolynomial.eval (tupleCoords X)).mapMatrix (w.map (genericMatrix F n k)).prod =
      (w.map X).prod := by
    rw [map_list_prod, List.map_map]
    congr 1
    exact List.map_congr_left fun i _ => eval_genericMatrix X i
  rw [tracePoly, ← hmap]
  simp [Matrix.trace, map_sum]

/-- `∏ (g A_j g⁻¹) = g (∏ A_j) g⁻¹`. -/
theorem list_prod_conj (g : GL (Fin n) F) (L : List (Matrix (Fin n) (Fin n) F)) :
    (L.map fun A => (g : Matrix (Fin n) (Fin n) F) * A * ((g⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F)).prod =
      (g : Matrix (Fin n) (Fin n) F) * L.prod * ((g⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) := by
  induction L with
  | nil => simp
  | cons A L ih =>
    rw [List.map_cons, List.prod_cons, ih, List.prod_cons]
    have hinv : ((g⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) * (g : Matrix (Fin n) (Fin n) F) = 1 := by
      rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
    calc (g : Matrix (Fin n) (Fin n) F) * A * ((g⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *
          ((g : Matrix (Fin n) (Fin n) F) * L.prod * ((g⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F))
        = (g : Matrix (Fin n) (Fin n) F) * A *
            (((g⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) * (g : Matrix (Fin n) (Fin n) F)) * L.prod *
            ((g⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) := by simp only [mul_assoc]
      _ = _ := by rw [hinv, mul_one, mul_assoc (g : Matrix (Fin n) (Fin n) F) A]

/-- **Corollary 1.1, the easy inclusion**: every trace `tr(X_{i_1} ⋯ X_{i_r})` is invariant under simultaneous
conjugation. -/
theorem tracePoly_isConjInvariant (w : List (Fin k)) : IsConjInvariant (tracePoly F n k w) := by
  intro g X
  have hL : w.map (fun i => (g : Matrix (Fin n) (Fin n) F) * X i * ((g⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F)) =
      (w.map X).map fun A => (g : Matrix (Fin n) (Fin n) F) * A *
        ((g⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) := by
    rw [List.map_map]
    rfl
  rw [eval_tracePoly, eval_tracePoly, hL, list_prod_conj, Matrix.trace_mul_comm, ← mul_assoc]
  have hinv : ((g⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) * (g : Matrix (Fin n) (Fin n) F) = 1 := by
    rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
  rw [hinv, one_mul]

/-- Invariants are closed under the algebra operations, so everything generated by the traces is invariant. -/
theorem isConjInvariant_of_mem_adjoin {m : ℕ} {p : MatPoly F n k}
    (hp : p ∈ Algebra.adjoin F (tracePolys F n k m)) : IsConjInvariant p := by
  induction hp using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨w, -, -, rfl⟩ := hx
    exact tracePoly_isConjInvariant w
  | algebraMap r =>
    intro g X
    simp [MvPolynomial.algebraMap_eq]
  | add x y _ _ hx hy =>
    intro g X
    rw [map_add, map_add, hx g X, hy g X]
  | mul x y _ _ hx hy =>
    intro g X
    rw [map_mul, map_mul, hx g X, hy g X]

/-- The traces have integer coefficients: `tr(x_{i_1} ⋯ x_{i_r})` over `F`, read over `K`, is the same trace over
`K`. -/
theorem map_tracePoly {K : Type*} [Field K] [Algebra F K] (w : List (Fin k)) :
    MvPolynomial.map (algebraMap F K) (tracePoly F n k w) = tracePoly K n k w := by
  have hgen : ∀ i, (MvPolynomial.map (algebraMap F K)).mapMatrix (genericMatrix F n k i) =
      genericMatrix K n k i := fun i => by
    ext a b
    simp [genericMatrix]
  have hmap : (MvPolynomial.map (algebraMap F K)).mapMatrix (w.map (genericMatrix F n k)).prod =
      (w.map (genericMatrix K n k)).prod := by
    rw [map_list_prod, List.map_map]
    congr 1
    exact List.map_congr_left fun i _ => hgen i
  rw [tracePoly, tracePoly, ← hmap]
  simp [Matrix.trace, map_sum]

/-- The set of traces of degree `1 ≤ r ≤ m` over `K` is the image of the one over `F`. -/
theorem tracePolys_map {K : Type*} [Field K] [Algebra F K] (m : ℕ) :
    tracePolys K n k m = MvPolynomial.map (algebraMap F K) '' tracePolys F n k m := by
  ext p
  constructor
  · rintro ⟨w, h1, h2, rfl⟩
    exact ⟨tracePoly F n k w, ⟨w, h1, h2, rfl⟩, map_tracePoly w⟩
  · rintro ⟨q, ⟨w, h1, h2, rfl⟩, rfl⟩
    exact ⟨w, h1, h2, (map_tracePoly w).symm⟩

/-- **Corollary 1.1 from the cited theorem over an extension field `K`**: if, over `K`, the invariants are generated by
the traces of degree `1 ≤ r ≤ m`, then so they are over `F` (characteristic 0). -/
theorem matInvariants_eq_adjoin_of_ext [CharZero F] {K : Type*} [Field K] [Algebra F K] (m : ℕ)
    (hK : matInvariants K n k ⊆ (Algebra.adjoin K (tracePolys K n k m) : Set (MatPoly K n k))) :
    matInvariants F n k = (Algebra.adjoin F (tracePolys F n k m) : Set (MatPoly F n k)) := by
  apply Set.Subset.antisymm
  · intro p hp
    have hpK := hK (MatInvDensity.isConjInvariant_map (K := K) hp)
    rw [tracePolys_map (F := F)] at hpK
    exact MatInvDescent.mem_adjoin_of_map_mem _ p hpK
  · intro p hp
    exact isConjInvariant_of_mem_adjoin hp

/-- Over an infinite field a polynomial is determined by its function on `k`-tuples of `n × n` matrices, so the
polynomials `MatPoly F n k` ARE the polynomial functions of Corollary 1.1. -/
theorem matPoly_eval_injective [Infinite F] :
    Function.Injective fun (p : MatPoly F n k) (X : Fin k → Matrix (Fin n) (Fin n) F) =>
      MvPolynomial.eval (tupleCoords X) p := by
  intro p q h
  apply MvPolynomial.funext
  intro x
  have hx := congrFun h (fun i a b => x (i, a, b))
  have hc : tupleCoords (fun (i : Fin k) (a b : Fin n) => x (i, a, b)) = x := by
    funext v
    rfl
  simpa only [hc] using hx

end NagataHigman.Proofs

end
