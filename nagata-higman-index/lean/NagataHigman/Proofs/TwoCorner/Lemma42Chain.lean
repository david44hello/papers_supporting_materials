/-
NagataHigman/Proofs/TwoCorner/Lemma42Chain.lean — Lemma 4.2 along the paper's own chain (a) → (e) (tex 453-481):
step (b), step (e) "the stars generate End(S^ν)", and Lemma 4.2 itself derived from (e).
Author: Dave Goel. Copyright (C) Dave Goel 2026--now.

(b) is Lemma42.starElem_eq_jucysMurphy_add. (e), the paper's route: by (d) (`lem_4_2_d_nu`), `ρ(s) ∈ 𝒴` for
`s = (N-2 N-1)`; conjugation by `ρ(g)` maps `𝒴` into itself, since it sends `Y_j` to `Y_{g j}`; every transposition is
a conjugate of `s`, so `ρ(t) ∈ 𝒴`; transpositions generate `S_N` as a monoid, so `ρ(σ) ∈ 𝒴` for every `σ`; and
`ρ(F[S_N]) = End(S^ν)` (F6, `rhoAlg_surjective`), so `𝒴 = ⊤`. Lemma 4.2: a matrix commuting with every `Y_j`
commutes with `𝒴 = ⊤`, hence with every matrix unit, so it is a scalar.
-/
import NagataHigman.Proofs.TwoCorner.Lemma42Steps

noncomputable section

namespace NagataHigman.Proofs

open Equiv Finset Matrix NagataHigman

variable {F : Type*} [Field F]

/-- **Lemma 4.2 (b)** (tex 462): `X^{(k)} = J_k + (k, top)` for `k + 1 = top`, `top + 1 = N`. -/
theorem lem_4_2_b_proved (N : ℕ) (k top : Fin N) (hk : (k : ℕ) + 1 = top) (htop : (top : ℕ) + 1 = N) :
    starElem F k = jucysMurphy F k + perm F (swap k top) :=
  starElem_eq_jucysMurphy_add k top hk htop

/-- Conjugation by `ρ(g)` maps the algebra generated by the stars into itself (it sends `Y_j` to `Y_{g j}`). -/
theorem conj_mem_adjoin_stars {N : ℕ} (Y : YoungSystem F N) (lam : Shape N) (g : Perm (Fin N))
    {M : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F}
    (hM : M ∈ Algebra.adjoin F (Set.range fun j => Y.rhoAlg lam (starElem F j))) :
    Y.rho lam g * M * Y.rho lam g⁻¹ ∈ Algebra.adjoin F (Set.range fun j => Y.rhoAlg lam (starElem F j)) := by
  have hg : Y.rho lam g⁻¹ * Y.rho lam g = 1 := by rw [← map_mul, inv_mul_cancel, map_one]
  induction hM using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨j, rfl⟩ := hx
    apply Algebra.subset_adjoin
    refine ⟨g j, ?_⟩
    simp only
    rw [← perm_conj_starElem F g j, map_mul, map_mul, rhoAlg_perm Y, rhoAlg_perm Y]
  | algebraMap r =>
    rw [Algebra.algebraMap_eq_smul_one, Matrix.mul_smul, Matrix.mul_one, Matrix.smul_mul, ← map_mul, mul_inv_cancel,
      map_one]
    exact Subalgebra.smul_mem _ (one_mem _) r
  | add x y _ _ hx hy =>
    rw [Matrix.mul_add, Matrix.add_mul]
    exact add_mem hx hy
  | mul x y _ _ hx hy =>
    have h : Y.rho lam g * (x * y) * Y.rho lam g⁻¹ =
        Y.rho lam g * x * Y.rho lam g⁻¹ * (Y.rho lam g * y * Y.rho lam g⁻¹) := by
      simp only [mul_assoc]
      rw [← mul_assoc (Y.rho lam g⁻¹) (Y.rho lam g), hg, one_mul]
    rw [h]
    exact mul_mem hx hy

/-- **Lemma 4.2 (e)** (tex 480-481): on `ν` the stars generate all of `End(S^ν)`: `𝒴 = ⊤`. -/
theorem lem_4_2_e_proved [CharZero F] (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1))
    (lam : Shape (n ^ 2 - 1)) (hlam : lam.InBox n) :
    Algebra.adjoin F (Set.range fun j => Y.rhoAlg lam (starElem F j)) = ⊤ := by
  have h4 : 4 ≤ n ^ 2 := by nlinarith
  let top : Fin (n ^ 2 - 1) := ⟨n ^ 2 - 2, by omega⟩
  let k : Fin (n ^ 2 - 1) := ⟨n ^ 2 - 3, by omega⟩
  have htop : (top : ℕ) + 1 = n ^ 2 - 1 := by simp only [top]; omega
  have hk2 : (k : ℕ) + 2 = n ^ 2 - 1 := by simp only [k]; omega
  have hkt : k ≠ top := by
    intro h
    rw [Fin.ext_iff] at h
    simp only [k, top] at h
    omega
  -- (d): `ρ(s) ∈ 𝒴`
  have hs := (lem_4_2_d_nu n hn Y lam hlam top k htop hk2).2.2.2.2
  -- (e): every transposition, by conjugation
  have hswap : ∀ σ : Perm (Fin (n ^ 2 - 1)), σ.IsSwap →
      Y.rho lam σ ∈ Algebra.adjoin F (Set.range fun j => Y.rhoAlg lam (starElem F j)) := by
    rintro σ ⟨x, y, hxy, rfl⟩
    obtain ⟨g, hg⟩ := isConj_iff.1 (Equiv.Perm.isConj_swap hkt hxy)
    rw [← hg, map_mul, map_mul]
    exact conj_mem_adjoin_stars Y lam g hs
  -- every permutation (transpositions generate `S_N` as a monoid)
  have hperm : ∀ σ : Perm (Fin (n ^ 2 - 1)),
      Y.rho lam σ ∈ Algebra.adjoin F (Set.range fun j => Y.rhoAlg lam (starElem F j)) := by
    intro σ
    have hmem : σ ∈ Submonoid.closure {σ : Perm (Fin (n ^ 2 - 1)) | σ.IsSwap} := by
      rw [Equiv.Perm.mclosure_isSwap]
      exact Submonoid.mem_top σ
    induction hmem using Submonoid.closure_induction with
    | mem x hx => exact hswap x hx
    | one => rw [map_one]; exact one_mem _
    | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
  -- (F6): `ρ(F[S_N]) = End(S^ν)`
  rw [eq_top_iff]
  rintro M -
  obtain ⟨a, rfl⟩ := YoungSystem.rhoAlg_surjective Y lam M
  induction a using MonoidAlgebra.induction_on with
  | of g =>
    have h : Y.rhoAlg lam (MonoidAlgebra.of F _ g) = Y.rho lam g := rhoAlg_perm Y lam g
    rw [h]
    exact hperm g
  | add x y hx hy => rw [map_add]; exact add_mem hx hy
  | smul r x hx => rw [map_smul]; exact Subalgebra.smul_mem _ hx r

/-- **Lemma 4.2** (tex 453-455), derived along the paper's chain: from (e), a matrix commuting with every `Y_j`
commutes with all of `End(S^ν)`, so it is a scalar. Same statement as `lem_4_2_general`. -/
theorem lem_4_2_general_chain [CharZero F] (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1))
    (lam : Shape (n ^ 2 - 1)) (hlam : lam.InBox n) (Z : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F)
    (hZ : ∀ j : Fin (n ^ 2 - 1), Z * Y.rhoAlg lam (starElem F j) = Y.rhoAlg lam (starElem F j) * Z) :
    ∃ c : F, Z = c • 1 := by
  have hcent : Algebra.adjoin F (Set.range fun j => Y.rhoAlg lam (starElem F j)) ≤
      Subalgebra.centralizer F {Z} := by
    rw [Algebra.adjoin_le_iff]
    rintro _ ⟨j, rfl⟩
    rw [SetLike.mem_coe, Subalgebra.mem_centralizer_iff]
    intro g hg
    rw [Set.mem_singleton_iff.1 hg]
    exact hZ j
  rw [lem_4_2_e_proved n hn Y lam hlam] at hcent
  have hall : ∀ M : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F, Z * M = M * Z := fun M =>
    (Subalgebra.mem_centralizer_iff F).1 (hcent Algebra.mem_top) Z rfl
  obtain ⟨c, hc⟩ := Matrix.mem_range_scalar_of_commute_single fun i j _ => (hall _).symm
  exact ⟨c, by rw [← hc, Matrix.scalar_apply, Matrix.smul_one_eq_diagonal]⟩

end NagataHigman.Proofs

end
