/-- **Proposition 2.1, step (6), example** (lines 341-342): `Φ⁻¹P(τE_K) = x_1x_2x_3x_4 + x_1x_4x_2x_3 =
x_1 · L(x_2x_3, x_4)` (Lean, 0-indexed: `P(τ E_K) = Φ(x_0x_1x_2x_3) + Φ(x_0x_3x_1x_2)` and
`x_0x_1x_2x_3 + x_0x_3x_1x_2 = x_0 · L(x_1x_2, x_3)`). -/
theorem prop_2_1_step6_example_sum :
    cycleProj F 5 (perm F (wordCycle (1 : Perm (Fin 4))) * altSum F {0, 2, 3}) =
        perm F (wordCycle (1 : Perm (Fin 4))) +
          perm F (wordCycle (⟨![0, 3, 1, 2], ![0, 2, 3, 1], by decide, by decide⟩ : Perm (Fin 4))) ∧
      multilinWord F (1 : Perm (Fin 4)) +
          multilinWord F (⟨![0, 3, 1, 2], ![0, 2, 3, 1], by decide, by decide⟩ : Perm (Fin 4)) =
        sandwichElem F [0] ![[1, 2], [3]] [] := by
  exact ⟨NagataHigman.Proofs.Examples.ex_step6_sum F, NagataHigman.Proofs.Examples.ex_step6_word F⟩

/-- **Proposition 2.1, step (7)** (lines 353-354): `I^⊥ = A`. -/
theorem prop_2_1_step7_perp (N n : ℕ) (Y : YoungSystem F N) (h : n + 1 ≤ N) (f : GrpAlg F N) :
    (∀ a ∈ altIdeal F N n, coeffPairing F f a = 0) ↔ f ∈ Y.rowSum n := by
  exact NagataHigman.Proofs.prop21_step7_perp Y n h f

/-- **Proposition 2.1, step (7)** (lines 354-355): `C_N ∩ A = C_N ∩ B_n`. -/
theorem prop_2_1_step7_box (N n : ℕ) (Y : YoungSystem F N) :
    cycleSpan F N ⊓ Y.rowSum n = cycleSpan F N ⊓ Y.boxSum n := by
  exact NagataHigman.Proofs.prop21_step7_box Y n

/-- **Proposition 2.1, step (7)** (lines 351-355), its conclusion: `C_N ∩ Φ(W_{n,m})^⊥ = C_N ∩ B_n`. -/
theorem prop_2_1_step7_dual (n m : ℕ) (hn : 1 ≤ n) (hnm : n ≤ m) (Y : YoungSystem F (m + 1)) (c : GrpAlg F (m + 1))
    (hc : c ∈ cycleSpan F (m + 1)) :
    (∀ x ∈ ((multilinIdentities F n m).comap (wordLin F m)).map (cycleLin F m), coeffPairing F c x = 0) ↔
      c ∈ Y.boxSum n := by
  exact NagataHigman.Proofs.prop21_step7_dual n m hn hnm Y c hc

/-- **Remark 2.2** (lines 362-365): the direction used by Theorems A and B, `C_N ∩ B_n = 0 ⇒ x_1 ⋯ x_m ∈ T`
(its Lean proof uses only the forward half of step (6), `I^⊥ ⊆ A`, and the sign twist). -/
theorem rem_2_2_forward (n m : ℕ) (hn : 1 ≤ n) (hnm : n ≤ m) (Y : YoungSystem F (m + 1))
    (h : cycleSpan F (m + 1) ⊓ Y.boxSum n = ⊥) : firstLettersProd F m ∈ TIdeal F n := by
  exact NagataHigman.Proofs.rem_2_2_forward_general n m hn hnm Y h

/-- **Notation** (lines 271-274): `B_n := A ∩ A' = ⊕_{λ ⊆ (n^n)} I_λ` (the paper's definition of `B_n` agrees with the
box block sum `boxSum` used in every statement). -/
theorem B_eq_rowSum_inf_colSum (N n : ℕ) (Y : YoungSystem F N) :
    Y.rowSum n ⊓ Y.colSum n = Y.boxSum n := by
  exact NagataHigman.Proofs.YoungSystem.rowSum_inf_colSum Y n

/-- **Remark 2.3** (lines 368-369; also Section 1.4, lines 171-172): for `N > n²` no partition of `N` fits in the box, so `B_n^{(N)} = 0`. -/
theorem rem_2_3_box_empty (n N : ℕ) (Y : YoungSystem F N) (h : n ^ 2 < N) : Y.boxSum n = ⊥ := by
  exact NagataHigman.Proofs.boxSum_eq_bot_of_lt Y n h

/-- **Remark 2.3** (lines 367-370): Razmyslov's bound `d(n) ≤ n²`. -/
theorem rem_2_3_razmyslov (n : ℕ) (hn : 1 ≤ n) :
    firstLettersProd F (n ^ 2) ∈ TIdeal F n ∧ nhIndex F n ≤ n ^ 2 := by
  have hmem := NagataHigman.Proofs.razmyslov_mem n hn (youngSystem F (n ^ 2 + 1))
  exact ⟨hmem, NagataHigman.Proofs.nhIndex_le F (Nat.one_le_pow _ _ (by omega)) hmem⟩

/-! ## Section 3: the one-corner step, Theorem A -/

/-- **Lemma 3.1, proof** (line 379): the only partition of `n²` in the `n × n` box is the square `(n^n)`. -/
theorem lem_3_1_square (n : ℕ) (lam : Shape (n ^ 2)) (h : lam.InBox n) : lam.parts = Multiset.replicate n n := by
  exact NagataHigman.Proofs.lem_3_1_square_proved n lam h

/-- **Lemma 3.1, proof** (line 379), existence half of "the only partition of `n²` in the box is the square": the
square IS a partition of `n²` in the `n × n` box (so the claims about it are not vacuous). -/
theorem lem_3_1_square_exists (n : ℕ) : ∃ lam : Shape (n ^ 2), lam.InBox n := by
  exact NagataHigman.Proofs.lem_3_1_square_exists_proved n

/-- **Lemma 3.1, proof** (line 379): `B_n^{(n²)} = I_{(n^n)}`, the block of the square. -/
theorem B_square_eq_block (n : ℕ) (Y : YoungSystem F (n ^ 2)) (lam : Shape (n ^ 2)) (hlam : lam.InBox n) :
    Y.boxSum n = Y.block lam := by
  exact NagataHigman.Proofs.boxSum_sq_eq_block n Y lam hlam

/-- **Lemma 3.1, proof** (line 379): `B_n^{(n²)} ≠ 0` (so Lemma 3.1 is not vacuous). -/
theorem B_square_ne_bot (n : ℕ) (Y : YoungSystem F (n ^ 2)) : Y.boxSum n ≠ ⊥ := by
  exact NagataHigman.Proofs.boxSum_sq_ne_bot n Y

/-- **Lemma 3.1, proof** (lines 381-383), on the square: the `ρ(σ)`, `σ ∈ S_{N-1}` (the permutations fixing the
last point), span `End(S^β)`. -/
theorem lem_3_1_span (n : ℕ) (hn : 1 ≤ n) (Y : YoungSystem F (n ^ 2)) (lam : Shape (n ^ 2)) (hlam : lam.InBox n)
    (last : Fin (n ^ 2)) (hlast : (last : ℕ) + 1 = n ^ 2) :
    Submodule.span F (Set.range fun σ : {σ : Perm (Fin (n ^ 2)) // σ last = last} => Y.rho lam σ.1) = ⊤ := by
  exact NagataHigman.Proofs.lem_3_1_span_proved n hn Y lam hlam last hlast

/-- **Lemma 3.1** (lines 374-376): for `n ≥ 2`, `C_{n²} ∩ B_n^{(n²)} = 0`. -/
theorem lem_3_1 (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2)) : cycleSpan F (n ^ 2) ⊓ Y.boxSum n = ⊥ := by
  exact NagataHigman.Proofs.lemma_3_1_of hn Y
    (NagataHigman.Proofs.restriction_of_young Y) (NagataHigman.Proofs.lem_3_1_square_proved n)
    (fun lam hlam T top htop => NagataHigman.Proofs.square_pos_top n (by omega) lam hlam T top htop)

/-- **Theorem A** (lines 130-132; proof lines 386-388): for every `n ≥ 2`, `x_1 ⋯ x_{n²-1} ∈ T`, i.e. `d(n) ≤ n² - 1`. -/
theorem thm_A (n : ℕ) (hn : 2 ≤ n) :
    firstLettersProd F (n ^ 2 - 1) ∈ TIdeal F n ∧ nhIndex F n ≤ n ^ 2 - 1 := by
  have hmem := NagataHigman.Proofs.thm_A_mem n hn (youngSystem F (n ^ 2 - 1 + 1))
  have h4 : 4 ≤ n ^ 2 := by nlinarith
  exact ⟨hmem, NagataHigman.Proofs.nhIndex_le F (by omega) hmem⟩

/-- **Theorem A**, algebra form (definition of `d(n)`, lines 66-70; [Ro22, Prop. 1.8]): every associative, not necessarily
unital, `F`-algebra with `x^n = 0` for all `x` satisfies `x_1 x_2 ⋯ x_{n²-1} = 0`. -/
theorem thm_A_algebra (n : ℕ) (hn : 2 ≤ n) (R : Type*) [NonUnitalRing R] [Module F R] [IsScalarTower F R R]
    [SMulCommClass F R R] (hnil : ∀ x : R, nuPow x n = 0) (xs : Fin (n ^ 2 - 1) → R) :
    tupleProd (n ^ 2 - 1) xs = 0 := by
  have h4 : 4 ≤ n ^ 2 := by nlinarith
  exact NagataHigman.Proofs.tupleProd_eq_zero_of_mem (F := F) (by omega) (thm_A F n hn).1 hnil xs

/-! ## Section 4: the two-corner step, Theorem B -/

/-- **Section 4.1** (lines 393-394): for `n ≥ 2` the only partition of `n² - 1` in the box is
`ν = (n^{n-1}, n-1)`. -/
theorem sec_4_1_nu (n : ℕ) (hn : 2 ≤ n) (lam : Shape (n ^ 2 - 1)) (h : lam.InBox n) :
    lam.parts = Multiset.replicate (n - 1) n + {n - 1} := by
  exact NagataHigman.Proofs.sec_4_1_nu_proved n hn lam h

/-- **Section 4.1** (lines 393-394), existence half of "the only partition of `n² - 1` in the box is ν": for `n ≥ 2`,
ν IS a partition of `n² - 1` in the box (so Lemmas 4.1, 4.2 and the ν-claims are not vacuous). -/
theorem sec_4_1_nu_exists (n : ℕ) (hn : 2 ≤ n) : ∃ lam : Shape (n ^ 2 - 1), lam.InBox n := by
  exact NagataHigman.Proofs.sec_4_1_nu_exists_proved n hn

/-- **Section 4.1** (line 394): `B_n^{(n²-1)} = I_ν`, the block of the only partition in the box. -/
theorem B_nu_eq_block (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1)) (lam : Shape (n ^ 2 - 1))
    (hlam : lam.InBox n) : Y.boxSum n = Y.block lam := by
  exact NagataHigman.Proofs.boxSum_nu_eq_block n hn Y lam hlam

/-- **Section 4.1** (lines 393-394): `B_n^{(n²-1)} ≠ 0` for `n ≥ 2` (so Lemma 4.3 is not vacuous). -/
theorem B_nu_ne_bot (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1)) : Y.boxSum n ≠ ⊥ := by
  exact NagataHigman.Proofs.boxSum_nu_ne_bot n hn Y

/-- **Section 4.1, field step** (lines 395-396): by Proposition 2.1 and (F1), the dimension of `C_N ∩ I_ν` is the same
over every field of characteristic 0, so one may work over `ℂ`. Lean proves this for `C_N ∩ B_n^{(N)}`, any `n`, `N`,
and any two Young systems, by the same route (Proposition 2.1 and the rational spanning set of (F1),
Proofs/FieldStep.lean). -/
theorem sec_4_1_field (n N : ℕ) (Y : YoungSystem F N) (Y' : YoungSystem ℂ N) :
    Module.finrank F (cycleSpan F N ⊓ Y.boxSum n : Submodule F (GrpAlg F N)) =
      Module.finrank ℂ (cycleSpan ℂ N ⊓ Y'.boxSum n : Submodule ℂ (GrpAlg ℂ N)) := by
  exact NagataHigman.Proofs.sec_4_1_field_general F n N Y Y'

/-- **Section 4.1, example** (lines 396-398; line 509): for `n = 3`, `ν = (3, 3, 2)` and `N = 8`; its cells (contents,
column minus row: `0, 1, 2` in the first row, `-1, 0, 1` in the second, `-2, -1` in the third); its two removable corners
`(2, 3)`, `(3, 2)` (Lean `(1, 2)`, `(2, 1)`) of contents `+1`, `-1`; and `h(ν) = (5, 3)`. -/
theorem sec_4_1_example (lam : Shape 8) (h : lam.InBox 3) :
    lam.parts = {3, 3, 2} ∧
      (∀ i j : ℕ, (i, j) ∈ lam.diagram ↔ (i, j) ∈ ({(0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (1, 2), (2, 0), (2, 1)} :
        Finset (ℕ × ℕ))) ∧
      (∀ T : SYT lam, (T.pos 7 = (1, 2) ∧ T.content 7 = 1) ∨ (T.pos 7 = (2, 1) ∧ T.content 7 = -1)) ∧
      lam.diagonalHooks = {5, 3} := by
  exact NagataHigman.Proofs.Examples.ex_nu_three lam h

/-- **Section 4.3** (lines 437-439): `ν` has two removable corners, `a₊ = (n-1, n)` of content `+1` and
`a₋ = (n, n-1)` of content `-1` (Lean, 0-indexed: `(n-2, n-1)` and `(n-1, n-2)`); the largest entry of every standard
tableau sits at one of them. -/
theorem nu_two_corners (n : ℕ) (hn : 2 ≤ n) (lam : Shape (n ^ 2 - 1)) (hlam : lam.InBox n) (T : SYT lam)
    (top : Fin (n ^ 2 - 1)) (htop : (top : ℕ) + 1 = n ^ 2 - 1) :
    (T.pos top = (n - 2, n - 1) ∧ T.content top = 1) ∨ (T.pos top = (n - 1, n - 2) ∧ T.content top = -1) := by
  exact NagataHigman.Proofs.nu_top_corner n hn lam hlam T top htop

/-- **Section 4.3** (lines 437-439): `ν` has EXACTLY these two removable corners — each of `a₊` and `a₋` holds the
largest entry of some standard tableau (with `nu_two_corners`: of every tableau, the largest entry is at `a₊` or
`a₋`). -/
theorem nu_two_corners_exist (n : ℕ) (hn : 2 ≤ n) (lam : Shape (n ^ 2 - 1)) (hlam : lam.InBox n)
    (top : Fin (n ^ 2 - 1)) (htop : (top : ℕ) + 1 = n ^ 2 - 1) :
    (∃ T : SYT lam, T.pos top = (n - 2, n - 1)) ∧ ∃ T : SYT lam, T.pos top = (n - 1, n - 2) := by
  exact NagataHigman.Proofs.nu_two_corners_exist_proved n hn lam hlam top htop

