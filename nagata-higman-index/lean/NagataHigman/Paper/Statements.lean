open NagataHigman.Proofs.ExV110 NagataHigman.Proofs.Ex21 in
/-- **Example `λ = (2,1)`, (T2)** (lines 502-503): the diagonal entries of `ρ((2 3))` are `1/(-1-1) = -1/2` and
`1/(1+1) = 1/2`. -/
theorem ex_lam21_T2 (Y : YoungSystem F 3) (b : Module.Basis (SYT shape21) F (Fin (Y.dim shape21) → F))
    (hb : ∀ (T : SYT shape21) (k : Fin 3),
