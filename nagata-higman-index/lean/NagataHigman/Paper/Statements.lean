/-- **Proposition 2.1, step (6), reverse inclusion** (lines 344-349): every (F1) element `a · L(v_1, …, v_n) · b` is hit,
by `τ := Φ(a v_1 ⋯ v_n b)` (an `N`-cycle) and `X` = the last letters of the `v_i` and `z`, `|X| = n + 1`. -/
theorem prop_2_1_step6_converse (n m : ℕ) (hn : 1 ≤ n) (hnm : n ≤ m) (a : List ℕ) (v : Fin n → List ℕ)
    (b : List ℕ) (h : IsMultilinTriple m a v b) :
    ∃ (τ : Perm (Fin (m + 1))) (X : Finset (Fin (m + 1))) (c : Perm (Fin m) → F), IsFullCycle τ ∧
      X.card = n + 1 ∧ wordLin F m c = sandwichElem F a v b ∧
      cycleLin F m c = cycleProj F (m + 1) (perm F τ * altSum F X) := by
  exact NagataHigman.Proofs.prop21_step6_converse n m hn hnm a v b h

/-- **Proposition 2.1, step (6), the inclusion `P(I) ⊆ Φ(W_{n,m})`** (lines 325-340; the half Remark 2.2 says Theorems A and B use):
`P(I) ⊆ Φ(W_{n,m})`. -/
theorem prop_2_1_step6_forward (n m : ℕ) (hn : 1 ≤ n) (hnm : n ≤ m) :
    (altIdeal F (m + 1) n).map (cycleProj F (m + 1)) ≤
      ((multilinIdentities F n m).comap (wordLin F m)).map (cycleLin F m) := by
  exact NagataHigman.Proofs.prop21_step6_forward n m hn hnm

/-- **Proposition 2.1, step (6)** (lines 325-349): `P(I) = Φ(W_{n,m})`. -/
theorem prop_2_1_step6 (n m : ℕ) (hn : 1 ≤ n) (hnm : n ≤ m) :
    (altIdeal F (m + 1) n).map (cycleProj F (m + 1)) =
      ((multilinIdentities F n m).comap (wordLin F m)).map (cycleLin F m) := by
  exact NagataHigman.Proofs.prop21_step6 n m hn hnm

