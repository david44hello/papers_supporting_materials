/-- **Remark 2.2** (lines 410-413): the direction used by Theorems A and B, `C_N ∩ B_n = 0 ⇒ x_1 ⋯ x_m ∈ T`
(its Lean proof uses only the forward half of step (6), `I^⊥ ⊆ A`, and the sign twist). -/
theorem rem_2_2_forward (n m : ℕ) (hn : 1 ≤ n) (hnm : n ≤ m) (Y : YoungSystem F (m + 1))
    (h : cycleSpan F (m + 1) ⊓ Y.boxSum n = ⊥) : firstLettersProd F m ∈ TIdeal F n := by
  exact NagataHigman.Proofs.rem_2_2_forward_general n m hn hnm Y h

/-- **Notation** (lines 297-300): `B_n := A ∩ A' = ⊕_{λ ⊆ (n^n)} I_λ` (the paper's definition of `B_n` agrees with the
box block sum `boxSum` used in every statement). -/
theorem B_eq_rowSum_inf_colSum (N n : ℕ) (Y : YoungSystem F N) :
    Y.rowSum n ⊓ Y.colSum n = Y.boxSum n := by
  exact NagataHigman.Proofs.YoungSystem.rowSum_inf_colSum Y n

/-- **Remark 2.3** (lines 416-417; also Section 1.4, lines 181-183): for `N > n²` no partition of `N` fits in the box, so `B_n^{(N)} = 0`. -/
theorem rem_2_3_box_empty (n N : ℕ) (Y : YoungSystem F N) (h : n ^ 2 < N) : Y.boxSum n = ⊥ := by
  exact NagataHigman.Proofs.boxSum_eq_bot_of_lt Y n h

/-- **Remark 2.3** (lines 415-418): Razmyslov's bound `d(n) ≤ n²`. -/
theorem rem_2_3_razmyslov (n : ℕ) (hn : 1 ≤ n) :
    firstLettersProd F (n ^ 2) ∈ TIdeal F n ∧ nhIndex F n ≤ n ^ 2 := by
  have hmem := NagataHigman.Proofs.razmyslov_mem n hn (youngSystem F (n ^ 2 + 1))
  exact ⟨hmem, NagataHigman.Proofs.nhIndex_le F (Nat.one_le_pow _ _ (by omega)) hmem⟩

/-! ## Section 3: the one-corner step, Theorem A -/

/-- **Lemma 3.1, proof** (line 427): the only partition of `n²` in the `n × n` box is the square `(n^n)`. -/
theorem lem_3_1_square (n : ℕ) (lam : Shape (n ^ 2)) (h : lam.InBox n) : lam.parts = Multiset.replicate n n := by
  exact NagataHigman.Proofs.lem_3_1_square_proved n lam h

/-- **Lemma 3.1, proof** (line 427), existence half of "the only partition of `n²` in the box is the square": the
square IS a partition of `n²` in the `n × n` box (so the claims about it are not vacuous). -/
theorem lem_3_1_square_exists (n : ℕ) : ∃ lam : Shape (n ^ 2), lam.InBox n := by
  exact NagataHigman.Proofs.lem_3_1_square_exists_proved n

/-- **Lemma 3.1, proof** (line 427): `B_n^{(n²)} = I_{(n^n)}`, the block of the square. -/
theorem B_square_eq_block (n : ℕ) (Y : YoungSystem F (n ^ 2)) (lam : Shape (n ^ 2)) (hlam : lam.InBox n) :
    Y.boxSum n = Y.block lam := by
  exact NagataHigman.Proofs.boxSum_sq_eq_block n Y lam hlam

/-- **Lemma 3.1, proof** (line 427): `B_n^{(n²)} ≠ 0` (so Lemma 3.1 is not vacuous). -/
theorem B_square_ne_bot (n : ℕ) (Y : YoungSystem F (n ^ 2)) : Y.boxSum n ≠ ⊥ := by
  exact NagataHigman.Proofs.boxSum_sq_ne_bot n Y

/-- **Lemma 3.1, proof** (lines 429-431), on the square: the `ρ(σ)`, `σ ∈ S_{N-1}` (the permutations fixing the
last point), span `End(S^β)`. -/
theorem lem_3_1_span (n : ℕ) (hn : 1 ≤ n) (Y : YoungSystem F (n ^ 2)) (lam : Shape (n ^ 2)) (hlam : lam.InBox n)
    (last : Fin (n ^ 2)) (hlast : (last : ℕ) + 1 = n ^ 2) :
    Submodule.span F (Set.range fun σ : {σ : Perm (Fin (n ^ 2)) // σ last = last} => Y.rho lam σ.1) = ⊤ := by
  exact NagataHigman.Proofs.lem_3_1_span_proved n hn Y lam hlam last hlast

/-- **Lemma 3.1** (lines 422-424): for `n ≥ 2`, `C_{n²} ∩ B_n^{(n²)} = 0`. -/
theorem lem_3_1 (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2)) : cycleSpan F (n ^ 2) ⊓ Y.boxSum n = ⊥ := by
  exact NagataHigman.Proofs.lemma_3_1_of hn Y
    (NagataHigman.Proofs.restriction_of_young Y) (NagataHigman.Proofs.lem_3_1_square_proved n)
    (fun lam hlam T top htop => NagataHigman.Proofs.square_pos_top n (by omega) lam hlam T top htop)

/-- **Theorem A** (lines 134-136; proof lines 434-436): for every `n ≥ 2`, `x_1 ⋯ x_{n²-1} ∈ T`, i.e. `d(n) ≤ n² - 1`. -/
theorem thm_A (n : ℕ) (hn : 2 ≤ n) :
    firstLettersProd F (n ^ 2 - 1) ∈ TIdeal F n ∧ nhIndex F n ≤ n ^ 2 - 1 := by
  have hmem := NagataHigman.Proofs.thm_A_mem n hn (youngSystem F (n ^ 2 - 1 + 1))
  have h4 : 4 ≤ n ^ 2 := by nlinarith
  exact ⟨hmem, NagataHigman.Proofs.nhIndex_le F (by omega) hmem⟩

/-- **Theorem A**, algebra form (definition of `d(n)`, lines 67-71; [Ro22, Prop. 1.8]): every associative, not necessarily
unital, `F`-algebra with `x^n = 0` for all `x` satisfies `x_1 x_2 ⋯ x_{n²-1} = 0`. -/
theorem thm_A_algebra (n : ℕ) (hn : 2 ≤ n) (R : Type*) [NonUnitalRing R] [Module F R] [IsScalarTower F R R]
    [SMulCommClass F R R] (hnil : ∀ x : R, nuPow x n = 0) (xs : Fin (n ^ 2 - 1) → R) :
    tupleProd (n ^ 2 - 1) xs = 0 := by
  have h4 : 4 ≤ n ^ 2 := by nlinarith
  exact NagataHigman.Proofs.tupleProd_eq_zero_of_mem (F := F) (by omega) (thm_A F n hn).1 hnil xs

/-! ## Section 4: the two-corner step, Theorem B -/

/-- **Section 4.1** (lines 443-444): "A partition of `N` that fits in the `n×n` box leaves out exactly one cell of the
box, and this cell must be `(n,n)`" (0-indexed `(n-1, n-1)`). (Lean proves `sec_4_1_nu` below by counting parts; this row
and `square_one_corner` give the paper's argument.) -/
theorem sec_4_1_one_cell (n : ℕ) (hn : 2 ≤ n) (lam : Shape (n ^ 2 - 1)) (h : lam.InBox n) :
    lam.diagram.cells ⊆ Finset.range n ×ˢ Finset.range n ∧
      (Finset.range n ×ˢ Finset.range n) \ lam.diagram.cells = {(n - 1, n - 1)} :=
  NagataHigman.Proofs.ExV110R1.sec_4_1_one_cell n hn lam h

/-- **Section 4.1** (lines 443-444): for `n ≥ 2` the only partition of `n² - 1` in the box is
`ν = (n^{n-1}, n-1)`. -/
theorem sec_4_1_nu (n : ℕ) (hn : 2 ≤ n) (lam : Shape (n ^ 2 - 1)) (h : lam.InBox n) :
    lam.parts = Multiset.replicate (n - 1) n + {n - 1} := by
  exact NagataHigman.Proofs.sec_4_1_nu_proved n hn lam h

/-- **Section 4.1** (lines 443-444), existence half of "the only partition of `n² - 1` in the box is ν": for `n ≥ 2`,
ν IS a partition of `n² - 1` in the box (so Lemmas 4.1, 4.2 and the ν-claims are not vacuous). -/
theorem sec_4_1_nu_exists (n : ℕ) (hn : 2 ≤ n) : ∃ lam : Shape (n ^ 2 - 1), lam.InBox n := by
  exact NagataHigman.Proofs.sec_4_1_nu_exists_proved n hn

/-- **Section 4.1** (line 444): `B_n^{(n²-1)} = I_ν`, the block of the only partition in the box. -/
theorem B_nu_eq_block (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1)) (lam : Shape (n ^ 2 - 1))
    (hlam : lam.InBox n) : Y.boxSum n = Y.block lam := by
  exact NagataHigman.Proofs.boxSum_nu_eq_block n hn Y lam hlam

/-- **Section 4.1** (lines 443-444): `B_n^{(n²-1)} ≠ 0` for `n ≥ 2` (so Lemma 4.3 is not vacuous). -/
theorem B_nu_ne_bot (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1)) : Y.boxSum n ≠ ⊥ := by
  exact NagataHigman.Proofs.boxSum_nu_ne_bot n hn Y

omit [CharZero F] in
/-- **Section 4.1, display (*)** (lines 449-451): "then, by (F2)", an element `f` of the block `I_λ` has the
coefficients `f(σ) = (f^λ/N!) tr(ρ_λ(σ⁻¹) ρ_λ(f))`. -/
theorem sec_4_1_star (N : ℕ) (Y : YoungSystem F N) (lam : Shape N) (f : GrpAlg F N) (hf : f ∈ Y.block lam)
    (σ : Perm (Fin N)) :
    f.coeff σ = ((Y.dim lam : F) / (N.factorial : F)) * trace (Y.rho lam σ⁻¹ * Y.rhoAlg lam f) :=
  NagataHigman.Proofs.YoungSystem.coeff_of_mem_block Y hf σ

/-- **Section 4.1, example** (lines 446-448; line 602): for `n = 3`, `ν = (3, 3, 2)` and `N = 8`; its cells (contents,
column minus row: `0, 1, 2` in the first row, `-1, 0, 1` in the second, `-2, -1` in the third); its two removable corners
`(2, 3)`, `(3, 2)` (Lean `(1, 2)`, `(2, 1)`) of contents `+1`, `-1`; and `h(ν) = (5, 3)`. -/
theorem sec_4_1_example (lam : Shape 8) (h : lam.InBox 3) :
    lam.parts = {3, 3, 2} ∧
      (∀ i j : ℕ, (i, j) ∈ lam.diagram ↔ (i, j) ∈ ({(0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (1, 2), (2, 0), (2, 1)} :
        Finset (ℕ × ℕ))) ∧
      (∀ T : SYT lam, (T.pos 7 = (1, 2) ∧ T.content 7 = 1) ∨ (T.pos 7 = (2, 1) ∧ T.content 7 = -1)) ∧
      lam.diagonalHooks = {5, 3} := by
  exact NagataHigman.Proofs.Examples.ex_nu_three lam h

/-- **Section 4.3** (lines 518-520): `ν` has two removable corners, `a₊ = (n-1, n)` of content `+1` and
`a₋ = (n, n-1)` of content `-1` (Lean, 0-indexed: `(n-2, n-1)` and `(n-1, n-2)`); the largest entry of every standard
tableau sits at one of them. -/
theorem nu_two_corners (n : ℕ) (hn : 2 ≤ n) (lam : Shape (n ^ 2 - 1)) (hlam : lam.InBox n) (T : SYT lam)
    (top : Fin (n ^ 2 - 1)) (htop : (top : ℕ) + 1 = n ^ 2 - 1) :
    (T.pos top = (n - 2, n - 1) ∧ T.content top = 1) ∨ (T.pos top = (n - 1, n - 2) ∧ T.content top = -1) := by
  exact NagataHigman.Proofs.nu_top_corner n hn lam hlam T top htop

/-- **Section 4.3** (lines 518-520): `ν` has EXACTLY these two removable corners — each of `a₊` and `a₋` holds the
largest entry of some standard tableau (with `nu_two_corners`: of every tableau, the largest entry is at `a₊` or
`a₋`). -/
theorem nu_two_corners_exist (n : ℕ) (hn : 2 ≤ n) (lam : Shape (n ^ 2 - 1)) (hlam : lam.InBox n)
    (top : Fin (n ^ 2 - 1)) (htop : (top : ℕ) + 1 = n ^ 2 - 1) :
    (∃ T : SYT lam, T.pos top = (n - 2, n - 1)) ∧ ∃ T : SYT lam, T.pos top = (n - 1, n - 2) := by
  exact NagataHigman.Proofs.nu_two_corners_exist_proved n hn lam hlam top htop

omit [CharZero F] in
/-- **Section 4.3** (lines 517-518): `X^{(N)} = J_N`, and `g X^{(j)} g⁻¹ = X^{(g(j))}` for `g ∈ S_N`
(0-indexed: `top = N-1`). -/
theorem sec_4_3_stars (N : ℕ) (top : Fin N) (htop : (top : ℕ) + 1 = N) :
    starElem F top = jucysMurphy F top ∧
      ∀ (g : Perm (Fin N)) (j : Fin N), perm F g * starElem F j * perm F g⁻¹ = starElem F (g j) := by
  exact ⟨NagataHigman.Proofs.starElem_top F top htop, fun g j => NagataHigman.Proofs.perm_conj_starElem F g j⟩

/-- **(T2)** (line 472): `s J_{k+1} - J_k s = 1` for `s = (k, k+1)`. -/
theorem T2_relation (N : ℕ) (k l : Fin N) (hkl : (l : ℕ) = k + 1) :
    perm F (swap k l) * jucysMurphy F l - jucysMurphy F k * perm F (swap k l) = 1 := by
  exact NagataHigman.Proofs.R_relation F N k l hkl

/-- **(T2)** (line 471): in a Young basis `{v_T}`, `ρ(s) v_T ∈ span(v_T, v_{sT})`, the `v_{sT}` term only when
`sT` is standard (here: the coefficient at `T' ≠ T` vanishes unless `T'` is `T` with `k, k+1` swapped). -/
theorem T2_support (N : ℕ) (Y : YoungSystem F N) (lam : Shape N)
    (b : Module.Basis (SYT lam) F (Fin (Y.dim lam) → F))
    (hb : ∀ (T : SYT lam) (k : Fin N),
      Y.rhoAlg lam (jucysMurphy F k) *ᵥ b T = ((T.content k : ℤ) : F) • b T)
    (T T' : SYT lam) (k l : Fin N) (hkl : (l : ℕ) = k + 1)
    (hne : b.repr (Y.rho lam (swap k l) *ᵥ b T) T' ≠ 0) :
    T' = T ∨ T'.pos = T.pos ∘ swap k l := by
  exact NagataHigman.Proofs.YoungSystem.R_support_pos _ b hb T T' k l hkl hne

/-- **(T2)** (lines 473-476): taking the `v_T`-coefficient of `s J_{k+1} - J_k s = 1` applied to `v_T`
("`ρ(J_k)` and `ρ(J_{k+1})` are diagonal by (T1)": the hypothesis `hb`) gives
`(c_T(k+1) - c_T(k)) ρ(s)_{TT} = 1`, so `ρ(s)_{TT} = 1/(c_T(k+1) - c_T(k))`. -/
theorem T2_diag (N : ℕ) (Y : YoungSystem F N) (lam : Shape N)
    (b : Module.Basis (SYT lam) F (Fin (Y.dim lam) → F))
    (hb : ∀ (T : SYT lam) (k : Fin N),
      Y.rhoAlg lam (jucysMurphy F k) *ᵥ b T = ((T.content k : ℤ) : F) • b T)
    (T : SYT lam) (k l : Fin N) (hkl : (l : ℕ) = k + 1) :
    ((T.content l - T.content k : ℤ) : F) * b.repr (Y.rho lam (swap k l) *ᵥ b T) T = 1 ∧
      b.repr (Y.rho lam (swap k l) *ᵥ b T) T = 1 / (((T.content l - T.content k : ℤ)) : F) := by
  obtain ⟨hne, hdiag⟩ := NagataHigman.Proofs.R_diag_general _ b hb T k l hkl
  exact ⟨by rw [hdiag, mul_one_div_cancel hne], hdiag⟩

/-- **(T3)** (lines 479-481): for self-conjugate `λ` there is an invertible `Γ` with `Γ ρ(σ) = sgn(σ) ρ(σ) Γ`. -/
theorem Gamma_exists (N : ℕ) (Y : YoungSystem F N) (lam : Shape N) (h : lam.conjugate = lam) :
    ∃ Γ : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F, IsUnit Γ ∧
      ∀ σ : Perm (Fin N), Γ * Y.rho lam σ =
        ((Perm.sign σ : ℤ) : F) • (Y.rho lam σ * Γ) := by
  exact NagataHigman.Proofs.gamma_exists _ lam h

/-- **(T3)** (lines 479-482), over ℂ as in Section 4 (the setting of `Gamma_support`): for every Young system over ℂ
and self-conjugate `λ`, the invertible `Γ` with `Γ ρ(σ) = sgn(σ) ρ(σ) Γ` exists. -/
theorem Gamma_exists_C (N : ℕ) (Y : YoungSystem ℂ N) (lam : Shape N) (h : lam.conjugate = lam) :
    ∃ Γ : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) ℂ, IsUnit Γ ∧
      ∀ σ : Perm (Fin N), Γ * Y.rho lam σ =
        ((Perm.sign σ : ℤ) : ℂ) • (Y.rho lam σ * Γ) := by
  exact Gamma_exists ℂ N Y lam h

/-- **(T3)** (lines 481-482): "over $\mathbb{C}$ we rescale $\Gamma$ so that $\Gamma^2=\mathrm{id}$": for every Young
system over ℂ and self-conjugate `λ`, there is `Γ` with `Γ² = id` and `Γ ρ(σ) = sgn(σ) ρ(σ) Γ`. -/
theorem Gamma_exists_C_normalized (N : ℕ) (Y : YoungSystem ℂ N) (lam : Shape N) (h : lam.conjugate = lam) :
    ∃ Γ : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) ℂ, Γ * Γ = 1 ∧
      ∀ σ : Perm (Fin N), Γ * Y.rho lam σ = ((Perm.sign σ : ℤ) : ℂ) • (Y.rho lam σ * Γ) :=
  NagataHigman.Proofs.ExV110R1.gamma_normalized N Y lam h

/-- **(T3)** (lines 481-482): `Γ²` commutes with `ρ(S_N)`, so it is a nonzero scalar (Schur). -/
theorem Gamma_sq_scalar (N : ℕ) (Y : YoungSystem F N) (lam : Shape N)
    (Γ : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) (hΓu : IsUnit Γ)
    (hΓ : ∀ σ : Perm (Fin N), Γ * Y.rho lam σ =
      ((Perm.sign σ : ℤ) : F) • (Y.rho lam σ * Γ)) :
    ∃ c : F, c ≠ 0 ∧ Γ * Γ = c • 1 := by
  exact NagataHigman.Proofs.gamma_sq_scalar _ lam Γ hΓu hΓ

/-- **(T3)** (line 490): `ψ(σ) = tr(ρ(σ)Γ)` vanishes for odd `σ`. -/
theorem Gamma_odd (N : ℕ) (Y : YoungSystem F N) (lam : Shape N)
    (Γ : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F)
    (hΓ : ∀ σ : Perm (Fin N), Γ * Y.rho lam σ =
      ((Perm.sign σ : ℤ) : F) • (Y.rho lam σ * Γ))
    (σ : Perm (Fin N)) (hσ : Perm.sign σ = -1) : trace (Y.rho lam σ * Γ) = 0 := by
  exact NagataHigman.Proofs.gamma_odd _ lam Γ hΓ σ hσ

/-- **(T3)** (lines 479-497), over ℂ, for every Young system `Y` over ℂ and every shape `λ` with the cited splitting
`S` (`Res_{A_N} S^λ = V₊ ⊕ V₋` and Frobenius, JK81 2.5.7 and 2.5.13 for `λ = λ'`, `N ≥ 2`; the cited
`youngSystemC_split` gives a `Y` with `S` for every such `λ`): for `Γ` an invertible intertwiner of `ρ_λ` with `sgn ⊗ ρ_λ`, `ψ(σ) = tr(ρ(σ)Γ)` is supported EXACTLY on
the permutations of cycle type `h(λ)`. (Proved from the cited splitting and Frobenius' theorem `χ₊ = χ₋` off `h(λ)`,
via the paper's argument: `Γ` is `±a` on `V±`, so `ψ = a(χ₊ − χ₋)` on `A_N`.) `N ≥ 2`: the paper uses `ρ((1 2))`. -/
theorem Gamma_support (N : ℕ) (Y : YoungSystem ℂ N) (lam : Shape N) (S : AltSplit Y lam) (hN : 2 ≤ N)
    (Γ : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) ℂ) (hΓu : IsUnit Γ)
    (hΓ : ∀ σ : Perm (Fin N), Γ * Y.rho lam σ =
      ((Perm.sign σ : ℤ) : ℂ) • (Y.rho lam σ * Γ))
    (σ : Perm (Fin N)) : trace (Y.rho lam σ * Γ) ≠ 0 ↔ σ.partition.parts = lam.diagonalHooks := by
  exact NagataHigman.Proofs.gamma_support_of_split Y lam S hN Γ hΓu hΓ σ

/-- **(T3)** (lines 482-485), over ℂ with the cited splitting alone (no Frobenius clause): `Γ` is a scalar `a` on `V₊`
and `-a` on `V₋`. `N ≥ 2`: the paper uses `ρ((1 2))` (l. 426). -/
theorem Gamma_pm (N : ℕ) (Y : YoungSystem ℂ N) (lam : Shape N) (S : AltDecomp Y lam) (hN : 2 ≤ N)
    (Γ : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) ℂ) (hΓu : IsUnit Γ)
    (hΓ : ∀ σ : Perm (Fin N), Γ * Y.rho lam σ = ((Perm.sign σ : ℤ) : ℂ) • (Y.rho lam σ * Γ)) :
    ∃ a : ℂ, (∀ v ∈ S.Vp, Γ *ᵥ v = a • v) ∧ (∀ v ∈ S.Vm, Γ *ᵥ v = (-a) • v) := by
  exact NagataHigman.Proofs.gamma_pm Y S hN Γ hΓu hΓ

/-- **(T3)** (line 490), with the cited splitting alone: on `A_N`, `ψ(σ) = tr(ρ(σ)Γ) = a (χ₊(σ) - χ₋(σ))`. -/
theorem Gamma_trace_even (N : ℕ) (Y : YoungSystem ℂ N) (lam : Shape N) (S : AltDecomp Y lam)
    (Γ : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) ℂ) (a : ℂ)
    (hp : ∀ v ∈ S.Vp, Γ *ᵥ v = a • v) (hm : ∀ v ∈ S.Vm, Γ *ᵥ v = (-a) • v)
    (σ : Perm (Fin N)) (hσ : Perm.sign σ = 1) :
    trace (Y.rho lam σ * Γ) =
      a * (LinearMap.trace ℂ S.Vp ((Matrix.mulVecLin (Y.rho lam σ)).restrict (S.inv_p σ hσ)) -
        LinearMap.trace ℂ S.Vm ((Matrix.mulVecLin (Y.rho lam σ)).restrict (S.inv_m σ hσ))) := by
  exact NagataHigman.Proofs.trace_even_eq Y S Γ a hp hm σ hσ

/-- **(T3)** (lines 491-495): for `λ = λ'` the diagonal hook lengths `h(λ) = (h_{11}, h_{22}, …)` are distinct odd
numbers with sum `N`, so `h(λ)` is a cycle type of `S_N` (that of some permutation, fixed points counted as parts 1). -/
theorem T3_hooks (N : ℕ) (lam : Shape N) (h : lam.conjugate = lam) :
    (∀ x ∈ lam.diagonalHooks, Odd x) ∧ lam.diagonalHooks.Nodup ∧ lam.diagonalHooks.sum = N ∧
      ∃ σ : Perm (Fin N), σ.partition.parts = lam.diagonalHooks := by
  exact ⟨NagataHigman.Proofs.DiagonalHooks.diagonalHooks_odd lam h,
    NagataHigman.Proofs.DiagonalHooks.diagonalHooks_nodup lam h,
    NagataHigman.Proofs.DiagonalHooks.diagonalHooks_sum lam h,
    NagataHigman.Proofs.DiagonalHooks.diagonalHooks_cycleType lam h⟩

/-- **(T3)** (lines 492-493): for `λ = λ'`, the hook length of the diagonal cell `(i, i)` is `h_{ii} = 2(λ_i - i) + 1`.
Lean, 0-indexed rows (`rowLen i = λ_{i+1}`): `h(λ)` (`diagonalHooks`, defined by hook length = arm + leg + 1) is the
multiset of the `2 (λ_{i+1} - (i+1)) + 1` over the diagonal cells `(i, i)`. -/
theorem T3_hook_formula (N : ℕ) (lam : Shape N) (h : lam.conjugate = lam) :
    lam.diagonalHooks = ((range N).filter (fun i => (i, i) ∈ lam.diagram.cells)).val.map
      (fun i => 2 * (lam.diagram.rowLen i - (i + 1)) + 1) := by
  exact NagataHigman.Proofs.DiagonalHooks.diagonalHooks_eq_formula lam h

