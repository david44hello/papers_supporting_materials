/-- **Proposition 2.1, step (6), example** (lines 340-342): `n = 2`, `N = 5`, `τ = Φ(x_1 x_2 x_3 x_4) = (5 1 2 3 4)`,
`K = {1, 3, 4}`: `τ̄ = (1 3 4)`, the arcs are `(2, 3)`, `(4)` and `Arc_0 = (5, 1)`, so `ζ` is empty and `ξ = (1)`, and
`Π = {1, τ̄}` (Lean, 0-indexed: `τ = 4 → 0 → 1 → 2 → 3 → 4`, `K = {0, 2, 3}`, `τ̄ = (0 2 3)`, arcs `[1, 2]`, `[3]`,
`[4, 0]`, so `ζ = []`, `ξ = [0]`). -/
theorem prop_2_1_step6_example_arcs :
    ((wordCycle (1 : Perm (Fin 4))) 4 = 0 ∧ (wordCycle (1 : Perm (Fin 4))) 0 = 1 ∧
      (wordCycle (1 : Perm (Fin 4))) 1 = 2 ∧ (wordCycle (1 : Perm (Fin 4))) 2 = 3 ∧
      (wordCycle (1 : Perm (Fin 4))) 3 = 4) ∧
    firstReturn (wordCycle (1 : Perm (Fin 4))) {0, 2, 3} = List.formPerm [0, 2, 3] ∧
    (arc (wordCycle (1 : Perm (Fin 4))) {0, 2, 3} 0 = [1, 2] ∧
      arc (wordCycle (1 : Perm (Fin 4))) {0, 2, 3} 2 = [3] ∧
      arc (wordCycle (1 : Perm (Fin 4))) {0, 2, 3} 3 = [4, 0]) ∧
    Finset.univ.filter (fun π : Perm (Fin 5) =>
        π.support ⊆ {0, 2, 3} ∧ IsFullCycle (wordCycle (1 : Perm (Fin 4)) * π)) =
      {1, firstReturn (wordCycle (1 : Perm (Fin 4))) {0, 2, 3}} := by
  exact ⟨NagataHigman.Proofs.Examples.ex_step6_tau, NagataHigman.Proofs.Examples.ex_step6_return,
    NagataHigman.Proofs.Examples.ex_step6_arcs, NagataHigman.Proofs.Examples.ex_step6_Pi⟩

