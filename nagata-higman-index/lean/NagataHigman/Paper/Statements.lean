open NagataHigman.Proofs.Ex21 in
/-- **Example `λ = (2,1)`** (lines 509-510): "An operator that anticommutes with both matrices has zero diagonal entries
(by the first) and opposite off-diagonal entries (by the second), so it is a multiple of `Γ_0`" (the two displayed
matrices `rho12 = diag(1, -1)`, `rho23`; `Gamma0 = [[0, 1], [-1, 0]]`). -/
theorem ex_lam21_anticommutant (G : Matrix (Fin 2) (Fin 2) ℂ) :
    (G * rho12 = -(rho12 * G) ∧ G * rho23 = -(rho23 * G)) ↔ ∃ c : ℂ, G = c • Gamma0 :=
  ex21_anticommutant G

open NagataHigman.Proofs.Ex21 in
/-- **Example `λ = (2,1)`** (line 511): `Γ_0² = -id`. -/
theorem ex_lam21_Gamma0_sq : Gamma0 * Gamma0 = -1 := ex21_Gamma0_sq

/-- **Example `λ = (2,1)`** (line 511): "this is why (T3) needs `ℂ`": over `ℝ` no matrix anticommutes with both
displayed (real) matrices and squares to `1`. -/
theorem ex_lam21_needs_C (G : Matrix (Fin 2) (Fin 2) ℝ) :
    ¬ (G * !![1, 0; 0, -1] = -(!![1, 0; 0, -1] * G) ∧
       G * !![-1/2, Real.sqrt 3 / 2; Real.sqrt 3 / 2, 1/2] = -(!![-1/2, Real.sqrt 3 / 2; Real.sqrt 3 / 2, 1/2] * G) ∧
       G * G = 1) :=
  NagataHigman.Proofs.Ex21.ex21_needs_C G

open NagataHigman.Proofs.ExV110 NagataHigman.Proofs.Ex21 Complex in
/-- **Example `λ = (2,1)`, Young's orthogonal form, (T3) and `ψ`** (lines 503-513), over `ℂ`: a rescaling `b'` of the
Young basis `v_{T12}, v_{T13}` in which `ρ((1 2))` and `ρ((2 3))` are the two displayed matrices `rho12`, `rho23`; in it
every `Γ` of (T3) (`Γρ(σ) = sgn(σ)ρ(σ)Γ`, `Γ² = id`) is `±iΓ_0`, and for `Γ = iΓ_0`, `ψ(σ) = tr(ρ(σ)Γ)` vanishes on the
identity and the transpositions, and `ψ((1 2 3)) = -i√3 = -ψ((1 3 2))`. -/
theorem ex_lam21_orthogonal (Y : YoungSystem ℂ 3)
    (b : Module.Basis (SYT shape21) ℂ (Fin (Y.dim shape21) → ℂ))
    (hb : ∀ (T : SYT shape21) (k : Fin 3),
      Y.rhoAlg shape21 (jucysMurphy ℂ k) *ᵥ b T = ((T.content k : ℤ) : ℂ) • b T) :
    ∃ b' : Module.Basis (Fin 2) ℂ (Fin (Y.dim shape21) → ℂ),
      (∀ i, ∃ c : ℂ, c ≠ 0 ∧ b' i = c • b (tab i)) ∧
      LinearMap.toMatrix b' b' (Matrix.toLin' (Y.rho shape21 (swap 0 1))) = rho12 ∧
      LinearMap.toMatrix b' b' (Matrix.toLin' (Y.rho shape21 (swap 1 2))) = rho23 ∧
      (∀ Γ : Matrix (Fin (Y.dim shape21)) (Fin (Y.dim shape21)) ℂ,
        (∀ σ : Perm (Fin 3), Γ * Y.rho shape21 σ = ((Perm.sign σ : ℤ) : ℂ) • (Y.rho shape21 σ * Γ)) → Γ * Γ = 1 →
        LinearMap.toMatrix b' b' (Matrix.toLin' Γ) = I • Gamma0 ∨
          LinearMap.toMatrix b' b' (Matrix.toLin' Γ) = -I • Gamma0) ∧
      (∀ Γ : Matrix (Fin (Y.dim shape21)) (Fin (Y.dim shape21)) ℂ,
        LinearMap.toMatrix b' b' (Matrix.toLin' Γ) = I • Gamma0 →
        trace (Y.rho shape21 1 * Γ) = 0 ∧ trace (Y.rho shape21 (swap 0 1) * Γ) = 0 ∧
        trace (Y.rho shape21 (swap 1 2) * Γ) = 0 ∧ trace (Y.rho shape21 (swap 0 2) * Γ) = 0 ∧
        trace (Y.rho shape21 (List.formPerm [0, 1, 2]) * Γ) = -I * (Real.sqrt 3 : ℂ) ∧
        trace (Y.rho shape21 (List.formPerm [0, 2, 1]) * Γ) = I * (Real.sqrt 3 : ℂ)) ∧
      ∃ Γ : Matrix (Fin (Y.dim shape21)) (Fin (Y.dim shape21)) ℂ,
        (∀ σ : Perm (Fin 3), Γ * Y.rho shape21 σ = ((Perm.sign σ : ℤ) : ℂ) • (Y.rho shape21 σ * Γ)) ∧ Γ * Γ = 1 ∧
        LinearMap.toMatrix b' b' (Matrix.toLin' Γ) = I • Gamma0 :=
  NagataHigman.Proofs.ExV110R1.ex_lam21_orthogonal_full Y b hb

/-- **Lemma 4.3, proof** (lines 593-594): each `X^{(j)}` is a sum of transpositions, so `Γ` anticommutes with every `Y_j`. -/
theorem Gamma_anticomm_star (N : ℕ) (Y : YoungSystem F N) (lam : Shape N)
    (Γ : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F)
    (hΓ : ∀ σ : Perm (Fin N), Γ * Y.rho lam σ = ((Perm.sign σ : ℤ) : F) • (Y.rho lam σ * Γ)) (j : Fin N) :
    Γ * Y.rhoAlg lam (starElem F j) = -(Y.rhoAlg lam (starElem F j) * Γ) := by
  exact NagataHigman.Proofs.gamma_anticomm_star Y lam Γ hΓ j

/-- **Lemma 4.1** (lines 524-527): for `f ∈ I_ν`, `M = ρ_ν(f)`: `f` vanishes on every permutation with a fixed point
iff `M Y_j = -Y_j M` for all `j`, `Y_j = ρ_ν(X^{(j)})`. (`ν` is the shape of `n² - 1` in the box, see
`sec_4_1_nu`.) -/
theorem lem_4_1 (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1)) (lam : Shape (n ^ 2 - 1)) (hlam : lam.InBox n) (f : GrpAlg F (n ^ 2 - 1))
    (hf : f ∈ Y.block lam) :
    (∀ σ : Perm (Fin (n ^ 2 - 1)), (∃ j, σ j = j) → f.coeff σ = 0) ↔
      ∀ j : Fin (n ^ 2 - 1),
        Y.rhoAlg lam f * Y.rhoAlg lam (starElem F j) =
          -(Y.rhoAlg lam (starElem F j) * Y.rhoAlg lam f) := by
  exact NagataHigman.Proofs.lem_4_1_nu n hn Y lam hlam hf

/-- **Lemma 4.1, proof** (lines 531-534): `ρ(F[Stab(N)])` is the algebra of the operators that preserve both summands
of `Res_{Stab(N)} S^ν`, i.e. that commute with `Y_N = ρ(J_N)`. Lean: for every shape `λ`, the span of the `ρ_λ(σ)`,
`σ ∈ Stab(N)`, is the commutant of `ρ_λ(J_N)` (proved from the Young basis, not from (F2) for `S_{N-1}`: AUDIT, route
item 1). -/
theorem lem_4_1_span (N : ℕ) (Y : YoungSystem F N) (lam : Shape N) (top : Fin N) (htop : (top : ℕ) + 1 = N)
    (X : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) :
    X ∈ Submodule.span F ((Y.rho lam : Perm (Fin N) → Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) '' stab top) ↔
      X * Y.rhoAlg lam (jucysMurphy F top) = Y.rhoAlg lam (jucysMurphy F top) * X := by
  exact NagataHigman.Proofs.restriction_of_young Y lam top htop X

open Submodule in
/-- **Lemma 4.1, proof** (line 535): "By (*), $f$ vanishes on $\Stab(N)$ if and only if $\tr(ZM)=0$ for every
$Z\in\rho(F[\Stab(N)])$", with `M = ρ_λ(f)`. -/
theorem lem_4_1_trace (N : ℕ) (Y : YoungSystem F N) (lam : Shape N) (top : Fin N) (f : GrpAlg F N)
    (hf : f ∈ Y.block lam) :
    (∀ σ ∈ stab top, f.coeff σ = 0) ↔
      ∀ Z ∈ Submodule.span F ((Y.rho lam : Perm (Fin N) → _) '' stab top), trace (Z * Y.rhoAlg lam f) = 0 := by
  have hstar := sec_4_1_star F N Y lam f hf
  have hinv : ∀ σ ∈ stab top, σ⁻¹ ∈ stab top := fun σ hσ => by
    change σ⁻¹ top = top
    conv_lhs => rw [← (show σ top = top from hσ)]
    simp
  by_cases hd : Y.dim lam = 0
  · -- `0 × 0` matrices: every trace is `0`, and every coefficient is `0` by (*)
    have htr : ∀ X : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F, trace X = 0 := fun X => by
      rw [Matrix.trace]
      exact Finset.sum_eq_zero fun i _ => absurd i.2 (by omega)
    exact ⟨fun _ Z _ => htr _, fun _ σ _ => by rw [hstar, htr, mul_zero]⟩
  have hc : ((Y.dim lam : F) / (N.factorial : F)) ≠ 0 :=
    div_ne_zero (Nat.cast_ne_zero.mpr hd) (Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero N))
  constructor
  · intro h Z hZ
    induction hZ using Submodule.span_induction with
    | mem Z hZ =>
        obtain ⟨τ, hτ, rfl⟩ := hZ
        have h0 := h τ⁻¹ (hinv τ hτ)
        rw [hstar, inv_inv] at h0
        exact (mul_eq_zero.mp h0).resolve_left hc
    | zero => simp
    | add X W _ _ hX hW => rw [Matrix.add_mul, trace_add, hX, hW, add_zero]
    | smul c X _ hX => rw [Matrix.smul_mul, trace_smul, hX, smul_zero]
  · intro h σ hσ
    rw [hstar, h _ (subset_span ⟨σ⁻¹, hinv σ hσ, rfl⟩), mul_zero]

/-- **Lemma 4.1, proof** (lines 535-536): "These $Z$ are the operators $Q_+Z_1Q_++Q_-Z_2Q_-$ with
$Z_1,Z_2\in\End(S^\nu)$": on `ν`, the span of the `ρ(σ)`, `σ ∈ Stab(N)` (0-indexed: `top = N-1`), is exactly the set of
the `Q₊Z₁Q₊ + Q₋Z₂Q₋`. -/
theorem lem_4_1_Z_form (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1)) (lam : Shape (n ^ 2 - 1))
    (hlam : lam.InBox n) (top : Fin (n ^ 2 - 1)) (htop : (top : ℕ) + 1 = n ^ 2 - 1)
    (Z : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) :
    Z ∈ Submodule.span F
        ((Y.rho lam : Perm (Fin (n ^ 2 - 1)) → Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) '' stab top) ↔
      ∃ Z₁ Z₂ : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F,
        Z = projPlus Y lam top * Z₁ * projPlus Y lam top + projMinus Y lam top * Z₂ * projMinus Y lam top := by
  exact NagataHigman.Proofs.ExV110Rows.Z_form_proved n hn Y lam hlam top htop Z

omit [CharZero F] in
/-- **Lemma 4.1, proof** (lines 535-536): "$\tr(Q_\pm ZQ_\pm M)=\tr(ZQ_\pm MQ_\pm)$", for `Q₊ = (1+Y_N)/2`,
`Q₋ = (1-Y_N)/2` and all matrices `Z`, `M` (trace is cyclic; this holds for every `N`, `λ` and `top`). -/
theorem lem_4_1_Z_trace (N : ℕ) (Y : YoungSystem F N) (lam : Shape N) (top : Fin N)
    (Z M : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) :
    trace (projPlus Y lam top * Z * projPlus Y lam top * M) = trace (Z * (projPlus Y lam top * M * projPlus Y lam top)) ∧
      trace (projMinus Y lam top * Z * projMinus Y lam top * M) =
        trace (Z * (projMinus Y lam top * M * projMinus Y lam top)) := by
  have hcyc : ∀ P : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F, trace (P * Z * P * M) = trace (Z * (P * M * P)) := by
    intro P
    simp only [Matrix.mul_assoc]
    rw [Matrix.trace_mul_comm]
    simp only [Matrix.mul_assoc]
  exact ⟨hcyc _, hcyc _⟩

/-- **Lemma 4.1, proof** (lines 535-538), on `ν`: `f ∈ I_ν` vanishes on `Stab(N)` iff `Q₊ M Q₊ = 0 = Q₋ M Q₋`,
where `M = ρ_ν(f)` and `Q± = (1 ± Y_N)/2` (0-indexed: `top = N-1`). -/
theorem lem_4_1_blocks (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1)) (lam : Shape (n ^ 2 - 1))
    (hlam : lam.InBox n) (top : Fin (n ^ 2 - 1)) (htop : (top : ℕ) + 1 = n ^ 2 - 1) (f : GrpAlg F (n ^ 2 - 1))
    (hf : f ∈ Y.block lam) :
    (∀ σ ∈ stab top, f.coeff σ = 0) ↔
      projPlus Y lam top * Y.rhoAlg lam f * projPlus Y lam top = 0 ∧
        projMinus Y lam top * Y.rhoAlg lam f * projMinus Y lam top = 0 := by
  have hJ := NagataHigman.Proofs.starElem_top F top htop
  have hY0 := NagataHigman.Proofs.jucysMurphy_top_sq_nu n hn Y lam hlam top htop
  have hYs : Y.rhoAlg lam (starElem F top) * Y.rhoAlg lam (starElem F top) = 1 := by rw [hJ]; exact hY0
  rw [NagataHigman.Proofs.coeff_stab_iff Y lam top htop hY0 (NagataHigman.Proofs.restriction_of_young Y lam top htop)
    (NagataHigman.Proofs.dim_ne_zero Y lam) (fun g j => NagataHigman.Proofs.perm_conj_starElem F g j) hJ hf top]
  rw [show projPlus Y lam top = NagataHigman.Proofs.qP (Y.rhoAlg lam (starElem F top)) from rfl,
    show projMinus Y lam top = NagataHigman.Proofs.qM (Y.rhoAlg lam (starElem F top)) from rfl,
    NagataHigman.Proofs.blocks_iff_swaps_eigenspaces _ _ hYs, NagataHigman.Proofs.swaps_eigenspaces_iff_anticomm _ _ hYs]
  constructor
  · intro h
    exact eq_neg_of_add_eq_zero_left h
  · intro h
    rw [h, neg_add_cancel]

/-- **Lemma 4.1, proof** (lines 538-540), on `ν`: `Y_N` is an involution; as `Q±` project onto its `±1`-eigenspaces,
`Q₊ M Q₊ = 0 = Q₋ M Q₋` says that `M` maps each eigenspace of `Y_N` into the other, that is, `Y_N M = -M Y_N`
(for every operator `M` on `S^ν`). -/
theorem lem_4_1_eigen (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1)) (lam : Shape (n ^ 2 - 1))
    (hlam : lam.InBox n) (top : Fin (n ^ 2 - 1)) (htop : (top : ℕ) + 1 = n ^ 2 - 1)
    (M : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) :
    Y.rhoAlg lam (starElem F top) * Y.rhoAlg lam (starElem F top) = 1 ∧
      ((projPlus Y lam top * M * projPlus Y lam top = 0 ∧ projMinus Y lam top * M * projMinus Y lam top = 0) ↔
        ((∀ v, Y.rhoAlg lam (starElem F top) *ᵥ v = v →
            Y.rhoAlg lam (starElem F top) *ᵥ (M *ᵥ v) = -(M *ᵥ v)) ∧
          (∀ v, Y.rhoAlg lam (starElem F top) *ᵥ v = -v →
            Y.rhoAlg lam (starElem F top) *ᵥ (M *ᵥ v) = M *ᵥ v))) ∧
      (((∀ v, Y.rhoAlg lam (starElem F top) *ᵥ v = v →
            Y.rhoAlg lam (starElem F top) *ᵥ (M *ᵥ v) = -(M *ᵥ v)) ∧
          (∀ v, Y.rhoAlg lam (starElem F top) *ᵥ v = -v →
            Y.rhoAlg lam (starElem F top) *ᵥ (M *ᵥ v) = M *ᵥ v)) ↔
        Y.rhoAlg lam (starElem F top) * M = -(M * Y.rhoAlg lam (starElem F top))) := by
  have hYs : Y.rhoAlg lam (starElem F top) * Y.rhoAlg lam (starElem F top) = 1 := by
    rw [NagataHigman.Proofs.starElem_top F top htop]
    exact NagataHigman.Proofs.jucysMurphy_top_sq_nu n hn Y lam hlam top htop
  exact ⟨hYs, NagataHigman.Proofs.blocks_iff_swaps_eigenspaces _ M hYs,
    NagataHigman.Proofs.swaps_eigenspaces_iff_anticomm _ M hYs⟩

/-- **Lemma 4.2** (lines 547-549): for `n ≥ 2`, the only operators on `S^ν` commuting with every `Y_j` are the
scalars. Proved along the paper's chain (a)-(e): from `lem_4_2_e`, `𝒴 = End(S^ν)` and its commutant is `F·I`
(line 580). -/
theorem lem_4_2 (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1)) (lam : Shape (n ^ 2 - 1)) (hlam : lam.InBox n)
    (Z : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F)
    (hZ : ∀ j : Fin (n ^ 2 - 1), Z * Y.rhoAlg lam (starElem F j) =
      Y.rhoAlg lam (starElem F j) * Z) :
    ∃ c : F, Z = c • 1 := by
  exact NagataHigman.Proofs.lem_4_2_general_chain n hn Y lam hlam Z hZ

/-- **Lemma 4.2, proof, (a)** (line 555; `Q±` defined at line 522), on `ν` (0-indexed `top = N-1`):
`Q± = (1 ± Y_N)/2` (Defs/TwoCornerSteps.lean: `projPlus`, `projMinus`) are complementary idempotents lying in the algebra `𝒴` generated by the
`Y_j`. -/
theorem lem_4_2_a (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1)) (lam : Shape (n ^ 2 - 1))
    (hlam : lam.InBox n) (top : Fin (n ^ 2 - 1)) (htop : (top : ℕ) + 1 = n ^ 2 - 1) :
    projPlus Y lam top * projPlus Y lam top = projPlus Y lam top ∧
      projMinus Y lam top * projMinus Y lam top = projMinus Y lam top ∧
      projPlus Y lam top * projMinus Y lam top = 0 ∧ projPlus Y lam top + projMinus Y lam top = 1 ∧
      projPlus Y lam top ∈ Algebra.adjoin F (Set.range fun j => Y.rhoAlg lam (starElem F j)) ∧
      projMinus Y lam top ∈ Algebra.adjoin F (Set.range fun j => Y.rhoAlg lam (starElem F j)) := by
  have h4 : 4 ≤ n ^ 2 := by nlinarith
  exact NagataHigman.Proofs.lem_4_2_a_nu n hn Y lam hlam top ⟨n ^ 2 - 3, by omega⟩ htop
    (by show n ^ 2 - 3 + 2 = n ^ 2 - 1; omega)

/-- **Lemma 4.2, proof, (c)** (lines 557-559; `Q±` at line 522), with (T1): in a Young basis, `Y_N` acts by `+1` on
the `v_T` with `N` in the corner `a₊` (content `1`) and by `-1` on those with `N` in `a₋` (content `-1`), so `Q±` are
the coordinate projections onto the span of the `v_T` with `N` in `a±`. -/
theorem lem_4_2_a_eigen (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1)) (lam : Shape (n ^ 2 - 1))
    (hlam : lam.InBox n) (b : Module.Basis (SYT lam) F (Fin (Y.dim lam) → F))
    (hb : ∀ (T : SYT lam) (k : Fin (n ^ 2 - 1)),
      Y.rhoAlg lam (jucysMurphy F k) *ᵥ b T = ((T.content k : ℤ) : F) • b T)
    (top : Fin (n ^ 2 - 1)) (htop : (top : ℕ) + 1 = n ^ 2 - 1) (T : SYT lam) :
    (T.content top = 1 ∧ projPlus Y lam top *ᵥ b T = b T ∧ projMinus Y lam top *ᵥ b T = 0) ∨
      (T.content top = -1 ∧ projPlus Y lam top *ᵥ b T = 0 ∧ projMinus Y lam top *ᵥ b T = b T) := by
  exact NagataHigman.Proofs.lem_4_2_a_nu_eigen n hn Y lam hlam b hb top htop T

omit [CharZero F] in
/-- **Lemma 4.2, proof, (b)** (line 556): `X^{(N-1)} = J_{N-1} + (N-1, N)`, so `Y_{N-1} = ρ(J_{N-1} + s)` (0-indexed:
`k = N-2`, `top = N-1`). -/
theorem lem_4_2_b (N : ℕ) (k top : Fin N) (hk : (k : ℕ) + 1 = top) (htop : (top : ℕ) + 1 = N) :
    starElem F k = jucysMurphy F k + perm F (swap k top) := by
  exact NagataHigman.Proofs.lem_4_2_b_proved N k top hk htop

/-- **Lemma 4.2, proof, (c)** (lines 557-566): `D := Q₊ Y_{N-1} Q₊ + Q₋ Y_{N-1} Q₋` (Defs/TwoCornerSteps.lean,
`stepD`) satisfies `D v_T = (c_T(N-1) + 1/(c_T(N) - c_T(N-1))) v_T` (0-indexed: `k = N-2`, `top = N-1`). -/
theorem lem_4_2_c (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1)) (lam : Shape (n ^ 2 - 1))
    (hlam : lam.InBox n) (b : Module.Basis (SYT lam) F (Fin (Y.dim lam) → F))
    (hb : ∀ (T : SYT lam) (k : Fin (n ^ 2 - 1)),
      Y.rhoAlg lam (jucysMurphy F k) *ᵥ b T = ((T.content k : ℤ) : F) • b T)
    (top k : Fin (n ^ 2 - 1)) (htop : (top : ℕ) + 1 = n ^ 2 - 1) (hk : (k : ℕ) + 2 = n ^ 2 - 1) (T : SYT lam) :
    stepD Y lam k top *ᵥ b T =
      (((T.content k : ℤ) : F) + 1 / (((T.content top : ℤ) : F) - ((T.content k : ℤ) : F))) • b T := by
  exact NagataHigman.Proofs.lem_4_2_c_nu n hn Y lam hlam b hb top k htop hk T

/-- **Lemma 4.2, proof, (c)** (lines 560-561): in a standard tableau, the cell of the largest entry is always a
removable corner — a cell of `λ` with no cell to its right and none below it (every shape `λ`; 0-indexed `top = N-1`). -/
theorem lem_4_2_c_top_corner (N : ℕ) (lam : Shape N) (T : SYT lam) (top : Fin N) (htop : (top : ℕ) + 1 = N) :
    T.pos top ∈ lam.diagram.cells ∧ ((T.pos top).1, (T.pos top).2 + 1) ∉ lam.diagram.cells ∧
      ((T.pos top).1 + 1, (T.pos top).2) ∉ lam.diagram.cells := by
  exact ⟨T.pos_mem top, (NagataHigman.Proofs.top_corner T top htop).2, (NagataHigman.Proofs.top_corner T top htop).1⟩

/-- **Lemma 4.2, proof, (d)** (lines 567-576): `N` is in a corner of content `u = ±1` and `N-1` in a removable corner of
`ν` minus that cell, of content `-u` or `2u` (the four pairs `(c_T(N-1), c_T(N))`); in both cases
`c_T(N-1)(c_T(N) - c_T(N-1)) = -2`. Hence `D = ½ ρ(J_{N-1})` (`ρ(J_{N-1}) = 2D`), so `ρ(J_{N-1}) ∈ 𝒴` and
`ρ(s) = Y_{N-1} - 2D ∈ 𝒴`, `s = (N-1 N)` (0-indexed: `k = N-2`, `top = N-1`). -/
theorem lem_4_2_d (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1)) (lam : Shape (n ^ 2 - 1))
    (hlam : lam.InBox n) (top k : Fin (n ^ 2 - 1)) (htop : (top : ℕ) + 1 = n ^ 2 - 1)
    (hk : (k : ℕ) + 2 = n ^ 2 - 1) :
    (∀ T : SYT lam, (T.content k, T.content top) ∈ ({(-1, 1), (2, 1), (1, -1), (-2, -1)} : Set (ℤ × ℤ))) ∧
      (∀ T : SYT lam, T.content k * (T.content top - T.content k) = -2) ∧
      Y.rhoAlg lam (jucysMurphy F k) = (2 : F) • stepD Y lam k top ∧
      Y.rho lam (swap k top) = Y.rhoAlg lam (starElem F k) - (2 : F) • stepD Y lam k top ∧
      Y.rhoAlg lam (jucysMurphy F k) ∈ Algebra.adjoin F (Set.range fun j => Y.rhoAlg lam (starElem F j)) ∧
      Y.rho lam (swap k top) ∈ Algebra.adjoin F (Set.range fun j => Y.rhoAlg lam (starElem F j)) := by
  obtain ⟨h1, -, h3, h4, h5⟩ := NagataHigman.Proofs.lem_4_2_d_nu n hn Y lam hlam top k htop hk
  refine ⟨h1, fun T => ?_, h3, ?_, h4, h5⟩
  · have hT := h1 T
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Prod.mk.injEq] at hT
    rcases hT with ⟨ha, hb⟩ | ⟨ha, hb⟩ | ⟨ha, hb⟩ | ⟨ha, hb⟩ <;> rw [ha, hb] <;> norm_num
  · rw [← h3, NagataHigman.Proofs.lem_4_2_b_proved (F := F) _ k top (by omega) htop, map_add,
      NagataHigman.Proofs.YoungSystem.rhoAlg_perm, add_sub_cancel_left]

/-- **Lemma 4.2, proof, (d)** (line 575): by (c), `D v_T = ½ c_T(N-1) v_T` for every `T` (0-indexed: `k = N-2`,
`top = N-1`). -/
theorem lem_4_2_d_eigen (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1)) (lam : Shape (n ^ 2 - 1))
    (hlam : lam.InBox n) (b : Module.Basis (SYT lam) F (Fin (Y.dim lam) → F))
    (hb : ∀ (T : SYT lam) (k : Fin (n ^ 2 - 1)),
      Y.rhoAlg lam (jucysMurphy F k) *ᵥ b T = ((T.content k : ℤ) : F) • b T)
    (top k : Fin (n ^ 2 - 1)) (htop : (top : ℕ) + 1 = n ^ 2 - 1) (hk : (k : ℕ) + 2 = n ^ 2 - 1) (T : SYT lam) :
    stepD Y lam k top *ᵥ b T = ((1 / 2 : F) * ((T.content k : ℤ) : F)) • b T := by
  have h3 := (NagataHigman.Proofs.lem_4_2_d_nu n hn Y lam hlam top k htop hk).2.2.1
  have hD : stepD Y lam k top = (1 / 2 : F) • Y.rhoAlg lam (jucysMurphy F k) := by
    rw [h3, smul_smul]
    norm_num
  rw [hD, Matrix.smul_mulVec, hb T k, smul_smul]

/-- **Lemma 4.2, proof, (d)** (lines 571-573): "Hence the coefficient in (c) is
$c_T(N-1)+\frac{1}{c_T(N)-c_T(N-1)}=c_T(N-1)-\frac{c_T(N-1)}{2}=\frac12\,c_T(N-1)$" (0-indexed: `k = N-2`,
`top = N-1`; contents of standard tableaux of `ν` only, no representation). -/
theorem lem_4_2_d_display (n : ℕ) (hn : 2 ≤ n) (lam : Shape (n ^ 2 - 1)) (hlam : lam.InBox n)
    (top k : Fin (n ^ 2 - 1)) (htop : (top : ℕ) + 1 = n ^ 2 - 1) (hk : (k : ℕ) + 2 = n ^ 2 - 1) (T : SYT lam) :
    ((T.content k : ℤ) : F) + 1 / (((T.content top : ℤ) : F) - ((T.content k : ℤ) : F)) =
        ((T.content k : ℤ) : F) - ((T.content k : ℤ) : F) / 2 ∧
      ((T.content k : ℤ) : F) - ((T.content k : ℤ) : F) / 2 = (1 / 2 : F) * ((T.content k : ℤ) : F) := by
  exact NagataHigman.Proofs.ExV110Rows.d_display_proved n hn lam hlam top k htop hk T

/-- **Lemma 4.2(d), example** (lines 576-578): "For example, for $n=3$ (so $\nu=(3,3,2)$ and $N=8$), if $8$ is in
$a_+=(2,3)$, then $7$ is in $(1,3)$ or in $a_-=(3,2)$, of contents $2$ and $-1$, and
$c_T(7)\bigl(c_T(8)-c_T(7)\bigr)$ is $2\cdot(1-2)=-2$ or $(-1)\cdot(1+1)=-2$." (Lean, 0-indexed: entry `7` at `(1, 2)`;
entry `6` at `(0, 2)` or `(2, 1)`.) -/
theorem lem_4_2_d_example (lam : Shape 8) (h : lam.InBox 3) (T : SYT lam) (h7 : T.pos 7 = (1, 2)) :
    ((T.pos 6 = (0, 2) ∧ T.content 6 = 2) ∨ (T.pos 6 = (2, 1) ∧ T.content 6 = -1)) ∧
      T.content 6 * (T.content 7 - T.content 6) = -2 := by
  exact NagataHigman.Proofs.ExV110Small.ex_lem_4_2_d lam h T h7

/-- **Lemma 4.2, proof, (e)** (lines 579-580), on `ν`: `ρ(s) ∈ 𝒴` (step (d)); conjugating, `ρ(t) ∈ 𝒴` for every
transposition `t`; so `𝒴 ⊇ ρ(F[S_N]) = End(S^ν)` (F6): the stars generate all of `End(S^ν)`. -/
theorem lem_4_2_e (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1)) (lam : Shape (n ^ 2 - 1))
    (hlam : lam.InBox n) :
    Algebra.adjoin F (Set.range fun j => Y.rhoAlg lam (starElem F j)) = ⊤ := by
  exact NagataHigman.Proofs.lem_4_2_e_proved n hn Y lam hlam

/-- **Lemma 4.3, proof** (lines 592-593): `ν` is self-conjugate. -/
theorem lem_4_3_selfconj (n : ℕ) (hn : 2 ≤ n) (lam : Shape (n ^ 2 - 1)) (h : lam.InBox n) :
    lam.conjugate = lam := by
  exact NagataHigman.Proofs.thm_4_4_selfconj_proved n hn lam h

/-- **Lemma 4.3, proof** (lines 596-602; for `n = 3`, `h(ν) = (5,3)`): `h(ν) = (2n-1, 2n-3, …, 5, 3)`. -/
theorem lem_4_3_hooks (n : ℕ) (hn : 2 ≤ n) (lam : Shape (n ^ 2 - 1)) (h : lam.InBox n) :
    lam.diagonalHooks = (Multiset.range (n - 1)).map (fun i => 2 * i + 3) := by
  exact NagataHigman.Proofs.thm_4_4_hooks_proved n hn lam h

/-- **Lemma 4.3, proof** (lines 591-595): for `f ∈ C_N ∩ I_ν` and any invertible `Γ` with `Γρ(σ) = sgn(σ)ρ(σ)Γ`,
`ΓM` (`M = ρ_ν(f)`) commutes with every `Y_j` (Lemma 4.1 and `Gamma_anticomm_star`), so it is a scalar (Lemma 4.2), and
`M = cΓ`. Over every field of characteristic 0 (no rescaling `Γ² = I` is needed). -/
theorem lem_4_3_M_eq (n : ℕ) (hn : 2 ≤ n) (Y : YoungSystem F (n ^ 2 - 1)) (lam : Shape (n ^ 2 - 1))
    (hlam : lam.InBox n) (Γ : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) F) (hΓu : IsUnit Γ)
    (hΓ : ∀ σ : Perm (Fin (n ^ 2 - 1)), Γ * Y.rho lam σ = ((Perm.sign σ : ℤ) : F) • (Y.rho lam σ * Γ))
    (f : GrpAlg F (n ^ 2 - 1)) (hf : f ∈ cycleSpan F (n ^ 2 - 1) ⊓ Y.block lam) :
    ∃ c : F, Y.rhoAlg lam f = c • Γ := by
  exact NagataHigman.Proofs.rhoAlg_nu_eq_smul_gamma n hn Y lam hlam Γ hΓu hΓ (Submodule.mem_inf.1 hf).1
    (Submodule.mem_inf.1 hf).2

omit [CharZero F] in
/-- **Lemma 4.3, proof** (line 595): "`M = κΓ`, as `Γ² = id`": if `Γ² = 1` and `ΓM = κ·1`, then `M = κΓ`. -/
theorem lem_4_3_M_eq_normalized {n : Type*} [Fintype n] [DecidableEq n] (Γ M : Matrix n n F) (κ : F)
    (hsq : Γ * Γ = 1) (hM : Γ * M = κ • 1) : M = κ • Γ :=
  NagataHigman.Proofs.ExV110R1.M_eq_of_sq_one Γ M κ hsq hM

/-- **Lemma 4.3, proof** (line 595): "By (*), $f(\sigma)=\kappa'\psi(\sigma^{-1})$": if `ρ_λ(f) = κΓ` then
`f(σ) = (κ f^λ/N!) tr(ρ_λ(σ⁻¹)Γ)` (over `ℂ`, `N = n² - 1`, `λ` in the `n × n` box). -/
theorem lem_4_3_fourier (n : ℕ) (_hn : 2 ≤ n) (Y : YoungSystem ℂ (n ^ 2 - 1)) (lam : Shape (n ^ 2 - 1))
    (_hlam : lam.InBox n) (Γ : Matrix (Fin (Y.dim lam)) (Fin (Y.dim lam)) ℂ) (κ : ℂ) (f : GrpAlg ℂ (n ^ 2 - 1))
    (hf : f ∈ Y.block lam) (hM : Y.rhoAlg lam f = κ • Γ) (σ : Perm (Fin (n ^ 2 - 1))) :
    f.coeff σ = (κ * (Y.dim lam : ℂ) / ((n ^ 2 - 1).factorial : ℂ)) * trace (Y.rho lam σ⁻¹ * Γ) := by
  rw [sec_4_1_star ℂ (n ^ 2 - 1) Y lam f hf σ, hM, Matrix.mul_smul, trace_smul, smul_eq_mul]
  ring

/-- **Lemma 4.3, proof** (lines 595-596), over ℂ: for `f ∈ C_N ∩ I_ν`, `f(σ) = κ' ψ(σ⁻¹)`, so by (T3) `f` vanishes on
every permutation whose cycle type is not `h(ν)` (`n ≥ 3`; any Young system over ℂ with Frobenius' splitting). -/
theorem lem_4_3_vanish (n : ℕ) (hn : 3 ≤ n) (Y : YoungSystem ℂ (n ^ 2 - 1)) (hsplit : AlternatingSplit Y)
    (lam : Shape (n ^ 2 - 1)) (hlam : lam.InBox n) (f : GrpAlg ℂ (n ^ 2 - 1))
    (hC : f ∈ cycleSpan ℂ (n ^ 2 - 1)) (hf : f ∈ Y.block lam) (σ : Perm (Fin (n ^ 2 - 1)))
    (hσ : σ.partition.parts ≠ lam.diagonalHooks) : f.coeff σ = 0 := by
  exact NagataHigman.Proofs.coeff_nu_eq_zero_off_hooks n hn Y hsplit lam hlam hC hf σ hσ

/-- **Lemma 4.3, proof** (lines 602-603): for `n ≥ 3` the type `h(ν)` has `n - 1 ≥ 2` cycles, so it is not the type of
an `N`-cycle. -/
theorem lem_4_3_not_cycle (n : ℕ) (hn : 3 ≤ n) (lam : Shape (n ^ 2 - 1)) (hlam : lam.InBox n) :
    Multiset.card lam.diagonalHooks = n - 1 ∧ 2 ≤ n - 1 ∧
      ∀ σ : Perm (Fin (n ^ 2 - 1)), σ.partition.parts = lam.diagonalHooks → ¬ IsFullCycle σ := by
  have hh := NagataHigman.Proofs.thm_4_4_hooks_proved n (by omega) lam hlam
  refine ⟨by rw [hh, Multiset.card_map, Multiset.card_range], by omega, fun σ hσ => ?_⟩
  exact (NagataHigman.Proofs.perm_hooks_sign_proved n hn σ (by rw [hσ, hh])).2

/-- **Lemma 4.3** (lines 586-588), over ℂ as in Section 4, for every Young system over ℂ: for every `n ≥ 3`, `C_{n²-1} ∩ B_n^{(n²-1)} = 0`. -/
theorem lem_4_3 (n : ℕ) (hn : 3 ≤ n) (Y : YoungSystem ℂ (n ^ 2 - 1)) :
    cycleSpan ℂ (n ^ 2 - 1) ⊓ Y.boxSum n = ⊥ := by
  rw [← Submodule.finrank_eq_zero,
    NagataHigman.Proofs.finrank_inf_boxSum_indep ℂ n (n ^ 2 - 1) Y (youngSystemC (n ^ 2 - 1)), Submodule.finrank_eq_zero]
  exact NagataHigman.Proofs.thm_4_4_general n hn (youngSystemC (n ^ 2 - 1)) (youngSystemC_split (n ^ 2 - 1))

/-- **Theorem B** (lines 138-140; proof lines 606-608): for every `n ≥ 3`, `x_1 ⋯ x_{n²-2} ∈ T`, i.e.
`d(n) ≤ n² - 2`. The paper's route: "Lemma 4.3 and Proposition 2.1 with `m = n²-2 ≥ n` give `d(n) ≤ n²-2` over `ℂ`, and
hence over every field `F` of characteristic zero by (F1)" — over `ℂ` by `thm_B_mem_complex`, then the field
independence of `dim W_{n,m}` (`F1_field`, Proofs/FieldIndep.lean). -/
theorem thm_B (n : ℕ) (hn : 3 ≤ n) :
    firstLettersProd F (n ^ 2 - 2) ∈ TIdeal F n ∧ nhIndex F n ≤ n ^ 2 - 2 := by
  have h9 : 9 ≤ n ^ 2 := by nlinarith
  have hm : 1 ≤ n ^ 2 - 2 := by omega
  have hC := NagataHigman.Proofs.thm_B_mem_complex n hn (youngSystemC (n ^ 2 - 2 + 1))
    (youngSystemC_split (n ^ 2 - 2 + 1))
  have hF : firstLettersProd F (n ^ 2 - 2) ∈ TIdeal F n :=
    (NagataHigman.Proofs.FieldIndep.mem_TIdeal_iff_finrank F n _ hm).2
      (((NagataHigman.Proofs.FieldIndep.field_indep F ℂ n (by omega)).1 _ hm).trans
        ((NagataHigman.Proofs.FieldIndep.mem_TIdeal_iff_finrank ℂ n _ hm).1 hC))
  exact ⟨hF, NagataHigman.Proofs.nhIndex_le F hm hF⟩

/-- **Theorem B**, algebra form: every associative, not necessarily unital, `F`-algebra with `x^n = 0` for all `x`
satisfies `x_1 x_2 ⋯ x_{n²-2} = 0` (`n ≥ 3`). -/
theorem thm_B_algebra (n : ℕ) (hn : 3 ≤ n) (R : Type*) [NonUnitalRing R] [Module F R] [IsScalarTower F R R]
    [SMulCommClass F R R] (hnil : ∀ x : R, nuPow x n = 0) (xs : Fin (n ^ 2 - 2) → R) :
    tupleProd (n ^ 2 - 2) xs = 0 := by
  have h9 : 9 ≤ n ^ 2 := by nlinarith
  exact NagataHigman.Proofs.tupleProd_eq_zero_of_mem (F := F) (by omega) (thm_B F n hn).1 hnil xs

/-- **Remark 4.4** (lines 611-615): for `n = 2`, `f = (1 2 3) - (1 3 2)` is a nonzero element of
`C_3 ∩ I_{(2,1)} = C_3 ∩ B_2^{(3)}`. -/
theorem rem_4_4_element (Y : YoungSystem F 3) :
    perm F (finRotate 3) - perm F (finRotate 3)⁻¹ ∈ cycleSpan F 3 ⊓ Y.boxSum 2 ∧
      perm F (finRotate 3) - perm F (finRotate 3)⁻¹ ≠ 0 := by
  exact NagataHigman.Proofs.rem_4_5_element_of Y

/-- **Remark 4.4** (lines 614-615; Section 1.3, line 142): `d(2) = 3`. -/
theorem rem_4_4_index : nhIndex F 2 = 3 := by
  have hup : nhIndex F 2 ≤ 3 := (thm_A F 2 le_rfl).2
  have hnot : ¬ nhIndex F 2 ≤ 2 := by
    intro hle
    have hbot := (prop_2_1_iff F 2 2 (by norm_num) (by norm_num) (youngSystem F 3)).1
      ((F0_index_le_iff F 2 2 (by norm_num) (by norm_num)).1 hle)
    obtain ⟨hf, hne0⟩ := rem_4_4_element F (youngSystem F 3)
    have hmem : perm F (finRotate 3) - perm F (finRotate 3)⁻¹ ∈ (⊥ : Submodule F (GrpAlg F 3)) := hbot ▸ hf
    exact hne0 ((Submodule.mem_bot F).1 hmem)
  omega

/-! ## Section 1: the corollary and the statements of the abstract and the introduction -/

/-- **Abstract; Section 1, table and list** (lines 54, 86-87, 101-102): `d(6) ≤ 34`. -/
theorem intro_d6 : firstLettersProd F 34 ∈ TIdeal F 6 ∧ nhIndex F 6 ≤ 34 := by
  exact thm_B F 6 (by norm_num)

/-- **Corollary 1.1** (lines 149-152): for `n ≥ 3` and every `k ≥ 1`, the algebra of polynomial functions on `k`-tuples
of `n × n` matrices over `F` that are invariant under simultaneous conjugation is generated by the traces
`tr(X_{i_1} ⋯ X_{i_r})` with `1 ≤ r ≤ n² - 2` (Defs/MatrixInvariants.lean; `r = 0` would add only the constant `n`).
From Theorem B over the algebraic closure `K` of `F` and the cited theorem of Procesi and Formanek
(Cited/MatrixInvariants.lean, stated over an algebraically closed field as in [Dr95]), then base change back to `F`
(Proofs/MatrixInvariants.lean). -/
theorem cor_1_1 (n k : ℕ) (hn : 3 ≤ n) (hk : 1 ≤ k) :
    matInvariants F n k = (Algebra.adjoin F (tracePolys F n k (n ^ 2 - 2)) : Set (MatPoly F n k)) := by
  have h9 : 9 ≤ n ^ 2 := by nlinarith
  exact NagataHigman.Proofs.matInvariants_eq_adjoin_of_ext (K := AlgebraicClosure F) (n ^ 2 - 2)
    (NagataHigman.Cited.procesi_formanek (AlgebraicClosure F) n k (n ^ 2 - 2) (by omega) hk (by omega)
      (thm_B (AlgebraicClosure F) n hn).1)

/-- **Corollary 1.1** (line 150), the modelling: over `F` (characteristic 0, hence infinite) a polynomial in the
`k n²` matrix entries is determined by its function on `k`-tuples of `n × n` matrices, so `MatPoly F n k` IS the
algebra of polynomial functions. -/
theorem cor_1_1_polyfun (n k : ℕ) :
    Function.Injective fun (p : MatPoly F n k) (X : Fin k → Matrix (Fin n) (Fin n) F) =>
      MvPolynomial.eval (tupleCoords X) p := by
  exact NagataHigman.Proofs.matPoly_eval_injective

/-- **Corollary 1.1** (lines 149-152), literally on FUNCTIONS: every polynomial function `f` on `k`-tuples of `n × n`
matrices over `F` that is invariant under simultaneous conjugation lies in the algebra of functions generated by the
trace functions `X ↦ tr(X_{i_1} ⋯ X_{i_r})`, `1 ≤ r ≤ n² - 2`. -/
theorem cor_1_1_functions (n k : ℕ) (hn : 3 ≤ n) (hk : 1 ≤ k)
    (f : (Fin k → Matrix (Fin n) (Fin n) F) → F)
    (hpoly : ∃ p : MatPoly F n k, ∀ X, f X = MvPolynomial.eval (tupleCoords X) p)
    (hinv : ∀ (g : GL (Fin n) F) X, f (fun i => (g : Matrix (Fin n) (Fin n) F) * X i *
      ((g⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F)) = f X) :
    f ∈ Algebra.adjoin F {t | ∃ w : List (Fin k), 1 ≤ w.length ∧ w.length ≤ n ^ 2 - 2 ∧
      t = fun X => Matrix.trace (w.map X).prod} := by
  obtain ⟨p, hp⟩ := hpoly
  let Φ : MatPoly F n k →ₐ[F] ((Fin k → Matrix (Fin n) (Fin n) F) → F) :=
    Pi.algHom F _ fun X => MvPolynomial.aeval (tupleCoords X)
  have hpinv : p ∈ matInvariants F n k := fun g X => by rw [← hp, ← hp]; exact hinv g X
  rw [cor_1_1 F n k hn hk] at hpinv
  have hmem : Φ p ∈ (Algebra.adjoin F (tracePolys F n k (n ^ 2 - 2))).map Φ := ⟨p, hpinv, rfl⟩
  rw [AlgHom.map_adjoin] at hmem
  have hf : f = Φ p := funext fun X => by simp [Φ, hp, MvPolynomial.aeval_eq_eval]
  rw [hf]
  refine Algebra.adjoin_mono ?_ hmem
  rintro _ ⟨q, ⟨w, h1, h2, rfl⟩, rfl⟩
  exact ⟨w, h1, h2, funext fun X => by
    simp [Φ, MvPolynomial.aeval_eq_eval, NagataHigman.Proofs.eval_tracePoly]⟩

end NagataHigman.Paper

