theorem ex_lam21_tableaux : (∀ T : SYT shape21, T = T12 ∨ T = T13) ∧ T12 ≠ T13 ∧
    T12.content 1 = 1 ∧ T12.content 2 = -1 ∧ T13.content 1 = -1 ∧ T13.content 2 = 1 :=
