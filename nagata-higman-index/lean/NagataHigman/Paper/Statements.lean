          θ = firstReturn (wordCycle (1 : Perm (Fin 4))) {0, 2, 3} ^ 2)) ∧
    Finset.univ.filter (fun π : Perm (Fin 5) => π.support ⊆ {0, 2, 3} ∧
        (firstReturn (wordCycle (1 : Perm (Fin 4))) {0, 2, 3} * π).IsCycleOn
          ((({0, 2, 3} : Finset (Fin 5))) : Set (Fin 5))) =
      {1, firstReturn (wordCycle (1 : Perm (Fin 4))) {0, 2, 3}} ∧
    wordCycle (1 : Perm (Fin 4)) * firstReturn (wordCycle (1 : Perm (Fin 4))) {0, 2, 3} =
      List.formPerm [4, 0, 3, 1, 2] ∧
    wordCycle (1 : Perm (Fin 4)) * firstReturn (wordCycle (1 : Perm (Fin 4))) {0, 2, 3} =
      wordCycle (⟨![0, 3, 1, 2], ![0, 2, 3, 1], by decide, by decide⟩ : Perm (Fin 4)) := by
  exact NagataHigman.Proofs.ExV110Small.ex_step6_bar

/-- **Proposition 2.1, step (7)** (lines 386-387): `I^⊥ = A`. -/
theorem prop_2_1_step7_perp (N n : ℕ) (Y : YoungSystem F N) (h : n + 1 ≤ N) (f : GrpAlg F N) :
    (∀ a ∈ altIdeal F N n, coeffPairing F f a = 0) ↔ f ∈ Y.rowSum n := by
  exact NagataHigman.Proofs.prop21_step7_perp Y n h f

/-- **Proposition 2.1, step (7)** (lines 387-388): `C_N ∩ A = C_N ∩ B_n`. -/
theorem prop_2_1_step7_box (N n : ℕ) (Y : YoungSystem F N) :
    cycleSpan F N ⊓ Y.rowSum n = cycleSpan F N ⊓ Y.boxSum n := by
  exact NagataHigman.Proofs.prop21_step7_box Y n

/-- **Proposition 2.1, step (7)** (line 388): "since $\ell(\lambda)=\lambda'_1$": the number of rows of `λ` is the
length of the first row of `λ'`. -/
theorem prop_2_1_step7_length (N : ℕ) (lam : Shape N) : lam.numRows = Shape.firstRow lam.conjugate := by
  refine eq_of_forall_lt_iff fun c => ?_
  have h := NagataHigman.Proofs.lt_numRows_conjugate_iff lam.conjugate c
  rwa [Nat.Partition.conjugate_conjugate] at h

/-- **Proposition 2.1, step (7)** (lines 384-388), its conclusion: `C_N ∩ Φ(W_{n,m})^⊥ = C_N ∩ B_n`. -/
theorem prop_2_1_step7_dual (n m : ℕ) (hn : 1 ≤ n) (hnm : n ≤ m) (Y : YoungSystem F (m + 1)) (c : GrpAlg F (m + 1))
    (hc : c ∈ cycleSpan F (m + 1)) :
    (∀ x ∈ ((multilinIdentities F n m).comap (wordLin F m)).map (cycleLin F m), coeffPairing F c x = 0) ↔
      c ∈ Y.boxSum n := by
  exact NagataHigman.Proofs.prop21_step7_dual n m hn hnm Y c hc

