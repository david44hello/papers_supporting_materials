/-! ## Section 1.2: bounds and known values -/

/-- **Section 1.2** (line 124): "Kuzmin's lower bound \cite{Ku75} comes from the word $x_2x_1x_2x_1^2\cdots x_2x_1^{n-1}$:
it has degree \mbox{$n(n+1)/2-1$}" (`kuzminWord`; the paper's letters `x_2`, `x_1` are Lean's `1`, `0`). -/
theorem intro_kuzmin_degree (n : ℕ) (hn : 1 ≤ n) : (kuzminWord n).length = n * (n + 1) / 2 - 1 := by
  exact NagataHigman.Proofs.ExV110R1c.kuzmin_degree_proved n hn

omit [CharZero F] in
/-- **Section 1.2** (line 125): "$x_1x_2\cdots x_{n(n+1)/2-1}$, which maps onto it under an endomorphism". -/
theorem intro_kuzmin_endo (n : ℕ) (hn : 2 ≤ n) :
    ∃ φ : FreeNUAlg F →ₙₐ[F] FreeNUAlg F, φ (firstLettersProd F (n * (n + 1) / 2 - 1)) = wordOf F (kuzminWord n) := by
  exact NagataHigman.Proofs.ExV110R1c.kuzmin_endo_proved F n hn

omit [CharZero F] in
/-- **Section 1.2** (lines 124-125): "... does not lie in the T-ideal of $x^n$ (see \cite[Thm.~1.7]{Do18}), so neither
does $x_1x_2\cdots x_{n(n+1)/2-1}$". The cited fact (Kuzmin's word is not in the T-ideal; [Ku75], [Do18, Thm 1.7]) is
the hypothesis `hK`; Lean proves the step from it to `x_1 ⋯ x_{n(n+1)/2-1} ∉ T`. -/
theorem intro_kuzmin_reduction (n : ℕ) (hn : 2 ≤ n) (hK : wordOf F (kuzminWord n) ∉ TIdeal F n) :
    firstLettersProd F (n * (n + 1) / 2 - 1) ∉ TIdeal F n := by
  exact NagataHigman.Proofs.ExV110R1c.kuzmin_reduction_proved F n hn hK

/-! ## Section 1.4: outline -/

open NagataHigman.Proofs.ExV110 in
/-- **Section 1.4** (line 180): "For example, for `n = 2` only `(2,1)` fits when `N = 3`." (`shape21` is the partition
with parts `{2, 1}`; "fits" = lies in the `2 × 2` box.) -/
theorem sec1_box_examples : shape21.parts = {2, 1} ∧ ∀ lam : Shape 3, lam.InBox 2 ↔ lam = shape21 :=
  ⟨rfl, inBox_two_iff⟩

/-- **Section 1.4, outline (i); Lemma 3.1, proof; §4.1** (lines 187-188, 429, 444): "The square has only one removable
corner": the square `(n^n)` has exactly one removable corner, `(n,n)` (0-indexed `(n-1, n-1)`) — the only cell with no
cell to its right and none below it. -/
theorem square_one_corner (n : ℕ) (hn : 1 ≤ n) (lam : Shape (n ^ 2)) (h : lam.InBox n) (c : ℕ × ℕ) :
    (c ∈ lam.diagram.cells ∧ (c.1, c.2 + 1) ∉ lam.diagram.cells ∧ (c.1 + 1, c.2) ∉ lam.diagram.cells) ↔
      c = (n - 1, n - 1) :=
  NagataHigman.Proofs.ExV110R1.square_one_corner n hn lam h c

/-- **Section 1.4, outline (i)** (line 189): "Hence an element of the block $I_{(n^n)}$ is determined by its
coefficients on $S_{N-1}$": two elements of the block of the square that agree on every permutation fixing the last point
are equal. -/
theorem sec1_square_determined (n : ℕ) (hn : 1 ≤ n) (Y : YoungSystem F (n ^ 2)) (lam : Shape (n ^ 2))
    (hlam : lam.InBox n) (last : Fin (n ^ 2)) (hlast : (last : ℕ) + 1 = n ^ 2) (f g : GrpAlg F (n ^ 2))
    (hf : f ∈ Y.block lam) (hg : g ∈ Y.block lam)
    (hfg : ∀ σ : Perm (Fin (n ^ 2)), σ last = last → f.coeff σ = g.coeff σ) : f = g := by
  exact NagataHigman.Proofs.ExV110Rows.square_determined_proved n hn Y lam hlam last hlast f g hf hg hfg

/-! ## Section 2.1: the standard facts (F0)-(F7) -/

omit [CharZero F] in
/-- **§2, the T-ideal** (lines 220-221, 112): "it does not depend on the choice of $x$": the T-ideal generated by
`x_i^n` is the same for every letter `x_i` (`TIdeal F n` uses `x_0`). -/
theorem TIdeal_letter_indep (n i : ℕ) :
    sInf {S | IsTIdeal F S ∧ nuPow (letter F i) n ∈ S} = TIdeal F n := by
  show sInf _ = sInf _
  congr 1
  ext S
  -- the endomorphism swapping the letters `x_0` and `x_i` maps each generator to the other
  let φ := NagataHigman.Proofs.freeLift F (fun j => letter F (Equiv.swap 0 i j))
  constructor
  · rintro ⟨hS, h⟩
    refine ⟨hS, ?_⟩
    have := hS.endo φ _ h
    rwa [NagataHigman.Proofs.map_nuPow, NagataHigman.Proofs.freeLift_letter, Equiv.swap_apply_right] at this
  · rintro ⟨hS, h⟩
    refine ⟨hS, ?_⟩
    have := hS.endo φ _ h
    rwa [NagataHigman.Proofs.map_nuPow, NagataHigman.Proofs.freeLift_letter, Equiv.swap_apply_left] at this

/-- **(F0)** (lines 235-238): for `m ≥ 1`, `x_1 ⋯ x_m ∈ T` iff `W_{n,m} = V_m`. -/
theorem F0_mem_iff (n m : ℕ) (hm : 1 ≤ m) :
    firstLettersProd F m ∈ TIdeal F n ↔ multilinIdentities F n m = multilinSpace F m := by
  exact NagataHigman.Proofs.F0_mem_iff_proved F n m hm

/-- **(F0)** (line 235): `d(n) ≤ m` iff `x_1 ⋯ x_m ∈ T` (for `n, m ≥ 1`). -/
theorem F0_index_le_iff (n m : ℕ) (hn : 1 ≤ n) (hm : 1 ≤ m) :
    nhIndex F n ≤ m ↔ firstLettersProd F m ∈ TIdeal F n := by
  exact NagataHigman.Proofs.nhIndex_le_iff_of_mem F (m₀ := n ^ 2) (Nat.one_le_pow _ _ (by omega))
    (NagataHigman.Proofs.razmyslov_mem n hn (youngSystem F (n ^ 2 + 1))) m hm

/-- **(F0), [Ro22, Prop. 1.8]** (lines 67-71, 110-117, 218-219): the two definitions of `d(n)` agree — `x_1 ⋯ x_m ∈ T` iff every
associative, not necessarily unital, `F`-algebra with `x^n = 0` for all `x` satisfies `x_1 ⋯ x_m = 0`. -/
theorem F0_Ro22 (n m : ℕ) (hm : 1 ≤ m) :
    firstLettersProd F m ∈ TIdeal F n ↔
      ∀ (R : Type u) [NonUnitalRing R] [Module F R] [IsScalarTower F R R] [SMulCommClass F R R],
        (∀ x : R, nuPow x n = 0) → ∀ xs : Fin m → R, tupleProd m xs = 0 := by
  exact NagataHigman.Proofs.mem_TIdeal_iff_forall_nil (F := F) (n := n) m hm

/-- **(F1)** (line 245): `L ∈ T` — every `L(y_1, …, y_n)`, `y_i ∈ F⟨X⟩`, lies in `T`. -/
theorem F1_symSum_mem (n : ℕ) (hn : 1 ≤ n) (y : Fin n → FreeNUAlg F) : symSum n y ∈ TIdeal F n := by
  exact NagataHigman.Proofs.F1_symSum_mem_proved F n hn y

omit [CharZero F] in
/-- **(F1)** (line 245): "$L$ is the multilinear component of $(y_1+\dots+y_n)^n$": `(x_0 + … + x_{n-1})^n` is `L`
plus the words in which some letter repeats (the maps `w : Fin n → Fin n` that are not bijective). (The paper's
parenthesis on T-ideals over infinite fields and the Vandermonde argument is NOT proved in Lean; Lean's route to
`L ∈ T` is polarization, see AUDIT route item 2.) -/
theorem F1_L_multilinear_part (n : ℕ) :
    nuPow (∑ i : Fin n, letter F i) n =
      symSum n (fun i => letter F i) +
        ∑ w ∈ Finset.univ.filter (fun w : Fin n → Fin n => ¬ Function.Bijective w),
          tupleProd n (fun k => letter F (w k)) := by
  exact NagataHigman.Proofs.ExV110Rows.L_multilinear_part_proved n

omit [CharZero F] in
/-- **(F1)** (line 245): "$L$ is the multilinear component of $(y_1+\dots+y_n)^n$", in coefficient form for the
letters `y_i = x_{i-1}`: the coefficient of `L` at a word `w` is the coefficient of `(x_0 + ⋯ + x_{n-1})^n` at `w` when
`w` is multilinear in `x_0, …, x_{n-1}` (`IsMultilinWordIn`, Proofs/ExV110R1b.lean), and `0` otherwise. -/
theorem F1_L_multilinear_coeff (n : ℕ) (w : FreeSemigroup ℕ) :
    (symSum n (fun i => letter F i)).coeff w =
      if NagataHigman.Proofs.ExV110R1b.IsMultilinWordIn n w then (nuPow (∑ i : Fin n, letter F i) n).coeff w
      else 0 := by
  classical
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp [symSum, nuPow, NagataHigman.Proofs.tupleProd_zero]
  -- the coefficient of a monomial at `w`
  have hco : ∀ f : Fin n → ℕ, (tupleProd n (fun k => letter F (f k))).coeff w =
      if NagataHigman.Proofs.monoOf (List.ofFn f) = w then 1 else 0 := by
    intro f
    rw [NagataHigman.Proofs.Arcs.tupleProd_letters F hn f, MonoidAlgebra.coeff_single, Finsupp.single_apply]
  split_ifs with hw
  · -- `w` multilinear: the words with a repeated letter do not contribute
    rw [F1_L_multilinear_part F n, MonoidAlgebra.coeff_add, Finsupp.add_apply, MonoidAlgebra.coeff_sum,
      Finsupp.finsetSum_apply]
    rw [Finset.sum_eq_zero, add_zero]
    intro g hg
    rw [hco (fun k => ((g k : Fin n) : ℕ)), ite_eq_right]
    intro hgw
    have hperm : (w.head :: w.tail).Perm (List.range n) := hw
    rw [← NagataHigman.Proofs.ExV110R1b.ofFn_eq_of_monoOf_eq hn _ w hgw] at hperm
    have hinj' := List.nodup_ofFn.mp (hperm.nodup_iff.mpr List.nodup_range)
    have hinj : Function.Injective g := fun a b hab => hinj' (by simp only [hab])
    exact (Finset.mem_filter.mp hg).2 ⟨hinj, Finite.injective_iff_surjective.mp hinj⟩
  · -- `w` not multilinear: every word of `L` is multilinear
    unfold symSum
    rw [MonoidAlgebra.coeff_sum, Finsupp.finsetSum_apply]
    refine Finset.sum_eq_zero fun π _ => ?_
    rw [hco (fun k => ((π k : Fin n) : ℕ)), ite_eq_right]
    intro hπw
    have h1 := NagataHigman.Proofs.Arcs.wordList_perm_range π
    unfold NagataHigman.Proofs.wordList at h1
    rw [NagataHigman.Proofs.ExV110R1b.ofFn_eq_of_monoOf_eq hn _ w hπw] at h1
    exact hw h1

/-- **(F1)** (line 247): `L(x, …, x) = n! x^n`. -/
theorem F1_symSum_diag (n : ℕ) (x : FreeNUAlg F) :
    symSum n (fun _ => x) = (n.factorial : F) • nuPow x n := by
  exact NagataHigman.Proofs.F1_symSum_diag_proved F n x

/-- **(F1)** (lines 244-247): in characteristic 0, `T = (L)^T`, the T-ideal generated by `L(x_0, …, x_{n-1})`. -/
theorem F1_TIdeal_eq (n : ℕ) (hn : 1 ≤ n) :
    TIdeal F n = sInf {S | IsTIdeal F S ∧ symSum n (fun i => letter F i) ∈ S} := by
  exact NagataHigman.Proofs.F1_TIdeal_eq_proved F n hn

/-- **(F1)** (lines 252-254): `V_m ∩ T` is spanned by the elements `a · L(v_1, …, v_n) · b`, `v_i` nonempty words,
`a, b` words or empty, in which every letter `x_1, …, x_m` occurs exactly once. -/
theorem F1_spanning (n m : ℕ) (hn : 1 ≤ n) :
    multilinIdentities F n m =
      Submodule.span F {p | ∃ (a : List ℕ) (v : Fin n → List ℕ) (b : List ℕ),
        IsMultilinTriple m a v b ∧ p = sandwichElem F a v b} := by
  exact NagataHigman.Proofs.F1_spanning_proved (F := F) n m hn

/-- **(F1)** (lines 247-251): `T = (L)^T` is spanned by the `p · L(h_1, …, h_n) · q`, `p`, `q` monomials or `1`, the
`h_i` without constant term (in the non-unital free algebra: any `h_i`). -/
theorem F1_TIdeal_eq_span (n : ℕ) (hn : 1 ≤ n) :
    TIdeal F n = Submodule.span F
      {p | ∃ (a : List ℕ) (h : Fin n → FreeNUAlg F) (b : List ℕ), p = sandwich F a b (symSum n h)} := by
  exact NagataHigman.Proofs.F1_TIdeal_eq_span F n hn

/-- **(F1)** (line 251): "By multilinearity the $h_i$ may be taken to be words". -/
theorem F1_TIdeal_eq_sandwichSpan (n : ℕ) (hn : 1 ≤ n) :
    TIdeal F n = Submodule.span F
      {p | ∃ (a : List ℕ) (v : Fin n → List ℕ) (b : List ℕ), (∀ i, v i ≠ []) ∧ p = sandwichElem F a v b} := by
  exact NagataHigman.Proofs.F1_TIdeal_eq_sandwichSpan F n hn

/-- **(F1)** (lines 254-255): the spanning elements have integer coefficients, so `dim W_{n,m}`, and hence `d(n)`,
is the same for every field of characteristic zero: for any field `K` of characteristic `0`,
`dim_F W_{n,m} = dim_K W_{n,m}` for every `m ≥ 1`, and `d_F(n) = d_K(n)`. Used as in the paper at lines 445-446
("By (F1), $d(n)$ does not depend on $F$") and 607-608 (Theorem B from ℂ to `F`, in `thm_B`). -/
theorem F1_field (n : ℕ) (hn : 1 ≤ n) (K : Type*) [Field K] [CharZero K] :
    (∀ m, 1 ≤ m → Module.finrank F (multilinIdentities F n m) = Module.finrank K (multilinIdentities K n m)) ∧
      nhIndex F n = nhIndex K n := by
  exact NagataHigman.Proofs.FieldIndep.field_indep F K n hn

/-- **(F2)** (lines 259-261), the central idempotents: `youngIdem F λ` (Defs/CentralIdempotent.lean) is built from the
Jucys–Murphy elements alone, with no Young system; for EVERY Young system, `ρ_μ(e_λ) = 1` if `μ = λ` and `0` otherwise. -/
theorem F2_rho_idem (N : ℕ) (Y : YoungSystem F N) (lam mu : Shape N) :
    Y.rhoAlg mu (youngIdem F lam) = if mu = lam then 1 else 0 := by
  exact NagataHigman.Proofs.YoungSystem.rhoAlg_youngIdem Y lam mu

/-- **(F2)** (lines 259-261): the `e_λ` are central idempotents, orthogonal for `λ ≠ μ`, with `Σ_λ e_λ = 1`. -/
theorem F2_idem (N : ℕ) :
    (∀ lam : Shape N, youngIdem F lam * youngIdem F lam = youngIdem F lam) ∧
      (∀ lam mu : Shape N, lam ≠ mu → youngIdem F lam * youngIdem F mu = 0) ∧
      (∀ (lam : Shape N) (a : GrpAlg F N), youngIdem F lam * a = a * youngIdem F lam) ∧
      ∑ lam : Shape N, youngIdem F lam = 1 := by
  exact ⟨fun lam => NagataHigman.Proofs.YoungSystem.youngIdem_mul_self (youngSystem F N) lam,
    fun _ _ h => NagataHigman.Proofs.YoungSystem.youngIdem_mul_of_ne (youngSystem F N) h,
    fun lam a => NagataHigman.Proofs.YoungSystem.youngIdem_comm (youngSystem F N) lam a,
    NagataHigman.Proofs.YoungSystem.sum_youngIdem (youngSystem F N)⟩

/-- **(F2)** (line 260): each `e_λ` is nonzero. -/
theorem F2_idem_ne_zero (N : ℕ) (lam : Shape N) : youngIdem F lam ≠ 0 := by
  exact NagataHigman.Proofs.YoungSystem.youngIdem_ne_zero (youngSystem F N) lam

/-- **(F2)** (lines 260-261): each `e_λ` is a PRIMITIVE central idempotent: for every central idempotent `e` of `F[S_N]`,
`e e_λ` is `0` or `e_λ`. -/
theorem F2_idem_primitive (N : ℕ) (lam : Shape N) (e : GrpAlg F N) (he : e * e = e)
    (hc : ∀ a : GrpAlg F N, e * a = a * e) :
    e * youngIdem F lam = 0 ∨ e * youngIdem F lam = youngIdem F lam := by
  exact NagataHigman.Proofs.YoungSystem.youngIdem_primitive (youngSystem F N) lam e he hc

/-- **(F2)** (line 260): `e_λ = (f^λ/N!) Σ_σ χ_λ(σ) σ` — the system-free `youngIdem F λ` is the paper's `e_λ`
(`f^λ = dim S^λ`, `χ_λ(σ) = tr ρ_λ(σ)`, for every Young system). -/
theorem F2_idem_coeff (N : ℕ) (Y : YoungSystem F N) (lam : Shape N) (σ : Perm (Fin N)) :
    (youngIdem F lam).coeff σ = ((Y.dim lam : F) / (N.factorial : F)) * trace (Y.rho lam σ) := by
  exact NagataHigman.Proofs.YoungSystem.youngIdem_coeff Y lam σ

/-- **(F2)** (line 259): `I_λ = F[S_N] e_λ` — the block of EVERY Young system is the left ideal generated by the
system-free `e_λ`; in particular it does not depend on the Young system. -/
theorem F2_block_eq (N : ℕ) (Y : YoungSystem F N) (lam : Shape N) :
    Y.block lam = LinearMap.range (LinearMap.mulRight F (youngIdem F lam)) := by
  exact NagataHigman.Proofs.YoungSystem.block_eq_range_mulRight Y lam

/-- **(F3)** (lines 268-271): the blocks `I_λ` are mutually orthogonal for `⟨ , ⟩`. -/
theorem F3_orthogonal (N : ℕ) (Y : YoungSystem F N) (lam mu : Shape N) (h : lam ≠ mu) (a b : GrpAlg F N)
    (ha : a ∈ Y.block lam) (hb : b ∈ Y.block mu) :
    coeffPairing F a b = 0 := by
  exact NagataHigman.Proofs.YoungSystem.coeffPairing_eq_zero_of_mem_block _ h ha hb

/-- **(F3)** (lines 267-268): `⟨ , ⟩` is nondegenerate. -/
theorem F3_nondegenerate (N : ℕ) (a : GrpAlg F N) (h : ∀ b : GrpAlg F N, coeffPairing F a b = 0) : a = 0 := by
  exact NagataHigman.Proofs.coeffPairing_nondegenerate a h

/-- **(F4)** (lines 273-278): for `N ≥ n + 1`, the two-sided ideal generated by `E` is `⊕_{ℓ(λ) ≥ n+1} I_λ`. -/
theorem F4_altIdeal (N n : ℕ) (Y : YoungSystem F N) (h : n + 1 ≤ N) :
    altIdeal F N n = Y.blockSum {lam | n + 1 ≤ lam.numRows} := by
  exact NagataHigman.Proofs.YoungSystem.altIdeal_eq_blockSum Y n h

omit [CharZero F] in
/-- **(F6), parenthesis** (lines 284-285): "over $F$ the two sides have the same dimension as after extending
scalars to an algebraic closure": extending scalars to any field `K ⊇ F` does not change the dimension of the span of
the `ρ(g)` (`d × d` matrices). Plain linear algebra; no Burnside theorem. ((F6) itself over an algebraically closed
field is cited background [Et11, Thm 2.5(i)]; Lean neither assumes nor uses it.) -/
theorem F6_dim_extend (G : Type*) [Group G] [Fintype G] (d : ℕ) (ρ : G →* Matrix (Fin d) (Fin d) F)
    (K : Type*) [Field K] [Algebra F K] :
    Module.finrank F (Submodule.span F (Set.range ρ)) =
      Module.finrank K (Submodule.span K (Set.range fun g => (ρ g).map (algebraMap F K))) :=
  NagataHigman.Proofs.ExV110R1b.finrank_span_map_algebraMap (K := K) ρ

/-- **(F7)** (line 287): `ε` is multiplicative. -/
theorem F7_mul (N : ℕ) (a b : GrpAlg F N) : signTwist F (a * b) = signTwist F a * signTwist F b := by
  exact NagataHigman.Proofs.signTwist_mul a b

/-- **(F7)** (line 287): `ε` is an involution (hence an automorphism). -/
theorem F7_involutive (N : ℕ) (a : GrpAlg F N) : signTwist F (signTwist F a) = a := by
  exact NagataHigman.Proofs.signTwist_involutive a

/-- **(F7)** (lines 287-288): `ε(I_λ) = I_{λ'}`. -/
theorem F7_block (N : ℕ) (Y : YoungSystem F N) (lam : Shape N) (a : GrpAlg F N) :
    a ∈ Y.block lam ↔ signTwist F a ∈ Y.block lam.conjugate := by
  exact NagataHigman.Proofs.YoungSystem.mem_block_iff_signTwist _ lam a

/-- **(F7)** (lines 288-289): on `C_N`, `ε` is the scalar `(-1)^{N-1}`. -/
theorem F7_cycleSpan (N : ℕ) (c : GrpAlg F N) (hc : c ∈ cycleSpan F N) :
    signTwist F c = ((-1 : F) ^ (N - 1)) • c := by
  exact NagataHigman.Proofs.signTwist_of_mem_cycleSpan hc

/-! ## Section 2.3: Formanek's criterion in cycle form -/

/-- **Proposition 2.1** (lines 306-310): `dim W_{n,m} = m! - dim(C_N ∩ B_n^{(N)})`, `N = m + 1` (stated additively;
it covers `m ≥ n` and, trivially, `1 ≤ m < n`). -/
theorem prop_2_1 (n m : ℕ) (hn : 1 ≤ n) (hm : 1 ≤ m) (Y : YoungSystem F (m + 1)) :
    Module.finrank F (multilinIdentities F n m) +
      Module.finrank F (cycleSpan F (m + 1) ⊓ Y.boxSum n : Submodule F (GrpAlg F (m + 1))) =
      m.factorial := by
  exact NagataHigman.Proofs.prop_2_1_general n m hn hm Y

/-- **Proposition 2.1** (line 311): `x_1 ⋯ x_m ∈ T` (i.e. `d(n) ≤ m`) iff `C_N ∩ B_n = 0`. -/
theorem prop_2_1_iff (n m : ℕ) (hn : 1 ≤ n) (hm : 1 ≤ m) (Y : YoungSystem F (m + 1)) :
    firstLettersProd F m ∈ TIdeal F n ↔ cycleSpan F (m + 1) ⊓ Y.boxSum n = ⊥ := by
  exact NagataHigman.Proofs.prop_2_1_iff_general n m hn hm Y

/-- **Proposition 2.1**, the form "`d(n) ≤ m` iff `C_N ∩ B_n = 0`" (line 311). -/
theorem prop_2_1_index (n m : ℕ) (hn : 1 ≤ n) (hm : 1 ≤ m) (Y : YoungSystem F (m + 1)) :
    nhIndex F n ≤ m ↔ cycleSpan F (m + 1) ⊓ Y.boxSum n = ⊥ := by
  exact (F0_index_le_iff F n m hn hm).trans (prop_2_1_iff F n m hn hm Y)

/-! ## Section 2.3: the named steps of the proof of Proposition 2.1

`Φ` and `P` are defined in NagataHigman/Defs/WordCycle.lean: `wordCycle w` is `Φ` on words (step (1), line 277);
`cycleProj F N` is `P` (line 249); the linear map `Φ : V_m → C_N` is `cycleLin F m ∘ (wordLin F m)⁻¹`, so for `S ⊆ V_m`
the image `Φ(S)` is `(S.comap (wordLin F m)).map (cycleLin F m)`. -/

/-- **Proposition 2.1, step (1)** (lines 319-320): `Φ` is a bijection from the multilinear words of degree `m` onto the
`N`-cycles, `N = m + 1`. -/
theorem prop_2_1_step1_words (m : ℕ) (hm : 1 ≤ m) :
    Function.Injective (wordCycle (m := m)) ∧
      ∀ σ : Perm (Fin (m + 1)), IsFullCycle σ ↔ ∃ w : Perm (Fin m), wordCycle w = σ := by
  exact NagataHigman.Proofs.prop21_step1_words m hm

/-- **Proposition 2.1, step (1)** (line 320): `Φ : V_m → C_N`, `x_w ↦ Φ(w)`, is a linear isomorphism. -/
theorem prop_2_1_step1_iso (m : ℕ) (hm : 1 ≤ m) :
    ∃ Φ : multilinSpace F m ≃ₗ[F] cycleSpan F (m + 1), ∀ w : Perm (Fin m),
      (Φ ⟨multilinWord F w, Submodule.subset_span ⟨w, rfl⟩⟩ : GrpAlg F (m + 1)) = perm F (wordCycle w) := by
  exact NagataHigman.Proofs.prop21_step1_iso m hm

/-- **Proposition 2.1, step (1)** (lines 226, 319-320), in coordinates: the multilinear words are a basis of `V_m`, the
`N`-cycles a basis of `C_N` (this is what makes `Φ = cycleLin ∘ wordLin⁻¹` well defined). -/
theorem prop_2_1_step1_bases (m : ℕ) (hm : 1 ≤ m) :
    Function.Injective (wordLin F m) ∧ LinearMap.range (wordLin F m) = multilinSpace F m ∧
      Function.Injective (cycleLin F m) ∧ LinearMap.range (cycleLin F m) = cycleSpan F (m + 1) := by
  exact NagataHigman.Proofs.prop21_step1_linear m hm

