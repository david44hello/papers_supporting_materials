variable (F : Type u) [Field F] [CharZero F]

/-! ## Section 2.1: the standard facts (F0)-(F7) -/

/-- **(F0)** (lines 212-215): for `m ≥ 1`, `x_1 ⋯ x_m ∈ T` iff `W_{n,m} = V_m`. -/
theorem F0_mem_iff (n m : ℕ) (hm : 1 ≤ m) :
    firstLettersProd F m ∈ TIdeal F n ↔ multilinIdentities F n m = multilinSpace F m := by
  exact NagataHigman.Proofs.F0_mem_iff_proved F n m hm

/-- **(F0)** (line 212): `d(n) ≤ m` iff `x_1 ⋯ x_m ∈ T` (for `n, m ≥ 1`). -/
theorem F0_index_le_iff (n m : ℕ) (hn : 1 ≤ n) (hm : 1 ≤ m) :
    nhIndex F n ≤ m ↔ firstLettersProd F m ∈ TIdeal F n := by
  exact NagataHigman.Proofs.nhIndex_le_iff_of_mem F (m₀ := n ^ 2) (Nat.one_le_pow _ _ (by omega))
    (NagataHigman.Proofs.razmyslov_mem n hn (youngSystem F (n ^ 2 + 1))) m hm

/-- **(F0), [Ro22, Prop. 1.8]** (lines 66-70, 108-110, 199-200): the two definitions of `d(n)` agree — `x_1 ⋯ x_m ∈ T` iff every
associative, not necessarily unital, `F`-algebra with `x^n = 0` for all `x` satisfies `x_1 ⋯ x_m = 0`. -/
theorem F0_Ro22 (n m : ℕ) (hm : 1 ≤ m) :
    firstLettersProd F m ∈ TIdeal F n ↔
      ∀ (R : Type u) [NonUnitalRing R] [Module F R] [IsScalarTower F R R] [SMulCommClass F R R],
        (∀ x : R, nuPow x n = 0) → ∀ xs : Fin m → R, tupleProd m xs = 0 := by
  exact NagataHigman.Proofs.mem_TIdeal_iff_forall_nil (F := F) (n := n) m hm

/-- **(F1)** (line 219): `L ∈ T` — every `L(y_1, …, y_n)`, `y_i ∈ F⟨X⟩`, lies in `T`. -/
theorem F1_symSum_mem (n : ℕ) (hn : 1 ≤ n) (y : Fin n → FreeNUAlg F) : symSum n y ∈ TIdeal F n := by
  exact NagataHigman.Proofs.F1_symSum_mem_proved F n hn y

/-- **(F1)** (line 220): `L(x, …, x) = n! x^n`. -/
theorem F1_symSum_diag (n : ℕ) (x : FreeNUAlg F) :
    symSum n (fun _ => x) = (n.factorial : F) • nuPow x n := by
  exact NagataHigman.Proofs.F1_symSum_diag_proved F n x

/-- **(F1)** (lines 218-220): in characteristic 0, `T = (L)^T`, the T-ideal generated by `L(x_0, …, x_{n-1})`. -/
theorem F1_TIdeal_eq (n : ℕ) (hn : 1 ≤ n) :
    TIdeal F n = sInf {S | IsTIdeal F S ∧ symSum n (fun i => letter F i) ∈ S} := by
  exact NagataHigman.Proofs.F1_TIdeal_eq_proved F n hn

/-- **(F1)** (lines 225-229): `V_m ∩ T` is spanned by the elements `a · L(v_1, …, v_n) · b`, `v_i` nonempty words,
`a, b` words or empty, in which every letter `x_1, …, x_m` occurs exactly once. -/
theorem F1_spanning (n m : ℕ) (hn : 1 ≤ n) :
    multilinIdentities F n m =
      Submodule.span F {p | ∃ (a : List ℕ) (v : Fin n → List ℕ) (b : List ℕ),
        IsMultilinTriple m a v b ∧ p = sandwichElem F a v b} := by
  exact NagataHigman.Proofs.F1_spanning_proved (F := F) n m hn

/-- **(F1)** (lines 220-224): `T = (L)^T` is spanned by the `p · L(h_1, …, h_n) · q`, `p`, `q` monomials or `1`, the
`h_i` without constant term (in the non-unital free algebra: any `h_i`). -/
theorem F1_TIdeal_eq_span (n : ℕ) (hn : 1 ≤ n) :
    TIdeal F n = Submodule.span F
      {p | ∃ (a : List ℕ) (h : Fin n → FreeNUAlg F) (b : List ℕ), p = sandwich F a b (symSum n h)} := by
  exact NagataHigman.Proofs.F1_TIdeal_eq_span F n hn

/-- **(F1)** (line 224): "By multilinearity the $h_i$ may be taken to be words". -/
theorem F1_TIdeal_eq_sandwichSpan (n : ℕ) (hn : 1 ≤ n) :
    TIdeal F n = Submodule.span F
      {p | ∃ (a : List ℕ) (v : Fin n → List ℕ) (b : List ℕ), (∀ i, v i ≠ []) ∧ p = sandwichElem F a v b} := by
  exact NagataHigman.Proofs.F1_TIdeal_eq_sandwichSpan F n hn

/-- **(F1)** (lines 229-230): the spanning elements have integer coefficients, so `dim W_{n,m}`, and hence `d(n)`,
is the same for every field of characteristic zero: for any field `K` of characteristic `0`,
`dim_F W_{n,m} = dim_K W_{n,m}` for every `m ≥ 1`, and `d_F(n) = d_K(n)`. -/
theorem F1_field (n : ℕ) (hn : 1 ≤ n) (K : Type*) [Field K] [CharZero K] :
    (∀ m, 1 ≤ m → Module.finrank F (multilinIdentities F n m) = Module.finrank K (multilinIdentities K n m)) ∧
      nhIndex F n = nhIndex K n := by
  exact NagataHigman.Proofs.FieldIndep.field_indep F K n hn

/-- **(F2)** (lines 234-236), the central idempotents: `youngIdem F λ` (Defs/CentralIdempotent.lean) is built from the
Jucys–Murphy elements alone, with no Young system; for EVERY Young system, `ρ_μ(e_λ) = 1` if `μ = λ` and `0` otherwise. -/
theorem F2_rho_idem (N : ℕ) (Y : YoungSystem F N) (lam mu : Shape N) :
    Y.rhoAlg mu (youngIdem F lam) = if mu = lam then 1 else 0 := by
  exact NagataHigman.Proofs.YoungSystem.rhoAlg_youngIdem Y lam mu

/-- **(F2)** (lines 234-236): the `e_λ` are central idempotents, orthogonal for `λ ≠ μ`, with `Σ_λ e_λ = 1`. -/
theorem F2_idem (N : ℕ) :
    (∀ lam : Shape N, youngIdem F lam * youngIdem F lam = youngIdem F lam) ∧
      (∀ lam mu : Shape N, lam ≠ mu → youngIdem F lam * youngIdem F mu = 0) ∧
      (∀ (lam : Shape N) (a : GrpAlg F N), youngIdem F lam * a = a * youngIdem F lam) ∧
      ∑ lam : Shape N, youngIdem F lam = 1 := by
  exact ⟨fun lam => NagataHigman.Proofs.YoungSystem.youngIdem_mul_self (youngSystem F N) lam,
    fun _ _ h => NagataHigman.Proofs.YoungSystem.youngIdem_mul_of_ne (youngSystem F N) h,
    fun lam a => NagataHigman.Proofs.YoungSystem.youngIdem_comm (youngSystem F N) lam a,
    NagataHigman.Proofs.YoungSystem.sum_youngIdem (youngSystem F N)⟩

/-- **(F2)** (line 235): each `e_λ` is nonzero. -/
theorem F2_idem_ne_zero (N : ℕ) (lam : Shape N) : youngIdem F lam ≠ 0 := by
  exact NagataHigman.Proofs.YoungSystem.youngIdem_ne_zero (youngSystem F N) lam

/-- **(F2)** (lines 235-236): each `e_λ` is a PRIMITIVE central idempotent: for every central idempotent `e` of `F[S_N]`,
`e e_λ` is `0` or `e_λ`. -/
theorem F2_idem_primitive (N : ℕ) (lam : Shape N) (e : GrpAlg F N) (he : e * e = e)
    (hc : ∀ a : GrpAlg F N, e * a = a * e) :
    e * youngIdem F lam = 0 ∨ e * youngIdem F lam = youngIdem F lam := by
  exact NagataHigman.Proofs.YoungSystem.youngIdem_primitive (youngSystem F N) lam e he hc

/-- **(F2)** (line 235): `e_λ = (f^λ/N!) Σ_σ χ_λ(σ) σ` — the system-free `youngIdem F λ` is the paper's `e_λ`
(`f^λ = dim S^λ`, `χ_λ(σ) = tr ρ_λ(σ)`, for every Young system). -/
theorem F2_idem_coeff (N : ℕ) (Y : YoungSystem F N) (lam : Shape N) (σ : Perm (Fin N)) :
    (youngIdem F lam).coeff σ = ((Y.dim lam : F) / (N.factorial : F)) * trace (Y.rho lam σ) := by
  exact NagataHigman.Proofs.YoungSystem.youngIdem_coeff Y lam σ

/-- **(F2)** (line 234): `I_λ = F[S_N] e_λ` — the block of EVERY Young system is the left ideal generated by the
system-free `e_λ`; in particular it does not depend on the Young system. -/
theorem F2_block_eq (N : ℕ) (Y : YoungSystem F N) (lam : Shape N) :
    Y.block lam = LinearMap.range (LinearMap.mulRight F (youngIdem F lam)) := by
  exact NagataHigman.Proofs.YoungSystem.block_eq_range_mulRight Y lam

/-- **(F3)** (lines 243-246): the blocks `I_λ` are mutually orthogonal for `⟨ , ⟩`. -/
theorem F3_orthogonal (N : ℕ) (Y : YoungSystem F N) (lam mu : Shape N) (h : lam ≠ mu) (a b : GrpAlg F N)
    (ha : a ∈ Y.block lam) (hb : b ∈ Y.block mu) :
    coeffPairing F a b = 0 := by
  exact NagataHigman.Proofs.YoungSystem.coeffPairing_eq_zero_of_mem_block _ h ha hb

/-- **(F3)** (lines 242-243): `⟨ , ⟩` is nondegenerate. -/
theorem F3_nondegenerate (N : ℕ) (a : GrpAlg F N) (h : ∀ b : GrpAlg F N, coeffPairing F a b = 0) : a = 0 := by
  exact NagataHigman.Proofs.coeffPairing_nondegenerate a h

/-- **(F4)** (lines 248-253): for `N ≥ n + 1`, the two-sided ideal generated by `E` is `⊕_{ℓ(λ) ≥ n+1} I_λ`. -/
theorem F4_altIdeal (N n : ℕ) (Y : YoungSystem F N) (h : n + 1 ≤ N) :
    altIdeal F N n = Y.blockSum {lam | n + 1 ≤ lam.numRows} := by
  exact NagataHigman.Proofs.YoungSystem.altIdeal_eq_blockSum Y n h

/-- **(F7)** (line 261): `ε` is multiplicative. -/
theorem F7_mul (N : ℕ) (a b : GrpAlg F N) : signTwist F (a * b) = signTwist F a * signTwist F b := by
  exact NagataHigman.Proofs.signTwist_mul a b

/-- **(F7)** (line 261): `ε` is an involution (hence an automorphism). -/
theorem F7_involutive (N : ℕ) (a : GrpAlg F N) : signTwist F (signTwist F a) = a := by
  exact NagataHigman.Proofs.signTwist_involutive a

/-- **(F7)** (lines 261-262): `ε(I_λ) = I_{λ'}`. -/
theorem F7_block (N : ℕ) (Y : YoungSystem F N) (lam : Shape N) (a : GrpAlg F N) :
    a ∈ Y.block lam ↔ signTwist F a ∈ Y.block lam.conjugate := by
  exact NagataHigman.Proofs.YoungSystem.mem_block_iff_signTwist _ lam a

/-- **(F7)** (lines 262-263): on `C_N`, `ε` is the scalar `(-1)^{N-1}`. -/
theorem F7_cycleSpan (N : ℕ) (c : GrpAlg F N) (hc : c ∈ cycleSpan F N) :
    signTwist F c = ((-1 : F) ^ (N - 1)) • c := by
  exact NagataHigman.Proofs.signTwist_of_mem_cycleSpan hc

/-! ## Section 2.3: Formanek's criterion in cycle form -/

/-- **Proposition 2.1** (lines 280-284): `dim W_{n,m} = m! - dim(C_N ∩ B_n^{(N)})`, `N = m + 1` (stated additively;
it covers `m ≥ n` and, trivially, `1 ≤ m < n`). -/
theorem prop_2_1 (n m : ℕ) (hn : 1 ≤ n) (hm : 1 ≤ m) (Y : YoungSystem F (m + 1)) :
    Module.finrank F (multilinIdentities F n m) +
      Module.finrank F (cycleSpan F (m + 1) ⊓ Y.boxSum n : Submodule F (GrpAlg F (m + 1))) =
      m.factorial := by
  exact NagataHigman.Proofs.prop_2_1_general n m hn hm Y

/-- **Proposition 2.1** (line 285): `x_1 ⋯ x_m ∈ T` (i.e. `d(n) ≤ m`) iff `C_N ∩ B_n = 0`. -/
theorem prop_2_1_iff (n m : ℕ) (hn : 1 ≤ n) (hm : 1 ≤ m) (Y : YoungSystem F (m + 1)) :
    firstLettersProd F m ∈ TIdeal F n ↔ cycleSpan F (m + 1) ⊓ Y.boxSum n = ⊥ := by
  exact NagataHigman.Proofs.prop_2_1_iff_general n m hn hm Y

/-- **Proposition 2.1**, the form "`d(n) ≤ m` iff `C_N ∩ B_n = 0`" (line 285). -/
theorem prop_2_1_index (n m : ℕ) (hn : 1 ≤ n) (hm : 1 ≤ m) (Y : YoungSystem F (m + 1)) :
    nhIndex F n ≤ m ↔ cycleSpan F (m + 1) ⊓ Y.boxSum n = ⊥ := by
  exact (F0_index_le_iff F n m hn hm).trans (prop_2_1_iff F n m hn hm Y)

/-! ## Section 2.3: the named steps of the proof of Proposition 2.1

`Φ` and `P` are defined in NagataHigman/Defs/WordCycle.lean: `wordCycle w` is `Φ` on words (step (1), line 252);
`cycleProj F N` is `P` (line 222); the linear map `Φ : V_m → C_N` is `cycleLin F m ∘ (wordLin F m)⁻¹`, so for `S ⊆ V_m`
the image `Φ(S)` is `(S.comap (wordLin F m)).map (cycleLin F m)`. -/

/-- **Proposition 2.1, step (1)** (lines 297-298): `Φ` is a bijection from the multilinear words of degree `m` onto the
`N`-cycles, `N = m + 1`. -/
theorem prop_2_1_step1_words (m : ℕ) (hm : 1 ≤ m) :
    Function.Injective (wordCycle (m := m)) ∧
      ∀ σ : Perm (Fin (m + 1)), IsFullCycle σ ↔ ∃ w : Perm (Fin m), wordCycle w = σ := by
  exact NagataHigman.Proofs.prop21_step1_words m hm

/-- **Proposition 2.1, step (1)** (line 298): `Φ : V_m → C_N`, `x_w ↦ Φ(w)`, is a linear isomorphism. -/
theorem prop_2_1_step1_iso (m : ℕ) (hm : 1 ≤ m) :
    ∃ Φ : multilinSpace F m ≃ₗ[F] cycleSpan F (m + 1), ∀ w : Perm (Fin m),
      (Φ ⟨multilinWord F w, Submodule.subset_span ⟨w, rfl⟩⟩ : GrpAlg F (m + 1)) = perm F (wordCycle w) := by
  exact NagataHigman.Proofs.prop21_step1_iso m hm

/-- **Proposition 2.1, step (1)** (lines 203, 294-295), in coordinates: the multilinear words are a basis of `V_m`, the
`N`-cycles a basis of `C_N` (this is what makes `Φ = cycleLin ∘ wordLin⁻¹` well defined). -/
theorem prop_2_1_step1_bases (m : ℕ) (hm : 1 ≤ m) :
    Function.Injective (wordLin F m) ∧ LinearMap.range (wordLin F m) = multilinSpace F m ∧
      Function.Injective (cycleLin F m) ∧ LinearMap.range (cycleLin F m) = cycleSpan F (m + 1) := by
  exact NagataHigman.Proofs.prop21_step1_linear m hm

omit [CharZero F] in
/-- **Proposition 2.1, step (1), example** (lines 298-300): for `m = 3`, `Φ(x_2 x_3 x_1)` is the `4`-cycle
`4 → 2 → 3 → 1 → 4` (Lean, 0-indexed: the word `x_1 x_2 x_0` is `finRotate 3`, the cycle is `3 → 1 → 2 → 0 → 3`). -/
theorem prop_2_1_step1_example :
    multilinWord F (finRotate 3) = letter F 1 * letter F 2 * letter F 0 ∧
      wordCycle (finRotate 3) 3 = 1 ∧ wordCycle (finRotate 3) 1 = 2 ∧ wordCycle (finRotate 3) 2 = 0 ∧
      wordCycle (finRotate 3) 0 = 3 := by
  exact NagataHigman.Proofs.Examples.ex_step1 F

/-- **Proposition 2.1, step (2)** (lines 302-305): `I = span {τ E_X : τ ∈ S_N, X ⊆ [N], |X| = n + 1}`. -/
theorem prop_2_1_step2 (N n : ℕ) (h : n + 1 ≤ N) :
    altIdeal F N n = Submodule.span F
      {x | ∃ (τ : Perm (Fin N)) (X : Finset (Fin N)), X.card = n + 1 ∧ x = perm F τ * altSum F X} := by
  exact NagataHigman.Proofs.altIdeal_eq_span F h

/-- **Proposition 2.1, step (3)** (line 307): if no `τπ` (`π ∈ Sym(X)`) is an `N`-cycle, then `P(τ E_X) = 0`. -/
theorem prop_2_1_step3 (N : ℕ) (τ : Perm (Fin N)) (X : Finset (Fin N))
    (h : ∀ π : Perm (Fin N), π.support ⊆ X → ¬ IsFullCycle (τ * π)) :
    cycleProj F N (perm F τ * altSum F X) = 0 := by
  exact NagataHigman.Proofs.prop21_step3_zero τ X h

/-- **Proposition 2.1, step (3)** (lines 307-309): otherwise `τ E_X = sgn(π₀) τ₀ E_X` with `τ₀ = τπ₀` an `N`-cycle,
`π₀ ∈ Sym(X)`. -/
theorem prop_2_1_step3_reduce (N : ℕ) (τ : Perm (Fin N)) (X : Finset (Fin N))
    (h : ∃ π : Perm (Fin N), π.support ⊆ X ∧ IsFullCycle (τ * π)) :
    ∃ π₀ : Perm (Fin N), π₀.support ⊆ X ∧ IsFullCycle (τ * π₀) ∧
      perm F τ * altSum F X = ((Perm.sign π₀ : ℤ) : F) • (perm F (τ * π₀) * altSum F X) := by
  exact NagataHigman.Proofs.prop21_step3_reduce τ X h

/-- **Proposition 2.1, step (4)** (lines 311-313): for an `N`-cycle `τ` and nonempty `X`, the first-return map `s`
is a cycle on `X` (an `(n+1)`-cycle when `|X| = n + 1`); it fixes every point outside `X`. -/
theorem prop_2_1_step4_s (N : ℕ) (τ : Perm (Fin N)) (hτ : IsFullCycle τ) (X : Finset (Fin N)) (hX : X.Nonempty) :
    (firstReturn τ X).IsCycleOn (X : Set (Fin N)) ∧ ∀ x, x ∉ X → firstReturn τ X x = x := by
  exact NagataHigman.Proofs.prop21_step4_s hτ hX

/-- **Proposition 2.1, step (4)** (lines 313-314): the arcs `Arc(x)`, `x ∈ X`, are nonempty, have no repeated point,
end at `s(x)`, and partition `[N]`: every point lies in exactly one arc. -/
theorem prop_2_1_step4_arcs (N : ℕ) (τ : Perm (Fin N)) (hτ : IsFullCycle τ) (X : Finset (Fin N))
    (hX : X.Nonempty) :
    (∀ x ∈ X, arc τ X x ≠ [] ∧ (arc τ X x).Nodup ∧ (arc τ X x).getLast? = some (firstReturn τ X x)) ∧
      ∀ y, ∃! x, x ∈ X ∧ y ∈ arc τ X x := by
  exact NagataHigman.Proofs.prop21_step4_arcs hτ hX

/-- **Proposition 2.1, step (4)** (lines 314-315): for `π ∈ Sym(X)`, from `x ∈ X` the permutation `τπ` runs through
`Arc(π(x))` and lands on `s(π(x))`: the first-return map of `τπ` to `X` is `s ∘ π`. -/
theorem prop_2_1_step4_return (N : ℕ) (τ π : Perm (Fin N)) (X : Finset (Fin N)) (hπ : π.support ⊆ X) :
    (∀ x ∈ X, arc (τ * π) X x = arc τ X (π x)) ∧ firstReturn (τ * π) X = firstReturn τ X * π := by
  exact NagataHigman.Proofs.prop21_step4_return τ π X hπ

/-- **Proposition 2.1, step (4)** (lines 315-318): for an `N`-cycle `τ`, nonempty `X` and `π ∈ Sym(X)`, `τπ` is an
`N`-cycle iff `s ∘ π` is a cycle on `X` (an `(n+1)`-cycle). -/
theorem prop_2_1_step4_iff (N : ℕ) (τ : Perm (Fin N)) (hτ : IsFullCycle τ) (X : Finset (Fin N)) (hX : X.Nonempty)
    (π : Perm (Fin N)) (hπ : π.support ⊆ X) :
    IsFullCycle (τ * π) ↔ (firstReturn τ X * π).IsCycleOn (X : Set (Fin N)) := by
  exact NagataHigman.Proofs.prop21_step4_iff hτ hX hπ

/-- **Proposition 2.1, step (5)** (lines 320-322): for `π ∈ Π` (`π ∈ Sym(X)` with `s ∘ π` a cycle on `X`),
`sgn(π) = sgn(s) sgn(s ∘ π) = +1` (the paper's route). -/
theorem prop_2_1_step5_sign (N : ℕ) (τ : Perm (Fin N)) (hτ : IsFullCycle τ) (X : Finset (Fin N))
    (hX : X.Nonempty) (π : Perm (Fin N)) (hπ : π.support ⊆ X)
    (hPi : (firstReturn τ X * π).IsCycleOn (X : Set (Fin N))) :
    Perm.sign π = 1 := by
  exact NagataHigman.Proofs.prop21_step5_sign hτ hX hπ hPi

open Classical in
/-- **Proposition 2.1, step (5)** (lines 322-323): for an `N`-cycle `τ`, `P(τ E_X) = ∑_{π ∈ Π} τπ`, with no sign. -/
theorem prop_2_1_step5 (N : ℕ) (τ : Perm (Fin N)) (hτ : IsFullCycle τ) (X : Finset (Fin N)) :
    cycleProj F N (perm F τ * altSum F X) =
      ∑ π ∈ univ.filter (fun π : Perm (Fin N) => π.support ⊆ X ∧ IsFullCycle (τ * π)), perm F (τ * π) := by
  exact NagataHigman.Proofs.prop21_step5_sum hτ X

/-- **Proposition 2.1, step (6)** (line 325): `π ↦ ρ := s ∘ π` is a bijection from `Π` onto the set of
`(n+1)`-cycles on `X` (cycles on `X` fixing the points outside `X`). -/
theorem prop_2_1_step6_bij (N : ℕ) (τ : Perm (Fin N)) (hτ : IsFullCycle τ) (X : Finset (Fin N))
    (hX : X.Nonempty) :
    Set.BijOn (fun π => firstReturn τ X * π)
      {π | π.support ⊆ X ∧ (firstReturn τ X * π).IsCycleOn (X : Set (Fin N))}
      {ρ | ρ.support ⊆ X ∧ ρ.IsCycleOn (X : Set (Fin N))} := by
  exact NagataHigman.Proofs.prop21_step6_bij τ hτ X hX

/-- **Proposition 2.1, step (6)** (lines 325-339): for an `N`-cycle `τ` and `|X| = n + 1`,
`Φ⁻¹(∑_{π ∈ Π} τπ) = x_ξ · L(x_{Arc_1}, …, x_{Arc_n}) · x_ζ`, an (F1) element with nonempty `Arc_i` avoiding `N`
(a multilinear triple), with sign `+1`. Stated existentially in `a`, `v`, `b`; the form with the paper's names
`a = ξ`, `v_i = Arc_i`, `b = ζ` is `prop_2_1_step6_formula_arcs` below. -/
theorem prop_2_1_step6_formula (n m : ℕ) (hn : 1 ≤ n) (hnm : n ≤ m) (τ : Perm (Fin (m + 1)))
    (hτ : IsFullCycle τ) (X : Finset (Fin (m + 1))) (hX : X.card = n + 1) :
    ∃ (a : List ℕ) (v : Fin n → List ℕ) (b : List ℕ) (c : Perm (Fin m) → F), IsMultilinTriple m a v b ∧
      wordLin F m c = sandwichElem F a v b ∧ cycleLin F m c = cycleProj F (m + 1) (perm F τ * altSum F X) := by
  exact NagataHigman.Proofs.prop21_step6_formula n m hn hnm τ hτ X hX

/-- **Proposition 2.1, step (6), the displayed formula with the paper's names** (lines 329-339): write the arc
containing `N` as `Arc_0 = (ζ, N, ξ)` (`arc τ X w₀ = ζ ++ [N] ++ ξ`) and number the other `n` arcs `Arc_1, …, Arc_n` in
any way (`e`, injective, avoiding `w₀`). Then `(ξ, Arc_1, …, Arc_n, ζ)` is a multilinear triple (so the `Arc_i`, `i ≥ 1`,
are nonempty and avoid `N`) and `Φ⁻¹(P(τ E_X)) = x_ξ · L(x_{Arc_1}, …, x_{Arc_n}) · x_ζ`. The hypotheses only name
things: `prop_2_1_step6_names_exist` shows they can always be met. -/
theorem prop_2_1_step6_formula_arcs (n m : ℕ) (hn : 1 ≤ n) (hnm : n ≤ m) (τ : Perm (Fin (m + 1)))
    (hτ : IsFullCycle τ) (X : Finset (Fin (m + 1))) (hX : X.card = n + 1)
    (w₀ : Fin (m + 1)) (hw₀ : w₀ ∈ X) (ζ ξ : List (Fin (m + 1)))
    (hsplit : arc τ X w₀ = ζ ++ [Fin.last m] ++ ξ)
    (e : Fin n → Fin (m + 1)) (he : Function.Injective e) (heX : ∀ i, e i ∈ X ∧ e i ≠ w₀) :
    IsMultilinTriple m (ξ.map Fin.val) (fun i => (arc τ X (e i)).map Fin.val) (ζ.map Fin.val) ∧
      ∃ c : Perm (Fin m) → F,
        cycleLin F m c = cycleProj F (m + 1) (perm F τ * altSum F X) ∧
        wordLin F m c = sandwichElem F (ξ.map Fin.val) (fun i => (arc τ X (e i)).map Fin.val) (ζ.map Fin.val) := by
  exact NagataHigman.Proofs.Step6Arcs.step6_formula_arcs n m hn hnm τ hτ X hX w₀ hw₀ ζ ξ hsplit e he heX

/-- **Proposition 2.1, step (6)** (lines 329-330): the names of `prop_2_1_step6_formula_arcs` exist — `N` lies on
the arc of some `w₀ ∈ X`, `Arc(w₀) = (ζ, N, ξ)` (and the other `n` arcs can be numbered by any bijection onto
`X \ {w₀}`). -/
theorem prop_2_1_step6_names_exist (N : ℕ) (τ : Perm (Fin (N + 1))) (hτ : IsFullCycle τ) (X : Finset (Fin (N + 1)))
    (hX : X.Nonempty) :
    ∃ w₀ ∈ X, ∃ ζ ξ : List (Fin (N + 1)), arc τ X w₀ = ζ ++ [Fin.last N] ++ ξ := by
  exact NagataHigman.Proofs.Step6Arcs.step6_names_exist τ hτ X hX

/-- **Proposition 2.1, step (6)** (line 332): "each arc is determined by its last point, which lies in `K`": for
`x ∈ X` the last point of `Arc(x)` is `s(x) ∈ X`, and two points of `X` with the same last point of their arcs are
equal. -/
theorem prop_2_1_step6_arc_last (N : ℕ) (τ : Perm (Fin N)) (X : Finset (Fin N)) :
    (∀ x ∈ X, ∃ z ∈ X, (arc τ X x).getLast? = some z) ∧
      ∀ x ∈ X, ∀ y ∈ X, (arc τ X x).getLast? = (arc τ X y).getLast? → x = y := by
  refine ⟨fun x hx => ⟨firstReturn τ X x, NagataHigman.Proofs.Steps345.firstReturn_mem hx,
    NagataHigman.Proofs.Steps345.arc_getLast? hx⟩, fun x hx y hy h => ?_⟩
  rw [NagataHigman.Proofs.Steps345.arc_getLast? hx, NagataHigman.Proofs.Steps345.arc_getLast? hy,
    Option.some_inj] at h
  exact (firstReturn τ X).injective h

